<% submitted_address = @reservation.submitted_address.presence || @reservation.address %>
<% suggested_address = @reservation.formatted_address.presence || [ @reservation.suggested_street, @reservation.suggested_city, @reservation.suggested_state, @reservation.suggested_zip ].compact_blank.join(", ") %>

<% content_for :title, "Check Your Address | #{default_page_name}" %>
<% content_for :description, "Confirm the address for your tree pickup." %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/flow_steps", current: 1 %>

    <%= render "shared/page_header",
               eyebrow: "One quick check",
               title: "Is this your address?",
               description: "We found a slightly different address for your pickup. Choose the one we should use." %>

    <div class="site-prose text-ink-soft dark:text-ink-soft-dark">
      <p>
        A small difference in the street number, street name, or city can send a
        volunteer to the wrong block. Please confirm the address where we should
        look for your tree.
      </p>
    </div>

    <div class="site-choice-grid site-choice-grid--two site-choice-grid--cards">
      <% if @reservation.suggested_address_complete? %>
        <section class="site-choice site-choice--card rounded-2xl border border-sage bg-sage-soft/40 dark:border-sage-dark dark:bg-sage-soft-dark/40" aria-labelledby="suggested-address">
          <h2 id="suggested-address" class="text-ink dark:text-ink-dark">Suggested address</h2>
          <p class="text-ink-soft dark:text-ink-soft-dark"><%= suggested_address %></p>
          <%= button_to "Use suggested address",
                        reservation_address_verification_path(@reservation.public_token),
                        method: :patch,
                        params: { choice: "suggested" },
                        class: "site-button site-button--full bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
        </section>
      <% end %>

      <section class="site-choice site-choice--card rounded-2xl border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" aria-labelledby="entered-address">
        <h2 id="entered-address" class="text-ink dark:text-ink-dark">Your address</h2>
        <p class="text-ink-soft dark:text-ink-soft-dark"><%= submitted_address %></p>
        <%= button_to "Keep my address",
                      reservation_address_verification_path(@reservation.public_token),
                      method: :patch,
                      params: { choice: "entered" },
                      class: "site-button site-button--secondary site-button--full border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
      </section>
    </div>

    <p class="site-hint text-ink-soft dark:text-ink-soft-dark">
      Need to make a change?
      <%= link_to "Edit your reservation", edit_reservation_path(@reservation.public_token), class: "site-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>.
    </p>
  </div>
</section>
