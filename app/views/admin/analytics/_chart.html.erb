<% bar_class = case tone
                when "warning" then "fill-warning dark:fill-warning-dark"
                when "info" then "fill-info dark:fill-info-dark"
                else "fill-sage dark:fill-sage-dark"
                end %>
<% dot_class = case tone
                when "warning" then "bg-warning dark:bg-warning-dark"
                when "info" then "bg-info dark:bg-info-dark"
                else "bg-sage dark:bg-sage-dark"
                end %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" aria-labelledby="<%= heading_id %>">
  <div class="admin-panel-header">
    <div>
      <h2 id="<%= heading_id %>" class="admin-panel-title text-ink dark:text-ink-dark">
        <span class="mr-2 inline-block size-2.5 rounded-full align-middle <%= dot_class %>" aria-hidden="true"></span>
        <%= title %>
      </h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark"><%= description %></p>
    </div>
    <div class="text-right">
      <p class="mb-1 text-[0.72rem] font-medium uppercase tracking-[0.14em] text-muted dark:text-muted-dark">Total</p>
      <p class="font-display text-3xl leading-none tracking-tight text-ink dark:text-ink-dark"><%= total %></p>
    </div>
  </div>

  <div class="admin-panel-body">
    <% if local_assigns[:stats].present? %>
      <dl class="mb-6 grid gap-3 sm:grid-cols-2">
        <% stats.each do |stat| %>
          <div class="rounded-lg border border-line bg-stone p-3 dark:border-line-dark dark:bg-stone-dark">
            <dt class="text-xs font-medium uppercase tracking-wide text-muted dark:text-muted-dark"><%= stat[:label] %></dt>
            <dd class="mt-1 font-display text-2xl tracking-tight text-ink dark:text-ink-dark"><%= stat[:value] %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <% if points.empty? %>
      <p class="m-0 text-ink-soft dark:text-ink-soft-dark"><%= empty_message %></p>
    <% else %>
      <% axis_chars = chart.y_ticks.map { |tick| tick.label.length }.max || 1 %>
      <div class="relative" data-controller="analytics-chart" data-action="pointerleave->analytics-chart#hide">
        <div data-analytics-chart-target="tooltip" hidden class="pointer-events-none absolute z-10 flex flex-col items-center rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs leading-tight shadow-xs dark:border-line-dark dark:bg-surface-dark"></div>
        <div data-analytics-chart-target="guide" hidden class="pointer-events-none absolute w-px bg-line dark:bg-line-dark" style="top: <%= (chart.plot_top.to_f / chart.height) * 100 %>%; bottom: <%= ((chart.height - chart.plot_bottom).to_f / chart.height) * 100 %>%" aria-hidden="true"></div>

        <div class="flex items-stretch">
          <div class="relative h-40 shrink-0 text-xs" style="width: <%= axis_chars + 1.25 %>ch" aria-hidden="true">
            <% chart.y_ticks.each do |tick| %>
              <span class="analytics-axis-label pointer-events-none absolute right-0 -translate-y-1/2 pr-1.5 text-xs leading-none tabular-nums text-muted dark:text-muted-dark" style="top: <%= (tick.y / chart.height.to_f) * 100 %>%"><%= tick.label %></span>
            <% end %>
          </div>

          <div class="relative min-w-0 flex-1">
            <svg viewBox="0 0 <%= chart.width %> <%= chart.height %>" preserveAspectRatio="none" class="analytics-chart block h-40 w-full" aria-hidden="true">
              <% chart.y_ticks.each do |tick| %>
                <line x1="<%= chart.plot_left %>" y1="<%= tick.y %>" x2="<%= chart.plot_right %>" y2="<%= tick.y %>" class="stroke-line dark:stroke-line-dark" stroke-width="1" vector-effect="non-scaling-stroke"></line>
              <% end %>

              <% chart.bars.each do |bar| %>
                <% path = chart.path_for(bar) %>
                <% if path %>
                  <path d="<%= path %>" class="<%= bar_class %>"></path>
                <% end %>
              <% end %>

              <% chart.columns.each do |column| %>
                <rect x="<%= column.x %>" y="<%= chart.plot_top %>" width="<%= column.width %>" height="<%= chart.plot_bottom - chart.plot_top %>" fill="transparent"
                      data-action="pointerenter->analytics-chart#show"
                      data-analytics-chart-label-param="<%= column.label %>"
                      data-analytics-chart-value-param="<%= column.value_label %>"></rect>
              <% end %>
            </svg>

            <% chart.x_labels.each do |label| %>
              <span class="analytics-axis-label pointer-events-none absolute -translate-x-1/2 whitespace-nowrap text-xs leading-none text-muted dark:text-muted-dark" style="left: <%= (label.x / chart.width.to_f) * 100 %>%; bottom: 0.2rem" aria-hidden="true"><%= label.text %></span>
            <% end %>
          </div>
        </div>

        <table class="sr-only">
          <caption><%= title %>, <%= description %></caption>
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col"><%= value_heading %></th>
            </tr>
          </thead>
          <tbody>
            <% points.each do |point| %>
              <tr>
                <td><%= point.label %></td>
                <td><%= point.value_label %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
