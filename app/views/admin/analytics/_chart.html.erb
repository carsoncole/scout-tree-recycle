<% bar_class = tone == "warning" ? "fill-warning dark:fill-warning-dark" : "fill-sage dark:fill-sage-dark" %>
<% dot_class = tone == "warning" ? "bg-warning dark:bg-warning-dark" : "bg-sage dark:bg-sage-dark" %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" aria-labelledby="<%= heading_id %>">
  <div class="admin-panel-header">
    <div>
      <h2 id="<%= heading_id %>" class="admin-panel-title text-ink dark:text-ink-dark">
        <span class="mr-2 inline-block size-2.5 rounded-full align-middle <%= dot_class %>" aria-hidden="true"></span>
        <%= title %>
      </h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark"><%= description %></p>
    </div>
    <div class="text-right">
      <p class="mb-1 text-[0.72rem] font-medium uppercase tracking-[0.14em] text-muted dark:text-muted-dark">Total</p>
      <p class="font-display text-3xl leading-none tracking-tight text-ink dark:text-ink-dark"><%= total %></p>
    </div>
  </div>

  <div class="admin-panel-body">
    <% if points.empty? %>
      <p class="m-0 text-ink-soft dark:text-ink-soft-dark"><%= empty_message %></p>
    <% else %>
      <div class="relative" data-controller="analytics-chart" data-action="pointerleave->analytics-chart#hide">
        <div data-analytics-chart-target="tooltip" hidden class="pointer-events-none absolute z-10 flex flex-col items-center rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs leading-tight shadow-sm dark:border-line-dark dark:bg-surface-dark"></div>
        <div data-analytics-chart-target="guide" hidden class="pointer-events-none absolute bottom-7 top-8 w-px bg-line dark:bg-line-dark" aria-hidden="true"></div>

        <div>
          <svg viewBox="0 0 <%= chart.width %> <%= chart.height %>" class="analytics-chart h-auto w-full" aria-hidden="true">
            <% chart.y_ticks.each do |tick| %>
              <line x1="<%= chart.plot_left %>" y1="<%= tick.y %>" x2="<%= chart.plot_right %>" y2="<%= tick.y %>" class="stroke-line dark:stroke-line-dark" stroke-width="1"></line>
              <text x="<%= chart.plot_left - 8 %>" y="<%= tick.y + 4 %>" text-anchor="end" class="fill-muted text-[13px] dark:fill-muted-dark"><%= tick.label %></text>
            <% end %>

            <% chart.bars.each do |bar| %>
              <% path = chart.path_for(bar) %>
              <% if path %>
                <path d="<%= path %>" class="<%= bar_class %>"></path>
              <% end %>
            <% end %>

            <% chart.x_labels.each do |label| %>
              <text x="<%= label.x %>" y="<%= chart.height - 10 %>" text-anchor="middle" class="fill-muted text-[13px] dark:fill-muted-dark"><%= label.text %></text>
            <% end %>

            <% chart.columns.each do |column| %>
              <rect x="<%= column.x %>" y="16" width="<%= column.width %>" height="<%= chart.plot_bottom - 16 %>" fill="transparent"
                    data-action="pointerenter->analytics-chart#show"
                    data-analytics-chart-label-param="<%= column.label %>"
                    data-analytics-chart-value-param="<%= column.value_label %>"></rect>
            <% end %>
          </svg>
        </div>

        <table class="sr-only">
          <caption><%= title %>, <%= description %></caption>
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col"><%= value_heading %></th>
            </tr>
          </thead>
          <tbody>
            <% points.each do |point| %>
              <tr>
                <td><%= point.label %></td>
                <td><%= point.value_label %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
