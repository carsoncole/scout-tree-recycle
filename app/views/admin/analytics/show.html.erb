<% content_for :title, "Analytics" %>

<%= render "admin/shared/page_header",
           title: "Analytics",
           description: "How many reservations came in, and how much was donated, over the life of the event." do %>
  <div class="admin-filter-group border border-line-strong bg-surface dark:border-line-strong-dark dark:bg-surface-dark" role="group" aria-label="Group analytics by">
    <%= link_to "Day", admin_analytics_path(period: "day"),
                class: admin_filter_class(@analytics.day?),
                aria: { current: (@analytics.day? ? "true" : nil) } %>
    <%= link_to "Week", admin_analytics_path(period: "week"),
                class: admin_filter_class(@analytics.week?),
                aria: { current: (@analytics.week? ? "true" : nil) } %>
  </div>
<% end %>

<div class="grid gap-5 xl:grid-cols-2">
  <%= render "chart",
             heading_id: "reservations-analytics",
             title: "Reservations",
             description: "Count by #{@analytics.grouping_label}",
             total: number_with_delimiter(@analytics.reservation_total),
             empty_message: "No reservations yet.",
             value_heading: "Reservations",
             tone: "sage",
             points: @analytics.reservation_series,
             chart: @reservation_chart %>

  <%= render "chart",
             heading_id: "donations-analytics",
             title: "Donations",
             description: "Paid amounts by #{@analytics.grouping_label}",
             total: number_to_currency(@analytics.donation_total),
             empty_message: "No paid donations yet.",
             value_heading: "Amount",
             tone: "warning",
             points: @analytics.donation_series,
             chart: @donation_chart %>
</div>
