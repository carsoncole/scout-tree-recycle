<% selected = local_assigns.fetch(:selected, Backup.dataset_keys) %>
<% scope = local_assigns.fetch(:scope, "default") %>
<fieldset class="admin-field">
  <legend class="admin-label text-ink dark:text-ink-dark">Include in the backup</legend>
  <div class="mt-2 flex flex-col gap-2">
    <% Backup::DATASETS.each_value do |dataset| %>
      <label class="admin-check-row text-ink dark:text-ink-dark" for="datasets_<%= dataset.key %>_<%= scope %>">
        <%= check_box_tag "datasets[]", dataset.key, selected.include?(dataset.key),
            id: "datasets_#{dataset.key}_#{scope}", class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
        <span>
          <span class="block font-medium"><%= dataset.label %></span>
          <span class="admin-hint text-ink-soft dark:text-ink-soft-dark"><%= dataset.description %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
