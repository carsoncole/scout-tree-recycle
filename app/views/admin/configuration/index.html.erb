<%= content_for :title, "Configuration" %>
<%= render "admin/shared/page_header",
           title: "Configuration",
           description: "Every setting behind the site: required fields, optional features, and whether each value still uses its default." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <% @overview.groups.each do |group| %>
      <% missing = group.entries.count { |entry| entry.status == :missing } %>
      <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="configuration-<%= group.key %>">
        <div class="admin-panel-header border-line dark:border-line-dark">
          <div>
            <h2 class="admin-panel-title text-ink dark:text-ink-dark"><%= link_to group.label, admin_settings_section_path(group.key), class: admin_link_class %></h2>
            <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark"><%= group.description %></p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <% if group.toggle && (toggle_entry = group.entries.find { |entry| entry.attribute == group.toggle }) %>
              <span class="<%= admin_badge_class(toggle_entry.value ? "positive" : "neutral") %>"><%= toggle_entry.value ? "Enabled" : "Disabled" %></span>
            <% end %>
            <% if missing.positive? %>
              <span class="<%= admin_badge_class("danger") %>"><%= pluralize(missing, "missing setting") %></span>
            <% end %>
          </div>
        </div>

        <div class="admin-panel-body">
          <div class="admin-table-wrap">
            <table class="admin-table text-ink dark:text-ink-dark">
              <thead>
                <tr>
                  <th class="<%= admin_th_class %>">Setting</th>
                  <th class="<%= admin_th_class %>">Current value</th>
                  <th class="<%= admin_th_class %>">Status</th>
                </tr>
              </thead>
              <tbody>
                <% group.entries.each do |entry| %>
                  <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark <%= "bg-danger-row dark:bg-danger-row-dark" if entry.status == :missing %>">
                    <td class="<%= admin_td_class %>">
                      <span class="font-medium"><%= entry.label %></span>
                      <% if entry.note.present? %>
                        <p class="mt-0.5 text-xs text-muted dark:text-muted-dark"><%= entry.note %></p>
                      <% end %>
                    </td>
                    <td class="<%= admin_td_class %>"><%= admin_configuration_value(entry) %></td>
                    <td class="<%= admin_td_class %>"><%= admin_configuration_status_badge(entry.status) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
