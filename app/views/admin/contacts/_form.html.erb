<%= form_with(model: [ :admin, contact ], class: "admin-stack") do |f| %>
  <%= render "shared/form_errors", object: contact %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Contact information</h2>
        <p class="admin-panel-description">Name and email are required. Contacts must use a unique email address.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.label :name, class: "admin-label" %>
          <%= f.text_field :name, class: "admin-input", autocomplete: "name" %>
        </div>

        <div class="admin-field">
          <%= f.label :email, class: "admin-label" %>
          <%= f.email_field :email, class: "admin-input", autocomplete: "email" %>
        </div>

        <div class="admin-field">
          <%= f.label :mobile, class: "admin-label" %>
          <%= f.telephone_field :mobile, class: "admin-input", autocomplete: "tel" %>
        </div>

        <div class="admin-field">
          <%= f.label :street, class: "admin-label" %>
          <%= f.text_field :street, class: "admin-input", autocomplete: "street-address" %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_marketing_index_path, class: "admin-button admin-button--secondary" %>
      <%= f.submit(contact.persisted? ? "Update Contact" : "Create Contact", class: "admin-button") %>
    </div>
  </section>
<% end %>
