<%= content_for :title, "Data" %>
<%= render "admin/shared/page_header",
           title: "Data",
           description: "Download or restore backups of reservations, contacts and settings, manage data, and review database settings." %>

<div class="flex flex-col gap-6">
  <% if Current.user&.admin? %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="backups">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Backups</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Download or email a zip backup of reservations, contacts and settings, or restore from a previous backup.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="<%= admin_notice_class(:warning) %>" role="status">
          <p><strong class="admin-notice-title">Sensitive file.</strong> Backups include credentials such as SMTP, Twilio, Stripe, AWS, Resend, and driver portal passwords. Store them securely outside this application.</p>
        </div>

        <% selected_datasets = @setting&.backup_dataset_keys.presence || Backup.dataset_keys %>
        <% if @setting %>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Download</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Save a zip named after your event header.</p>

              <%= form_with url: admin_backups_path, method: :post, class: "mt-3 flex flex-1 flex-col gap-3", data: { turbo: false } do %>
                <%= render "admin/backups/dataset_fields", selected: selected_datasets, scope: "download" %>
                <div class="mt-auto pt-1">
                  <%= submit_tag "Download Backup (.zip)", class: admin_button_class(full: true) %>
                </div>
              <% end %>
            </section>

            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Email now</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Send the selected backup immediately.</p>

              <%= form_with model: @setting, url: email_admin_backups_path, method: :post, class: "mt-3 flex flex-1 flex-col gap-3", data: { turbo: false } do |f| %>
                <%= render "admin/backups/dataset_fields", selected: selected_datasets, scope: "email" %>

                <div class="admin-field">
                  <%= f.label :backup_email, "Send this backup to", for: "backup_email_now", class: "admin-label text-ink dark:text-ink-dark" %>
                  <%= f.email_field :backup_email, id: "backup_email_now", class: admin_input_class, placeholder: "recipient@example.com" %>
                </div>

                <div class="mt-auto pt-1">
                  <%= f.submit "Email Backup Now", class: admin_button_class(full: true) %>
                </div>
              <% end %>
            </section>

            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark sm:col-span-2 xl:col-span-1">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Daily schedule</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Email the selected backup automatically once a day.</p>

              <%= form_with model: @setting, url: schedule_admin_backups_path, method: :post, class: "mt-3 flex flex-1 flex-col gap-3" do |f| %>
                <%= render "admin/backups/dataset_fields", selected: selected_datasets, scope: "schedule" %>

                <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-1">
                  <div class="admin-field">
                    <%= f.label :backup_email, "Daily backup email address", for: "backup_email_schedule", class: "admin-label text-ink dark:text-ink-dark" %>
                    <%= f.email_field :backup_email, id: "backup_email_schedule", class: admin_input_class, placeholder: "recipient@example.com" %>
                  </div>
                  <div class="admin-field">
                    <%= f.label :backup_time, "Daily send time", class: "admin-label text-ink dark:text-ink-dark" %>
                    <%= f.select :backup_time, Setting.backup_time_options, {}, class: admin_select_class %>
                  </div>
                </div>

                <label class="admin-check-row text-ink dark:text-ink-dark" for="setting_is_backup_schedule_enabled">
                  <%= f.check_box :is_backup_schedule_enabled, class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                  <span>Email the backup daily</span>
                </label>

                <div class="mt-auto pt-1">
                  <%= f.submit "Save Daily Schedule", class: admin_button_class(full: true) %>
                </div>
              <% end %>
            </section>
          </div>
        <% else %>
          <div class="<%= admin_notice_class(:warning) %> mt-5" role="status">
            <p><strong class="admin-notice-title">Settings required.</strong> Complete the initial settings before backing up settings. You can still download reservations and contacts.</p>
          </div>

          <section class="mt-4 flex flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
            <%= form_with url: admin_backups_path, method: :post, class: "flex flex-col gap-3", data: { turbo: false } do %>
              <label class="admin-check-row text-ink dark:text-ink-dark" for="datasets_reservations">
                <%= check_box_tag "datasets[]", "reservations", true,
                    id: "datasets_reservations", class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                <span>Reservations</span>
              </label>
              <div>
                <%= submit_tag "Download Backup (.zip)", class: admin_button_class(full: true) %>
              </div>
            <% end %>
          </section>
        <% end %>

        <div class="admin-form-section border-line dark:border-line-dark">
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Restore from a backup</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Restore settings, reservations and contacts independently. CSV restores run in the background and record results in the <%= link_to "System Logs", admin_logs_path, class: admin_link_class %>.</p>

          <div class="<%= admin_notice_class(:warning) %> mt-4" role="status">
            <p>
              <strong class="admin-notice-title">Event finished?</strong>
              If this event is over, do not restore reservations. Restore contacts instead
              so supporters are kept for next year. <%= link_to "Close Event", admin_close_event_path, class: admin_link_class %>
              does this automatically from the current reservations.
            </p>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-3">
            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
              <h4 class="admin-toggle-title text-ink dark:text-ink-dark">Restore settings</h4>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Overwrites current settings, including credentials.</p>

              <%= form_with url: restore_settings_admin_backups_path, method: :post, multipart: true, class: "mt-3 flex flex-1 flex-col gap-2" do %>
                <%= label_tag :backup_settings_file, "Settings JSON file", class: "admin-label text-ink dark:text-ink-dark" %>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <%= file_field_tag :file, id: "backup_settings_file", accept: ".json,application/json",
                      class: "#{admin_input_class} min-w-0 flex-1" %>
                  <%= submit_tag "Restore Settings", class: "#{admin_button_class} shrink-0" %>
                </div>
                <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Choose <span class="font-mono">settings.json</span> from a backup zip. Maximum 1 MB.</p>
              <% end %>
            </section>

            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
              <h4 class="admin-toggle-title text-ink dark:text-ink-dark">Restore reservations</h4>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Updates reservations that match by email and adds missing ones. Never deletes reservations.</p>

              <%= form_with url: restore_reservations_admin_backups_path, method: :post, multipart: true, class: "mt-3 flex flex-1 flex-col gap-2" do %>
                <%= label_tag :backup_reservations_file, "Reservations CSV file", class: "admin-label text-ink dark:text-ink-dark" %>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <%= file_field_tag :file, id: "backup_reservations_file", accept: ".csv,text/csv",
                      class: "#{admin_input_class} min-w-0 flex-1" %>
                  <%= submit_tag "Restore Reservations", class: "#{admin_button_class} shrink-0" %>
                </div>
                <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Choose <span class="font-mono">reservations.csv</span> from a backup zip. Maximum 10 MB. Runs in the background; results are recorded in the System Logs.</p>
              <% end %>
            </section>

            <section class="flex h-full flex-col rounded-lg border border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark" id="restore-contacts">
              <h4 class="admin-toggle-title text-ink dark:text-ink-dark">Restore contacts</h4>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Updates contacts that match by email and adds missing ones. Never deletes contacts.</p>

              <%= form_with url: restore_contacts_admin_backups_path, method: :post, multipart: true, class: "mt-3 flex flex-1 flex-col gap-2" do %>
                <%= label_tag :backup_contacts_file, "Contacts CSV file", class: "admin-label text-ink dark:text-ink-dark" %>
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <%= file_field_tag :file, id: "backup_contacts_file", accept: ".csv,text/csv",
                      class: "#{admin_input_class} min-w-0 flex-1" %>
                  <%= submit_tag "Restore Contacts", class: "#{admin_button_class} shrink-0" %>
                </div>
                <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Choose <span class="font-mono">contacts.csv</span> from a backup zip. Maximum 10 MB. Runs in the background; results are recorded in the System Logs.</p>
              <% end %>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="data-management">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Data Management</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Delete all reservations, contacts, or zones, routes, and drivers, run a factory reset, or load the example dataset for development and demos.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all reservations</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@reservations_count.to_i, "reservation") %></strong>.
                Donations are kept but detached from their reservations. Type DELETE to confirm.
              </p>
            </div>
            <%= render "admin/shared/destructive_details",
                summary_label: "Delete All Reservations",
                url: admin_data_reset_path,
                method: :post,
                word: "DELETE",
                fields: { "data_reset[scope]" => "reservations" },
                submit_label: "Confirm Delete All Reservations",
                confirm: "Delete all reservations? This permanently deletes every reservation and cannot be undone." %>
          </div>
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all contacts</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@contacts_count.to_i, "contact") %></strong>.
                Contacts from prior events and imports are removed. Type DELETE to confirm.
              </p>
            </div>
            <%= render "admin/shared/destructive_details",
                summary_label: "Delete All Contacts",
                url: admin_data_reset_path,
                method: :post,
                word: "DELETE",
                fields: { "data_reset[scope]" => "contacts" },
                submit_label: "Confirm Delete All Contacts",
                confirm: "Delete all contacts? This permanently deletes every contact and cannot be undone." %>
          </div>
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all zones, routes, and drivers</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@zones_count.to_i, "zone") %></strong>,
                <strong class="text-ink dark:text-ink-dark"><%= pluralize(@routes_count.to_i, "route") %></strong>,
                and <strong class="text-ink dark:text-ink-dark"><%= pluralize(@drivers_count.to_i, "driver") %></strong>,
                including route points and driver assignments.
                Reservations are kept but removed from their routes. Type DELETE to confirm.
              </p>
            </div>
            <%= render "admin/shared/destructive_details",
                summary_label: "Delete All Zones, Routes, and Drivers",
                url: admin_data_reset_path,
                method: :post,
                word: "DELETE",
                fields: { "data_reset[scope]" => "routes" },
                submit_label: "Confirm Delete All Zones, Routes, and Drivers",
                confirm: "Delete all zones, routes, and drivers? This permanently deletes every zone, route, and driver and cannot be undone." %>
          </div>
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Load sample data</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                Queues a background job that creates example Bainbridge Island reservations, contacts, and route info.
                Route info is routes, zones, and drivers, including route points.
                It loads only when reservations, contacts, routes, zones, and drivers are all empty.
                If any of those tables already has a record, sample data is not loaded.
                Intended for local development and demos. A completed run is recorded in the System Logs.
              </p>
            </div>
            <%= button_to "Load Sample Data", admin_data_reset_path,
                params: { "data_reset[scope]" => "sample_data" },
                class: admin_button_class(variant: :secondary),
                form: { class: "ml-auto shrink-0" },
                data: { turbo_confirm: "Load sample data? This runs only when reservations, contacts, routes, zones, and drivers are all empty." } %>
          </div>
        </div>
      </div>
      <div class="admin-danger-zone border-danger-border bg-danger-bg dark:border-danger-border-dark dark:bg-danger-bg-dark" id="reset-all-data">
        <div class="admin-toggle-row">
          <div class="admin-toggle-copy">
            <span class="<%= admin_badge_class("danger") %>">Danger zone</span>
            <h3 class="admin-toggle-title mt-2 text-ink dark:text-ink-dark">Factory reset</h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
              This permanently deletes <strong class="text-ink dark:text-ink-dark">every record in every table</strong>,
              including reservations, contacts, donations, routes, users, settings, and the current sign-in sessions.
              You will be signed out and returned to first-run setup, with the default email templates reloaded.
              Sample data is not loaded — run it separately once setup is complete.
            </p>
          </div>
          <%= render "admin/shared/destructive_details",
              summary_label: "Factory Reset",
              url: admin_data_reset_path,
              method: :post,
              word: "RESET ALL",
              fields: { "data_reset[scope]" => "all" },
              submit_label: "Confirm Factory Reset",
              confirm: "Factory reset? This permanently deletes ALL data, including users and settings. You will be signed out and returned to first-run setup." %>
        </div>
        <div class="<%= admin_notice_class("danger") %> mt-4" role="alert">
          <div>
            <p><strong>Warning:</strong> This is the most destructive action in the application. There is no undo and no automatic backup. Download a backup first from the <%= link_to "Backups section", admin_data_path(anchor: "backups"), class: admin_link_class %>.</p>
          </div>
        </div>
      </div>
    </section>
  <% else %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Data access</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Read-only access for your role.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">You can view this page, but backing up or restoring data and data management actions are available to admins only.</p>
      </div>
    </section>
  <% end %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="close-event">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Close Event</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Copy this event's reservations into contacts, delete every reservation, and reset marketing so the next event can begin.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-toolbar">
        <div>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Close this event</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">How long contacts are kept is set on the close event page.</p>
        </div>
        <% if Current.user&.admin? %>
          <%= link_to "Close Event", admin_close_event_path, class: "#{admin_button_class(variant: :danger)} ml-auto shrink-0" %>
        <% else %>
          <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
        <% end %>
      </div>
      <% unless Current.user&.admin? %>
        <p class="admin-hint mt-2 text-ink-soft dark:text-ink-soft-dark">Only admins can close the event or change how long contacts are kept.</p>
        <%= link_to "View close event", admin_close_event_path, class: "#{admin_link_class} mt-2 inline-block" %>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Database settings</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Read-only view of the databases configured for this environment in config/database.yml. Sensitive values are never shown.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="<%= admin_badge_class("info") %>"><%= Rails.env %> environment</span>
      </div>
    </div>
    <div class="admin-panel-body">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr>
              <th class="<%= admin_th_class %>">Database</th>
              <th class="<%= admin_th_class %>">Setting</th>
              <th class="<%= admin_th_class %>">Current value</th>
            </tr>
          </thead>
          <tbody>
            <% @database_overview.databases.each do |database| %>
              <% database.entries.each_with_index do |entry, index| %>
                <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                  <% if index.zero? %>
                    <td class="<%= admin_td_class %>" rowspan="<%= database.entries.size %>">
                      <span class="font-medium"><%= database.name %></span>
                    </td>
                  <% end %>
                  <td class="<%= admin_td_class %>"><span class="font-medium"><%= entry.label %></span></td>
                  <td class="<%= admin_td_class %>"><%= admin_configuration_value(entry) %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
