<%= content_for :title, "Data" %>
<%= render "admin/shared/page_header",
           title: "Data",
           description: "Import contacts, export reservation data as CSV, back up settings, manage data, and review database settings." %>

<div class="flex flex-col gap-6">
  <% if Current.user&.admin? %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Import contacts</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Upload a CSV file, map its columns to contact fields, and queue a background import.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="<%= admin_notice_class(:warning, spaced: true) %>" role="status">
          <div>
            <p class="admin-notice-title">Background import</p>
            <p>
              Imports run in the background after you submit. The completed summary and any rows that cannot be imported are recorded in the
              <%= link_to "System Logs", admin_logs_path, class: admin_link_class %>
              with row numbers and validation messages.
            </p>
          </div>
        </div>

        <noscript>
          <div class="<%= admin_notice_class(:danger, spaced: true) %>" role="status">
            <div>
              <p class="admin-notice-title">JavaScript required</p>
              <p>Column mapping requires JavaScript. Enable it in your browser to import CSV files.</p>
            </div>
          </div>
        </noscript>

        <%= form_with url: import_admin_data_path, method: :post, multipart: true,
                      class: "admin-form",
                      data: {
                        controller: "csv-mapping",
                        csv_mapping_fields_value: Contact::IMPORTABLE_FIELDS.map do |value, label|
                          { value: value, label: label, aliases: Contact::IMPORTABLE_FIELD_ALIASES.fetch(value, []) }
                        end.to_json
                      } do |f| %>
          <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
            <div class="admin-field">
              <%= label_tag :file, "CSV file", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= file_field_tag :file, accept: ".csv,text/csv", class: admin_input_class,
                    data: { csv_mapping_target: "file", action: "change->csv-mapping#load" } %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Upload a CSV with a header row. These fields are required: name, email, mobile, street. Maximum 5 MB.</p>

              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark" data-csv-mapping-target="matchStatus">Matching fields found: none yet.</p>
            </div>

            <p class="admin-error-text text-danger dark:text-danger-dark" data-csv-mapping-target="error" hidden></p>
          </div>

          <div class="admin-form-section border-line dark:border-line-dark">
            <div class="admin-field-grid admin-field-grid--two gap-5" data-csv-mapping-target="mapping"></div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-3">
            <%= submit_tag "Import Contacts CSV", class: admin_button_class %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Export reservations</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Download all reservations as a CSV file, or email the export on a daily schedule.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <p class="admin-hint admin-hint--spaced text-ink-soft dark:text-ink-soft-dark">Exports every reservation with its mapped fields and route name.</p>

        <% if @setting %>
          <%= form_with model: @setting, url: schedule_admin_data_path, method: :patch, class: "admin-form" do |f| %>
            <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
              <div class="admin-field-grid admin-field-grid--two gap-5">
                <div class="admin-field">
                  <%= f.label :reservations_export_email, "Email address", class: "admin-label text-ink dark:text-ink-dark" %>
                  <%= f.email_field :reservations_export_email, class: admin_input_class, placeholder: "recipient@example.com" %>
                  <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The address that receives the reservations CSV export.</p>
                </div>
                <div class="admin-field">
                  <%= f.label :reservations_export_time, "Daily send time", class: "admin-label text-ink dark:text-ink-dark" %>
                  <%= f.select :reservations_export_time, Setting.reservations_export_time_options, {}, class: admin_select_class %>
                  <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Sent every day at this time in the configured time zone.</p>
                </div>
              </div>

              <label class="admin-check-row text-ink dark:text-ink-dark" for="setting_is_reservations_export_schedule_enabled">
                <%= f.check_box :is_reservations_export_schedule_enabled, class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                <span>Email the export daily</span>
              </label>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-3">
              <%= link_to "Export Reservations CSV", export_admin_data_path(format: :csv),
                          class: admin_button_class(variant: "secondary"),
                          data: { turbo: false } %>
              <%= f.submit "Email Export Now", formaction: email_export_admin_data_path, formmethod: :post,
                          class: admin_button_class %>
              <%= f.submit "Save Daily Schedule", class: admin_button_class(variant: "secondary") %>
            </div>
          <% end %>
        <% else %>
          <div class="flex flex-wrap items-center justify-end gap-3">
            <%= link_to "Export Reservations CSV", export_admin_data_path(format: :csv),
                        class: admin_button_class,
                        data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Settings backup</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Export all settings to a JSON file, or restore settings from a previous export on a fresh install.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="<%= admin_notice_class(:warning, spaced: true) %>" role="status">
          <div>
            <p class="admin-notice-title">Sensitive file</p>
            <p>Settings exports include sensitive credentials such as SMTP, Twilio, Stripe, AWS, and driver portal passwords. Store the file securely. Importing overwrites current setting values.</p>
          </div>
        </div>

        <%= form_with url: import_settings_admin_data_path, method: :post, multipart: true, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
            <div class="admin-field">
              <%= label_tag :settings_file, "Settings JSON file", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= file_field_tag :file, id: "settings_file", accept: ".json,application/json", class: admin_input_class %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Upload a JSON file previously exported from this page. Maximum 1 MB.</p>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-3">
            <%= link_to "Export Settings JSON", export_settings_admin_data_path,
                        class: admin_button_class(variant: "secondary"),
                        data: { turbo: false } %>
            <%= submit_tag "Import Settings JSON", class: admin_button_class %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="data-management">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Data Management</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Delete all reservations or contacts, wipe the database back to defaults, or load the example dataset for development and demos.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all reservations</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@reservations_count.to_i, "reservation") %></strong>.
                Donations are kept but detached from their reservations. Type DELETE to confirm.
              </p>
            </div>
            <%= render "admin/shared/destructive_details",
                summary_label: "Delete All Reservations",
                url: admin_data_reset_path,
                method: :post,
                word: "DELETE",
                fields: { "data_reset[scope]" => "reservations" },
                submit_label: "Confirm Delete All Reservations",
                confirm: "Delete all reservations? This permanently deletes every reservation and cannot be undone." %>
          </div>
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all contacts</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@contacts_count.to_i, "contact") %></strong>.
                Contacts from prior events and imports are removed. Type DELETE to confirm.
              </p>
            </div>
            <%= render "admin/shared/destructive_details",
                summary_label: "Delete All Contacts",
                url: admin_data_reset_path,
                method: :post,
                word: "DELETE",
                fields: { "data_reset[scope]" => "contacts" },
                submit_label: "Confirm Delete All Contacts",
                confirm: "Delete all contacts? This permanently deletes every contact and cannot be undone." %>
          </div>
          <div class="admin-toggle-row border-line dark:border-line-dark">
            <div class="admin-toggle-copy">
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Load sample data</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
                Queues a background job that creates the example Bainbridge Island zones, routes, route points, drivers, reservations, and contacts.
                Intended for local development and demos — it adds records to the current database, and the completed run is recorded in the System Logs.
              </p>
            </div>
            <%= button_to "Load Sample Data", admin_data_reset_path,
                params: { "data_reset[scope]" => "sample_data" },
                class: admin_button_class(variant: :secondary),
                form: { class: "ml-auto shrink-0" },
                data: { turbo_confirm: "Load sample data? This adds example zones, routes, drivers, reservations, and contacts to the database." } %>
          </div>
        </div>
      </div>
      <div class="admin-danger-zone border-danger-border bg-danger-bg dark:border-danger-border-dark dark:bg-danger-bg-dark" id="reset-all-data">
        <div class="admin-toggle-row">
          <div class="admin-toggle-copy">
            <span class="<%= admin_badge_class("danger") %>">Danger zone</span>
            <h3 class="admin-toggle-title mt-2 text-ink dark:text-ink-dark">Reset all data to default</h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
              This permanently deletes <strong class="text-ink dark:text-ink-dark">every record in every table</strong>,
              including reservations, contacts, donations, routes, users, settings, and the current sign-in sessions.
              You will be signed out and returned to first-run setup, with the default email templates reloaded.
              Sample data is not loaded — run it separately once setup is complete.
            </p>
          </div>
          <%= render "admin/shared/destructive_details",
              summary_label: "Reset All Data to Default",
              url: admin_data_reset_path,
              method: :post,
              word: "RESET ALL",
              fields: { "data_reset[scope]" => "all" },
              submit_label: "Confirm Reset All Data",
              confirm: "Are you sure? This permanently deletes ALL data, including users and settings. You will be signed out and returned to first-run setup." %>
        </div>
        <div class="<%= admin_notice_class("danger") %> mt-4" role="alert">
          <div>
            <p><strong>Warning:</strong> This is the most destructive action in the application. There is no undo and no backup. Export anything you need first from the <%= link_to "Data page", admin_data_path, class: admin_link_class %>.</p>
          </div>
        </div>
      </div>
    </section>
  <% else %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Data access</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Read-only access for your role.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">You can view this page, but importing contacts, exporting reservations, scheduling exports, emailing exports, settings backup, and data management actions are available to admins only.</p>
      </div>
    </section>
  <% end %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="close-event">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Close Event</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Copy this event's reservations into contacts, delete every reservation, and reset marketing so the next event can begin.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-toolbar">
        <div>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Close this event</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">How long contacts are kept is set on the close event page.</p>
        </div>
        <% if Current.user&.admin? %>
          <%= link_to "Close Event", admin_close_event_path, class: "#{admin_button_class(variant: :danger)} ml-auto shrink-0" %>
        <% else %>
          <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
        <% end %>
      </div>
      <% unless Current.user&.admin? %>
        <p class="admin-hint mt-2 text-ink-soft dark:text-ink-soft-dark">Only admins can close the event or change how long contacts are kept.</p>
        <%= link_to "View close event", admin_close_event_path, class: "#{admin_link_class} mt-2 inline-block" %>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Database settings</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Read-only view of the databases configured for this environment in config/database.yml. Sensitive values are never shown.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="<%= admin_badge_class("info") %>"><%= Rails.env %> environment</span>
      </div>
    </div>
    <div class="admin-panel-body">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr>
              <th class="<%= admin_th_class %>">Database</th>
              <th class="<%= admin_th_class %>">Setting</th>
              <th class="<%= admin_th_class %>">Current value</th>
            </tr>
          </thead>
          <tbody>
            <% @database_overview.databases.each do |database| %>
              <% database.entries.each_with_index do |entry, index| %>
                <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                  <% if index.zero? %>
                    <td class="<%= admin_td_class %>" rowspan="<%= database.entries.size %>">
                      <span class="font-medium"><%= database.name %></span>
                    </td>
                  <% end %>
                  <td class="<%= admin_td_class %>"><span class="font-medium"><%= entry.label %></span></td>
                  <td class="<%= admin_td_class %>"><%= admin_configuration_value(entry) %></td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
