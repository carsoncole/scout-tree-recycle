<%= render "admin/shared/page_header",
           title: "Data",
           description: "Import contacts and export reservation data as CSV." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
  <% if flash[:import_errors].present? %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Import row errors</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">The following rows could not be imported.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <ul class="admin-list">
          <% Array(flash[:import_errors]).each do |row_error| %>
            <% row_number = row_error.is_a?(Hash) ? (row_error[:row] || row_error["row"]) : nil %>
            <% messages = row_error.is_a?(Hash) ? Array(row_error[:errors] || row_error["errors"]) : [row_error.to_s] %>
            <li><%= "Row #{row_number}: " if row_number.present? %><%= messages.join(", ") %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Import contacts</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Upload a CSV file, map its columns to contact fields, and import.</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <div class="admin-notice admin-notice--warning admin-notice--spaced border border-line border-l-[3px] border-l-warning bg-warning-bg text-ink dark:border-line-dark dark:border-l-warning-dark dark:bg-warning-bg-dark dark:text-ink-dark" role="status">
        <div>
          <p class="admin-notice-title">Import errors</p>
          <p>
            Rows that cannot be imported are recorded in the
            <%= link_to "System Logs", admin_logs_path, class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
            with row numbers and validation messages.
          </p>
        </div>
      </div>

      <noscript>
        <div class="admin-notice admin-notice--danger admin-notice--spaced border border-line border-l-[3px] border-l-danger-border bg-danger-bg text-ink dark:border-line-dark dark:border-l-danger-border-dark dark:bg-danger-bg-dark dark:text-ink-dark" role="status">
          <div>
            <p class="admin-notice-title">JavaScript required</p>
            <p>Column mapping requires JavaScript. Enable it in your browser to import CSV files.</p>
          </div>
        </div>
      </noscript>

      <%= form_with url: import_admin_data_path, method: :post, multipart: true,
                    class: "admin-form",
                    data: {
                      controller: "csv-mapping",
                      csv_mapping_fields_value: Contact::IMPORTABLE_FIELDS.map do |value, label|
                        { value: value, label: label, aliases: Contact::IMPORTABLE_FIELD_ALIASES.fetch(value, []) }
                      end.to_json
                    } do |f| %>
        <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
          <div class="admin-field">
            <%= label_tag :file, "CSV file", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= file_field_tag :file, accept: ".csv,text/csv", class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark",
                  data: { csv_mapping_target: "file", action: "change->csv-mapping#load" } %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Upload a CSV with a header row. These fields are required: name, email, mobile, street. Maximum 5 MB.</p>

            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark" data-csv-mapping-target="matchStatus">Matching fields found: none yet.</p>
          </div>

          <p class="admin-error-text text-danger dark:text-danger-dark" data-csv-mapping-target="error" hidden></p>
        </div>

        <div class="admin-form-section border-line dark:border-line-dark">
          <div class="admin-field-grid admin-field-grid--two" style="gap: 1.25rem;" data-csv-mapping-target="mapping"></div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
          <%= submit_tag "Import Contacts CSV", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Export reservations</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Download all reservations, including imported records, as a CSV file.</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <p class="admin-hint admin-hint--spaced text-ink-soft dark:text-ink-soft-dark">Exports every reservation with its mapped fields and route name.</p>
      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= link_to "Export Reservations CSV", export_admin_data_path(format: :csv),
                    class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark",
                    data: { turbo: false } %>
      </div>
    </div>
  </section>
</div>

</div>
