<% content_for :title, "Donations" %>
<% content_for :description, "View and manage donations" %>

<%= render "admin/shared/page_header",
           title: "Donations",
           description: "Review donation history and payment status." %>

<section class="admin-panel">
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Amount</th>
          <th scope="col">Reservation</th>
          <th scope="col">Status</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @donations.each do |donation| %>
          <tr>
            <td><%= donation.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
            <td><%= number_to_currency(donation.amount) %></td>
            <td>
              <% if donation.reservation %>
                <%= link_to donation.reservation.name, admin_reservation_path(donation.reservation), class: "admin-link" %>
              <% else %>
                <span class="admin-table-note">No reservation</span>
              <% end %>
            </td>
            <td>
              <span class="<%= admin_donation_status_badge(donation.status) %>">
                <%= donation.status&.titleize %>
              </span>
            </td>
            <td>
              <div class="admin-table-actions">
                <%= link_to "View", admin_donation_path(donation), class: "admin-link" %>
                <%= button_to "Delete", admin_donation_path(donation),
                    method: :delete,
                    class: "admin-link admin-link--danger",
                    form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @donations.empty? %>
    <p class="admin-empty">No donations have been recorded yet.</p>
  <% end %>
</section>
