<% content_for :title, "Donations" %>
<% content_for :description, "View and manage donations" %>

<%= render "admin/shared/page_header",
           title: "Donations",
           description: "Stripe donations history and payment status." %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="<%= admin_th_class %>">Date</th>
          <th scope="col" class="<%= admin_th_class %>">Amount</th>
          <th scope="col" class="<%= admin_th_class %>">Reservation</th>
          <th scope="col" class="<%= admin_th_class %>">Status</th>
          <th scope="col" class="<%= admin_th_class %>">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @donations.each do |donation| %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>"><%= donation.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
            <td class="<%= admin_td_class %>"><%= number_to_currency(donation.amount) %></td>
            <td class="<%= admin_td_class %>">
              <% if donation.reservation %>
                <%= link_to donation.reservation.name, admin_reservation_path(donation.reservation), class: admin_link_class %>
              <% else %>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No reservation</span>
              <% end %>
            </td>
            <td class="<%= admin_td_class %>">
              <span class="<%= admin_donation_status_badge(donation.status) %>">
                <%= donation.status&.titleize %>
              </span>
            </td>
            <td class="<%= admin_td_class %>">
              <div class="admin-table-actions">
                <%= link_to "View", admin_donation_path(donation), class: admin_link_class %>
                <%= button_to "Delete", admin_donation_path(donation),
                    method: :delete,
                    class: admin_link_class(variant: :danger),
                    form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @donations.empty? %>
    <%= render "admin/shared/empty_state", message: "No donations have been recorded yet." %>
  <% end %>
</section>
