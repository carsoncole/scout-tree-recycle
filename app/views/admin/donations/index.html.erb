<% content_for :title, "Donations" %>
<% content_for :description, "View and manage donations" %>

<%= render "admin/shared/page_header",
           title: "Donations",
           description: "Review donation history and payment status." %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Date</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Amount</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Reservation</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Status</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @donations.each do |donation| %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= donation.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= number_to_currency(donation.amount) %></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <% if donation.reservation %>
                <%= link_to donation.reservation.name, admin_reservation_path(donation.reservation), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
              <% else %>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No reservation</span>
              <% end %>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <span class="<%= admin_donation_status_badge(donation.status) %>">
                <%= donation.status&.titleize %>
              </span>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <div class="admin-table-actions">
                <%= link_to "View", admin_donation_path(donation), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                <%= button_to "Delete", admin_donation_path(donation),
                    method: :delete,
                    class: "admin-link admin-link--danger text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark",
                    form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @donations.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No donations have been recorded yet.</p>
  <% end %>
</section>
