<% content_for :title, "Donation Details" %>
<% content_for :description, "View donation details" %>

<%= render "admin/shared/page_header",
           title: "Donation Details",
           description: "Payment and customer information for this donation." %>

<div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Donation information</h2>
        <p class="admin-panel-description">Stripe payment and receipt details.</p>
      </div>
      <span class="<%= admin_donation_status_badge(@donation.status) %>">
        <%= @donation.status&.titleize %>
      </span>
    </div>

    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Amount</dt>
          <dd class="admin-detail-value"><%= number_to_currency(@donation.amount) %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Payment status</dt>
          <dd class="admin-detail-value"><%= @donation.payment_status&.titleize %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Customer name</dt>
          <dd class="admin-detail-value"><%= @donation.customer_name %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Customer email</dt>
          <dd class="admin-detail-value"><%= @donation.email %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Stripe payment intent</dt>
          <dd class="admin-detail-value"><%= @donation.stripe_payment_intent_id %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Receipt email sent</dt>
          <dd class="admin-detail-value"><%= @donation.is_receipt_email_sent ? "Yes" : "No" %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Created at</dt>
          <dd class="admin-detail-value"><%= @donation.created_at.strftime("%b %d, %Y %I:%M %p") %></dd>
        </div>
      </dl>
    </div>
  </section>

  <% if @donation.reservation %>
    <section class="admin-panel">
      <div class="admin-panel-header">
        <h2 class="admin-panel-title">Reservation information</h2>
      </div>
      <div class="admin-panel-body">
        <dl class="admin-detail-list">
          <div class="admin-detail">
            <dt class="admin-detail-label">Name</dt>
            <dd class="admin-detail-value">
              <%= link_to @donation.reservation.name, admin_reservation_path(@donation.reservation), class: "admin-link" %>
            </dd>
          </div>
          <div class="admin-detail">
            <dt class="admin-detail-label">Mobile</dt>
            <dd class="admin-detail-value"><%= @donation.reservation.mobile %></dd>
          </div>
          <div class="admin-detail">
            <dt class="admin-detail-label">Email</dt>
            <dd class="admin-detail-value"><%= @donation.reservation.email %></dd>
          </div>
          <div class="admin-detail">
            <dt class="admin-detail-label">Address</dt>
            <dd class="admin-detail-value"><%= @donation.reservation.address %></dd>
          </div>
        </dl>
      </div>
    </section>
  <% end %>

  <div class="admin-actions">
    <%= link_to "Back to Donations", admin_donations_path, class: "admin-button admin-button--secondary" %>
    <%= button_to "Delete Donation", admin_donation_path(@donation),
        method: :delete,
        class: "admin-button admin-button--danger",
        form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
  </div>
</div>
