<% content_for :title, "Donation Details" %>
<% content_for :description, "View donation details" %>

<div class="w-full bg-gray-50 dark:bg-gray-900 min-h-screen">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Donation Details</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">View donation information</p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="grid grid-cols-1 gap-6">
            <div>
              <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Donation Information</h3>
              <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Amount</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= number_to_currency(@donation.amount) %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Payment Status</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation&.payment_status&.titleize %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Customer Name</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation&.customer_name %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Customer Email</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation&.email %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Stripe Payment Intent ID</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation&.stripe_payment_intent_id %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</dt>
                  <dd class="mt-1">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= @donation.status == 'completed' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' %>">
                      <%= @donation&.status&.titleize %>
                    </span>
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Receipt Email Sent</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation&.is_receipt_email_sent ? "Yes" : "No" %></dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Created At</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation.created_at.strftime("%b %d, %Y %I:%M %p") %></dd>
                </div>
              </dl>
            </div>

            <% if @donation.reservation %>
              <div>
                <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Reservation Information</h3>
                <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Name</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white">
                      <%= link_to @donation.reservation.name, admin_reservation_path(@donation.reservation), class: "text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300" %>
                    </dd>
                  </div>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Mobile</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation.reservation.mobile %></dd>
                  </div>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Email</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation.reservation.email %></dd>
                  </div>
                  <div>
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Address</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white"><%= @donation.reservation.address %></dd>
                  </div>
                </dl>
              </div>
            <% end %>
          </div>

          <div class="mt-8 flex justify-end space-x-3">
            <%= link_to "Back to Donations", admin_donations_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:bg-gray-600" %>
            <%= button_to "Delete Donation", admin_donation_path(@donation), method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500", form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
