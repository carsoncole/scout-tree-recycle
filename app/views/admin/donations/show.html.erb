<% content_for :title, "Donation Details" %>
<% content_for :description, "View donation details" %>

<%= render "admin/shared/page_header",
           title: "Donation Details",
           description: "Payment and customer information for this donation." %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Donation information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Stripe payment and receipt details.</p>
      </div>
      <span class="<%= admin_donation_status_badge(@donation.status) %>">
        <%= @donation.status&.titleize %>
      </span>
    </div>

    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Amount</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= number_to_currency(@donation.amount) %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Payment status</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.payment_status&.titleize %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Customer name</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.customer_name %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Customer email</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.email %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Stripe payment intent</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.stripe_payment_intent_id %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Receipt email sent</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.receipt_email_sent_at.present? ? "Yes" : "No" %></dd>        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Created at</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.created_at.strftime("%b %d, %Y %I:%M %p") %></dd>
        </div>
      </dl>
    </div>
  </section>

  <% if @donation.reservation %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Reservation information</h2>
      </div>
      <div class="admin-panel-body">
        <dl class="admin-detail-list">
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Name</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark">
              <%= link_to @donation.reservation.name, admin_reservation_path(@donation.reservation), class: admin_link_class %>
            </dd>
          </div>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Mobile</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.reservation.mobile %></dd>
          </div>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Email</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.reservation.email %></dd>
          </div>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Address</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @donation.reservation.address %></dd>
          </div>
        </dl>
      </div>
    </section>
  <% end %>

  <div class="flex flex-wrap items-center justify-end gap-3">
    <%= link_to "Back to Donations", admin_donations_path, class: admin_button_class(variant: :secondary) %>
    <%= button_to "Delete Donation", admin_donation_path(@donation),
        method: :delete,
        class: admin_button_class(variant: :danger),
        form: { data: { turbo_confirm: "Are you sure you want to delete this donation?" } } %>
  </div>
</div>
