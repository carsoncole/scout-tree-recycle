<%= form_with(model: [:admin, driver], class: "flex flex-col gap-6") do |form| %>
  <%= render "shared/form_errors", object: driver %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Driver information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Enter the driver's contact details and route assignments.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_field :name, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
        </div>

        <div class="admin-field">
          <%= form.label :phone, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.telephone_field :phone, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
        </div>

        <fieldset class="admin-field">
          <legend class="admin-label text-ink dark:text-ink-dark">Routes</legend>
          <div class="flex flex-col gap-4">
            <%= form.collection_check_boxes :route_ids, Route.ordered, :id, :name do |b| %>
              <label class="admin-check-row text-ink dark:text-ink-dark">
                <%= b.check_box class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_drivers_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
      <%= form.submit class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
    </div>
  </section>
<% end %>
