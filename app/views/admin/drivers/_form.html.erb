<%= form_with(model: [:admin, driver], class: "flex flex-col gap-6") do |form| %>
  <%= render "shared/form_errors", object: driver %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Driver information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Enter the driver's contact details and route assignments.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_field :name, class: admin_input_class %>
        </div>

        <div class="admin-field">
          <%= form.label :mobile, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.telephone_field :mobile, class: admin_input_class, autocomplete: "tel" %>
        </div>

        <div class="admin-field">
          <%= form.label :zone_leader_zone_id, "Zone leader for", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.collection_select :zone_leader_zone_id, Zone.ordered, :id, :name,
              { include_blank: "Not a zone leader" },
              class: admin_select_class %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Each zone has one leader. Selecting a zone that already has a leader reassigns it to this driver.</p>
        </div>

        <fieldset class="admin-field">
          <legend class="admin-label text-ink dark:text-ink-dark">Routes</legend>
          <div class="flex flex-col gap-4">
            <%= form.collection_check_boxes :route_ids, Route.ordered, :id, :name do |b| %>
              <label class="admin-check-row text-ink dark:text-ink-dark">
                <%= b.check_box class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_drivers_path, class: admin_button_class(variant: :secondary) %>
      <%= form.submit class: admin_button_class %>
    </div>
  </section>
<% end %>
