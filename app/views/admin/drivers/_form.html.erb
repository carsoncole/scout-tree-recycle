<%= form_with(model: [:admin, driver], class: "admin-stack") do |form| %>
  <%= render "shared/form_errors", object: driver %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Driver information</h2>
        <p class="admin-panel-description">Enter the driver's contact details and route assignments.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :name, class: "admin-label" %>
          <%= form.text_field :name, class: "admin-input" %>
        </div>

        <div class="admin-field">
          <%= form.label :phone, class: "admin-label" %>
          <%= form.telephone_field :phone, class: "admin-input" %>
        </div>

        <fieldset class="admin-field">
          <legend class="admin-label">Routes</legend>
          <div class="admin-stack admin-stack--tight">
            <%= form.collection_check_boxes :route_ids, Route.ordered, :id, :name do |b| %>
              <label class="admin-check-row">
                <%= b.check_box class: "admin-checkbox" %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_drivers_path, class: "admin-button admin-button--secondary" %>
      <%= form.submit class: "admin-button" %>
    </div>
  </section>
<% end %>
