<%= content_for :title, "Drivers" %>
<%= render "admin/shared/page_header",
           title: "Drivers",
           description: "Manage drivers and the routes assigned to them." do %>
  <%= link_to "Zones", admin_zones_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "Routes", admin_routes_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "New Driver", new_admin_driver_path, class: admin_button_class %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Name</th>
              <th scope="col" class="<%= admin_th_class %>">Mobile</th>
              <th scope="col" class="<%= admin_th_class %>">Routes</th>
              <th scope="col" class="<%= admin_th_class %>">Zones</th>
              <th scope="col" class="<%= admin_th_class %>">Zone leader</th>
              <th scope="col" class="<%= admin_th_class %>">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @drivers.each do |driver| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= driver.name %></td>
                <td class="<%= admin_td_class %>"><%= Phonelib.parse(driver.mobile).national if driver.mobile.present? %></td>
                <td class="<%= admin_td_class %>">
                  <% if driver.routes.any? %>
                    <div class="admin-table-actions">
                      <% driver.routes.each do |route| %>
                        <span class="<%= admin_badge_class(:info) %>"><%= route.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No routes assigned</span>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <% zones = driver.routes.map(&:zone).compact.uniq %>
                  <% if zones.any? %>
                    <div class="admin-table-actions">
                      <% zones.each do |zone| %>
                        <span class="<%= admin_badge_class(:positive) %>"><%= zone.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No zones assigned</span>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <% if driver.zone_leader? %>
                    <div class="admin-table-actions">
                      <span class="<%= admin_badge_class(:warning) %>">Zone leader: <%= driver.zone_leader_zone.name %></span>
                      <%= button_to "Remove leader",
                          admin_driver_path(driver),
                          method: :patch,
                          params: { driver: { zone_leader_zone_id: "" } },
                          class: admin_link_class(variant: :muted) %>
                    </div>
                  <% else %>
                    <%= form_with model: [ :admin, driver ], class: "admin-table-inline" do |form| %>
                      <%= form.collection_select :zone_leader_zone_id, @zones, :id, :name,
                          { include_blank: "Select zone" },
                          { class: "#{admin_select_class} max-w-[11rem]", id: "driver_zone_leader_zone_id_#{driver.id}" } %>
                      <%= form.submit "Flag as leader", class: admin_button_class(variant: :secondary, size: "small") %>
                    <% end %>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <div class="admin-table-actions">
                    <%= link_to "Edit", edit_admin_driver_path(driver), class: admin_link_class %>
                    <%= button_to "Delete", admin_driver_path(driver),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this driver? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: admin_link_class(variant: :danger) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @drivers.empty? %>
        <%= render "admin/shared/empty_state", message: "No drivers have been added yet." %>
      <% end %>
    </section>
  </div>
</div>
