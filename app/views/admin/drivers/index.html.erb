<%= render "admin/shared/page_header",
           title: "Drivers",
           description: "Manage drivers and the routes assigned to them." do %>
  <%= link_to "Zones", admin_zones_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "Routes", admin_routes_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "New Driver", new_admin_driver_path, class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Name</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Mobile</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Routes</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Zones</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @drivers.each do |driver| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= driver.name %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= Phonelib.parse(driver.mobile).national if driver.mobile.present? %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <% if driver.routes.any? %>
                    <div class="admin-table-actions">
                      <% driver.routes.each do |route| %>
                        <span class="admin-badge admin-badge--info bg-info-bg text-info dark:bg-info-bg-dark dark:text-info-dark"><%= route.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No routes assigned</span>
                  <% end %>
                </td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <% zones = driver.routes.map(&:zone).compact.uniq %>
                  <% if zones.any? %>
                    <div class="admin-table-actions">
                      <% zones.each do |zone| %>
                        <span class="admin-badge admin-badge--positive bg-positive-bg text-positive dark:bg-positive-bg-dark dark:text-positive-dark"><%= zone.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No zones assigned</span>
                  <% end %>
                </td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <div class="admin-table-actions">
                    <%= link_to "Edit", edit_admin_driver_path(driver), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                    <%= button_to "Delete", admin_driver_path(driver),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this driver? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: "admin-link admin-link--danger text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @drivers.empty? %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No drivers have been added yet.</p>
      <% end %>
    </section>
  </div>
</div>
