<%= content_for :title, "Locations" %>
<%= render "admin/shared/page_header",
           title: "Locations",
           description: "Staging points, meeting places, and other named map locations." do %>
  <%= link_to "New Location", new_admin_location_path, class: admin_button_class %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Name</th>
              <th scope="col" class="<%= admin_th_class %>">Type</th>
              <th scope="col" class="<%= admin_th_class %>">Latitude</th>
              <th scope="col" class="<%= admin_th_class %>">Longitude</th>
              <th scope="col" class="<%= admin_th_class %>">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @locations.each do |location| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= location.name %></td>
                <td class="<%= admin_td_class %>"><%= location.location_type.presence || "—" %></td>
                <td class="<%= admin_td_class %>"><%= location.latitude %></td>
                <td class="<%= admin_td_class %>"><%= location.longitude %></td>
                <td class="<%= admin_td_class %>">
                  <div class="admin-table-actions">
                    <%= link_to "Edit", edit_admin_location_path(location), class: admin_link_class %>
                    <%= button_to "Delete", admin_location_path(location),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this location? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: admin_link_class(variant: :danger) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @locations.empty? %>
        <%= render "admin/shared/empty_state", message: "No locations have been added yet." %>
      <% else %>
        <%= render "admin/shared/pagination", pagy: @pagy %>
      <% end %>
    </section>
  </div>
</div>
