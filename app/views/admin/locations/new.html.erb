<%= content_for :title, "New Location" %>
<%= render "admin/shared/page_header",
           title: "New Location",
           description: "Create a named map location such as a staging point or meeting place." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <div class="admin-container--narrow admin-container--flush">
      <%= render "form", location: @location %>
    </div>
  </div>
</div>
