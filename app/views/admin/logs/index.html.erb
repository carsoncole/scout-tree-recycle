<%= content_for :title, "System Logs" %>
<%= render "admin/shared/page_header",
           title: "System Logs",
           description: @reservation.present? ?
             "Logs recorded for #{@reservation.name} (reservation ##{@reservation.id})." :
             "View application activity and error reports." do %>
  <% if @reservation %>
    <%= link_to "Back to reservation", admin_reservation_path(@reservation), class: admin_button_class(variant: :secondary) %>
  <% end %>
  <%= render "admin/shared/destructive_details",
             summary_label: "Delete All Logs",
             url: admin_destroy_all_logs_path,
             submit_label: "Confirm Delete All Logs" %>
<% end %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Error email notifications</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Receive an email when a system error is logged.</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <% if @email_configured %>
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-controller="toggle" data-toggle-url="<%= toggle_admin_user_path(Current.user) %>" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Email me error logs</h3>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" aria-label="Email me error logs">
                <%= check_box_tag "user[is_emailed_error_logs]", "1", Current.user.is_emailed_error_logs,
                    class: "admin-switch-input peer",
                    data: {
                      toggle_target: "toggle",
                      setting: "is_emailed_error_logs"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
      <% else %>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Add a from address, SMTP address, and port under Email before these notifications can be sent.</p>
      <% end %>
    </div>
  </section>

  <div class="admin-toolbar">
    <div class="admin-filter-group border border-line-strong bg-surface dark:border-line-strong-dark dark:bg-surface-dark" role="group" aria-label="Filter logs by type">
      <%= link_to "All", admin_logs_path(reservation_id: @reservation&.id), class: admin_filter_class(@selected_log_type.blank?) %>
      <% Log::TYPES.each do |type| %>
        <%= link_to type.humanize, admin_logs_path(type: type, reservation_id: @reservation&.id), class: admin_filter_class(@selected_log_type == type) %>
      <% end %>
    </div>
  </div>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-table-wrap">
      <table class="admin-table min-w-[52rem] text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Timestamp</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Type</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Severity</th>
            <th scope="col" class="<%= admin_th_class %>">Message</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Error type</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @logs.each do |log| %>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="<%= admin_td_class %> whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td class="<%= admin_td_class %> whitespace-nowrap"><%= log.log_type&.humanize %></td>
              <td class="<%= admin_td_class %> whitespace-nowrap">
                <span class="<%= admin_log_severity_badge(log.severity) %>"><%= log.severity&.titleize %></span>
              </td>
              <td class="<%= admin_td_class %> max-w-xl">
                <span class="block truncate" title="<%= log.message %>"><%= log.message %></span>
              </td>
              <td class="<%= admin_td_class %> whitespace-nowrap"><%= log.error_type %></td>
              <td class="<%= admin_td_class %> whitespace-nowrap">
                <%= link_to "View", admin_log_path(log), class: admin_link_class %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy if @pagy.present? %>

    <% if @logs.empty? %>
      <%= render "admin/shared/empty_state",
                 message: @reservation.present? ?
                   "No log entries have been recorded for this reservation." :
                   "No log entries have been recorded." %>
    <% end %>
  </section>
</div>
