<%= content_for :title, "System Logs" %>
<%= render "admin/shared/page_header",
           title: "System Logs",
           description: "View application activity and error reports." do %>
  <%= render "admin/shared/destructive_details",
             summary_label: "Delete All Logs",
             url: admin_destroy_all_logs_path,
             submit_label: "Confirm Delete All Logs" %>
<% end %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-table-wrap">
      <table class="admin-table table-fixed text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="w-[10.5rem] <%= admin_th_class %>">Timestamp</th>
            <th scope="col" class="w-24 <%= admin_th_class %>">Severity</th>
            <th scope="col" class="w-[20rem] <%= admin_th_class %>">Message</th>
            <th scope="col" class="w-[12rem] <%= admin_th_class %>">Error type</th>
            <th scope="col" class="w-[8rem] <%= admin_th_class %>">Environment</th>
            <th scope="col" class="w-[24rem] <%= admin_th_class %>">Context</th>
            <th scope="col" class="w-[6.5rem] <%= admin_th_class %>">Status</th>
            <th scope="col" class="w-[6rem] <%= admin_th_class %>">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @logs.each do |log| %>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="<%= admin_td_class %> whitespace-nowrap"><%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
              <td class="<%= admin_td_class %> whitespace-nowrap">
                <span class="<%= admin_log_severity_badge(log.severity) %>"><%= log.severity&.titleize %></span>
              </td>
              <td class="<%= admin_td_class %>">
                <span class="block truncate" title="<%= log.message %>"><%= log.message %></span>
              </td>
              <td class="<%= admin_td_class %>"><%= log.error_type %></td>
              <td class="<%= admin_td_class %> whitespace-nowrap"><%= log.environment %></td>
              <td class="<%= admin_td_class %>">
                <% context_json = admin_log_context_json(log) %>
                <% if context_json.present? %>
                  <code class="block truncate font-mono text-[0.8rem] text-ink-soft dark:text-ink-soft-dark" title="<%= context_json %>"><%= context_json %></code>
                <% end %>
              </td>
              <td class="<%= admin_td_class %> whitespace-nowrap">
                <span class="<%= admin_handled_badge(log.handled) %>">
                  <%= log.handled ? "Handled" : "Unhandled" %>
                </span>
              </td>
              <td class="<%= admin_td_class %> whitespace-nowrap">
                <%= link_to "View", admin_log_path(log), class: admin_link_class %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy if @pagy.present? %>

    <% if @logs.empty? %>
      <%= render "admin/shared/empty_state", message: "No log entries have been recorded." %>
    <% end %>
  </section>
</div>
