<%= render "admin/shared/page_header",
           title: "Log Details",
           description: "Entry ##{@log.id}, created #{time_ago_in_words(@log.created_at)} ago." do %>
  <%= link_to "Back to list", admin_logs_path, class: "admin-button admin-button--secondary" %>
<% end %>

<div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Message information</h2>
        <p class="admin-panel-description">The reported event and its error type.</p>
      </div>
      <span class="<%= admin_log_severity_badge(@log.severity) %>"><%= @log.severity&.titleize %></span>
    </div>

    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Message</dt>
          <dd class="admin-detail-value"><%= @log.message %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Error type</dt>
          <dd class="admin-detail-value"><%= @log.error_type || "N/A" %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Environment</dt>
          <dd class="admin-detail-value"><%= @log.environment %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Handled</dt>
          <dd class="admin-detail-value">
            <span class="<%= admin_handled_badge(@log.handled) %>"><%= @log.handled ? "Yes" : "No" %></span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <% if @log.context.present? %>
    <section class="admin-panel">
      <div class="admin-panel-header">
        <h2 class="admin-panel-title">Context</h2>
      </div>
      <div class="admin-panel-body">
        <pre class="admin-code"><%= JSON.pretty_generate(@log.context) %></pre>
      </div>
    </section>
  <% end %>

  <% if @log.backtrace.present? %>
    <section class="admin-panel">
      <div class="admin-panel-header">
        <h2 class="admin-panel-title">Backtrace</h2>
      </div>
      <div class="admin-panel-body">
        <pre class="admin-code"><%= @log.backtrace %></pre>
      </div>
    </section>
  <% end %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <h2 class="admin-panel-title">Timestamps</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Created at</dt>
          <dd class="admin-detail-value"><%= @log.created_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Updated at</dt>
          <dd class="admin-detail-value"><%= @log.updated_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
      </dl>
    </div>
    <div class="admin-panel-footer">
      <%= button_to "Delete Log", admin_log_path(@log),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this log? This action cannot be undone.",
            turbo_method: :delete
          },
          class: "admin-button admin-button--danger" %>
    </div>
  </section>
</div>
