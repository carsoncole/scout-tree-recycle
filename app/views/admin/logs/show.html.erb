<%= content_for :title, "Log Details" %>
<%= render "admin/shared/page_header",
           title: "Log Details",
           description: "Entry ##{@log.id}, created #{time_ago_in_words(@log.created_at)} ago." do %>
  <%= link_to "Back to list", admin_logs_path, class: admin_button_class(variant: :secondary) %>
<% end %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Message information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">The reported event and its error type.</p>
      </div>
      <span class="<%= admin_log_severity_badge(@log.severity) %>"><%= @log.severity&.titleize %></span>
    </div>

    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Message</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @log.message %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Error type</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @log.error_type || "N/A" %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Environment</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @log.environment %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Handled</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark">
            <span class="<%= admin_handled_badge(@log.handled) %>"><%= @log.handled ? "Yes" : "No" %></span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <% if @log.context.present? %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Context</h2>
      </div>
      <div class="admin-panel-body">
        <pre class="admin-code bg-stone text-ink dark:bg-stone-dark dark:text-ink-dark"><%= JSON.pretty_generate(@log.context) %></pre>
      </div>
    </section>
  <% end %>

  <% if @log.backtrace.present? %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Backtrace</h2>
      </div>
      <div class="admin-panel-body">
        <pre class="admin-code bg-stone text-ink dark:bg-stone-dark dark:text-ink-dark"><%= @log.backtrace %></pre>
      </div>
    </section>
  <% end %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Timestamps</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Created at</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @log.created_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Updated at</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @log.updated_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
      </dl>
    </div>
    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= button_to "Delete Log", admin_log_path(@log),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this log? This action cannot be undone.",
            turbo_method: :delete
          },
          class: admin_button_class(variant: :danger) %>
    </div>
  </section>
</div>
