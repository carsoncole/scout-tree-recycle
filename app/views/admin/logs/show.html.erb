<div class="w-full bg-gray-50 dark:bg-gray-900">
  <div class="min-h-screen">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900 mb-6">
          <svg class="w-8 h-8 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          Log Details
        </h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">
          View log entry #<%= @log.id %>
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <div class="space-y-6">
            <!-- Status Section -->
            <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Status</h2>
              <div class="flex items-center space-x-4">
                <span class="px-3 py-1 inline-flex text-sm leading-5 font-semibold rounded-full 
                  <%= case @log.severity
                      when 'error'
                        'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300'
                      when 'warning'
                        'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300'
                      when 'info'
                        'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300'
                      else
                        'bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-300'
                      end %>">
                  <%= @log.severity&.titleize %>
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400">
                  Created <%= time_ago_in_words(@log.created_at) %> ago
                </span>
              </div>
            </div>

            <!-- Message Information -->
            <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Message Information</h2>
              <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Message</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @log.message %></dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Error Type</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @log.error_type || 'N/A' %></dd>
                </div>
              </dl>
            </div>

            <!-- Environment Information -->
            <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Environment Information</h2>
              <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Environment</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @log.environment %></dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Handled</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                      <%= @log.handled ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300' %>">
                      <%= @log.handled ? 'Yes' : 'No' %>
                    </span>
                  </dd>
                </div>
              </dl>
            </div>

            <!-- Context Information -->
            <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Context Information</h2>
              <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:rounded-lg">
                <pre class="whitespace-pre-wrap text-sm text-gray-900 dark:text-white"><%= JSON.pretty_generate(@log.context) if @log.context.present? %></pre>
              </div>
            </div>

            <!-- Backtrace Information -->
            <% if @log.backtrace.present? %>
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Backtrace</h2>
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:rounded-lg">
                  <pre class="whitespace-pre-wrap text-sm text-gray-900 dark:text-white"><%= @log.backtrace %></pre>
                </div>
              </div>
            <% end %>

            <!-- Timestamps -->
            <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Timestamps</h2>
              <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Created At</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= @log.created_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                  </dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Updated At</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= @log.updated_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                  </dd>
                </div>
              </dl>
            </div>

            <!-- Actions -->
            <div class="flex justify-end space-x-4">
              <%= link_to "Back to List", admin_logs_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
              <%= button_to "Delete Log", admin_log_path(@log), 
                  method: :delete,
                  data: { 
                    turbo_confirm: "Are you sure you want to delete this log? This action cannot be undone.",
                    turbo_method: :delete
                  },
                  class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div> 