<%= content_for :title, "New email" %>
<%= render "admin/shared/page_header",
           title: "New email",
           description: "Send a plain-text message. Attachments are not included." do %>
  <%= link_to "Back to outbox", admin_mail_outbound_emails_path, class: admin_button_class(variant: :secondary) %>
<% end %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-body">
      <% if @email_alert.present? %>
        <p class="<%= admin_notice_class("warning", spaced: true) %>"><%= @email_alert %></p>
      <% end %>

      <%= form_with url: admin_mail_outbound_emails_path, class: "admin-form" do |form| %>
        <div class="admin-field">
          <%= form.label :to, "To", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.email_field :to, value: @to, required: true, class: admin_input_class, autocomplete: "email" %>
        </div>
        <div class="admin-field">
          <%= form.label :subject, "Subject", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_field :subject, value: @subject, required: true, class: admin_input_class %>
        </div>
        <div class="admin-field">
          <%= form.label :body, "Message", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_area :body, value: @body, rows: 8, required: true, class: admin_textarea_class %>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-3">
          <%= form.submit "Send email", class: admin_button_class, disabled: @email_alert.present? %>
        </div>
      <% end %>
    </div>
  </section>
</div>
