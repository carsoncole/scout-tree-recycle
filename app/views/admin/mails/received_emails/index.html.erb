<%= content_for :title, "Mail" %>
<%= render "admin/shared/page_header",
           title: "Mail",
           description: "Received messages. Template sends are listed in the outbox." %>

<div class="flex flex-col gap-6">
  <%= render "admin/mails/tabs" %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-table-wrap">
      <table class="admin-table min-w-[48rem] text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Date</th>
            <th scope="col" class="<%= admin_th_class %>">From</th>
            <th scope="col" class="<%= admin_th_class %>">Subject</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Type</th>
            <th scope="col" class="<%= admin_th_class %> whitespace-nowrap">Read</th>
          </tr>
        </thead>
        <tbody id="received_email_rows">
          <%= render partial: "admin/mails/received_emails/row", collection: @received_emails, as: :email %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy if @pagy.present? && @pagy.count.positive? %>

    <% if @received_emails.empty? %>
      <div id="received_emails_empty">
        <%= render "admin/shared/empty_state", message: "No received emails." %>
      </div>
    <% end %>
  </section>
</div>
