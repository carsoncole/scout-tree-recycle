<details class="border-t border-line pt-4 dark:border-line-dark">
  <summary class="<%= admin_link_class %>">Send test email</summary>

  <%= form_with url: admin_send_marketing_email_test_path, method: :post, class: "mt-4 flex flex-col gap-3" do %>
    <%= hidden_field_tag :template_name, template.name %>

    <div class="admin-field">
      <%= label_tag "test_email_#{template.name}", "Send to", class: "admin-label text-ink dark:text-ink-dark" %>
      <%= email_field_tag :email, admin_test_email_recipient,
          id: "test_email_#{template.name}",
          class: admin_input_class,
          required: true,
          autocomplete: "email" %>
    </div>

    <div class="admin-field">
      <%= label_tag "test_contact_id_#{template.name}", "Use contact data from", class: "admin-label text-ink dark:text-ink-dark" %>
      <%= select_tag :contact_id,
          options_for_select([ [ "Sample data", "" ] ] + contacts.map { |contact| [ "#{contact.name} <#{contact.email}>", contact.id ] }),
          id: "test_contact_id_#{template.name}",
          class: admin_select_class %>
    </div>

    <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Sends the published version of this email. Test sends do not update contact send dates.</p>

    <%= submit_tag "Send Test Email",
        class: admin_button_class(variant: :secondary, size: :small) %>
  <% end %>
</details>
