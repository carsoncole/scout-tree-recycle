<%= render "admin/shared/page_header",
           title: "Marketing",
           description: "Send campaign emails and review prior reservation contacts." %>

<div class="admin-stack">
  <div class="admin-grid admin-grid--two">
    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Marketing email 1</h2>
          <p class="admin-panel-description"><%= @marketing_1_count %> emails remaining.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <%= button_to admin_send_marketing_email_1_path, class: "admin-button" do %>
          Send Marketing Email 1
        <% end %>
      </div>
    </section>

    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Marketing email 2</h2>
          <p class="admin-panel-description"><%= @marketing_2_count %> emails remaining.</p>
        </div>
      </div>
      <div class="admin-panel-body">
        <%= button_to admin_send_marketing_email_2_path, class: "admin-button" do %>
          Send Marketing Email 2
        <% end %>
      </div>
    </section>
  </div>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Prior Reservations</h2>
        <p class="admin-panel-description">Contacts carried over from previous events.</p>
      </div>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Street</th>
            <th scope="col">Contact</th>
            <th scope="col">Email 1</th>
            <th scope="col">Email 2</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @prior_reservations.each do |reservation| %>
            <tr>
              <td><%= reservation.name %></td>
              <td><%= reservation.street %></td>
              <td>
                <%= reservation.email %><br>
                <span class="admin-table-note"><%= reservation.mobile.present? ? Phonelib.parse(reservation.mobile).national : nil %></span>
              </td>
              <td>
                <% if reservation.marketing_1_email_sent_at.present? %>
                  <span class="admin-badge admin-badge--positive">Sent</span>
                <% else %>
                  <span class="admin-badge admin-badge--neutral">Not sent</span>
                <% end %>
              </td>
              <td>
                <% if reservation.marketing_2_email_sent_at.present? %>
                  <span class="admin-badge admin-badge--positive">Sent</span>
                <% else %>
                  <span class="admin-badge admin-badge--neutral">Not sent</span>
                <% end %>
              </td>
              <td>
                <%= button_to "Delete", admin_prior_reservation_path(reservation),
                    method: :delete,
                    data: {
                      turbo_confirm: "Are you sure you want to delete this prior reservation? This action cannot be undone.",
                      turbo_method: :delete
                    },
                    class: "admin-link admin-link--danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @prior_reservations.empty? %>
      <p class="admin-empty">No prior reservations are available for marketing.</p>
    <% end %>
  </section>
</div>
