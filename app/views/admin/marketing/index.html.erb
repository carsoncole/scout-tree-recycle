<%= content_for :title, "Marketing" %>
<%= render "admin/shared/page_header",
           title: "Marketing",
           description: "Send campaign emails and review contacts." do %>
  <%= link_to "View Email Images", admin_marketing_images_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "Manage Email Templates", admin_marketing_email_templates_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "Reservation Emails", admin_reservation_email_templates_path, class: admin_button_class(variant: :secondary) %>
<% end %>

<% template_1 = @marketing_email_templates["marketing_email_1"] %>
<% template_2 = @marketing_email_templates["marketing_email_2"] %>

<div class="flex flex-col gap-6">
  <% unless @emailing_enabled %>
    <div class="<%= admin_notice_class(:warning) %>" role="note">
      <p>Marketing emailing is disabled. You can enable marketing emailing in <%= link_to "Settings", admin_settings_section_path("email"), class: admin_link_class %>.</p>
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Marketing email 1</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark"><%= @marketing_1_count %> emails remaining.</p>
        </div>
        <div class="admin-table-inline">
          <% if template_1.nil? %>
            <span class="<%= admin_badge_class(:danger) %>">Template missing</span>
          <% elsif template_1.published? && template_1.draft_changes? %>
            <span class="<%= admin_badge_class(:warning) %>">Published with changes</span>
          <% elsif template_1.published? %>
            <span class="<%= admin_badge_class(:positive) %>">Published</span>
          <% else %>
            <span class="<%= admin_badge_class(:warning) %>">Draft - not sending</span>
          <% end %>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="flex flex-col gap-4">
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">
            Sent only once per contact. Contacts who already received Marketing email 1 are skipped, so nobody is emailed twice.
          </p>

          <% if template_1.present? %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark"><strong>Subject:</strong> <%= template_1.live_subject %></p>
            <div class="flex flex-wrap items-center justify-start gap-3">
              <%= link_to "Edit Template", edit_admin_marketing_email_template_path(template_1), class: admin_button_class(variant: :secondary, size: :small) %>
              <%= link_to "Preview", preview_admin_marketing_email_template_path(template_1, source: template_1.published? ? "published" : "draft"),
                  class: admin_button_class(variant: :secondary, size: :small),
                  target: "_blank",
                  rel: "noopener" %>
            </div>
          <% else %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The default template has not been loaded into the database yet.</p>
            <%= button_to "Load Default Templates", install_defaults_admin_marketing_email_templates_path,
                class: admin_button_class(variant: :secondary, size: :small) %>
          <% end %>

          <div class="flex flex-wrap items-center justify-start gap-3">
            <%= button_to admin_send_marketing_email_1_path,
                class: [ admin_button_class, "disabled:cursor-not-allowed disabled:opacity-50" ],
                disabled: !@emailing_enabled,
                data: { turbo_confirm: admin_marketing_send_confirm("Marketing Email 1", @marketing_1_batch_size) } do %>
              Send Marketing Email 1
            <% end %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
              Batch size: <strong class="text-ink dark:text-ink-dark"><%= pluralize(@email_batch_quantity, "contact") %></strong> per send.
              <%= link_to "Edit in Settings", admin_settings_section_path("email"), class: admin_link_class %>
            </p>
          </div>

          <% if template_1.present? %>
            <%= render "test_email_form", template: template_1, contacts: @test_contacts %>
          <% end %>
        </div>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Marketing email 2</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark"><%= @marketing_2_count %> emails remaining.</p>
        </div>
        <div class="admin-table-inline">
          <% if template_2.nil? %>
            <span class="<%= admin_badge_class(:danger) %>">Template missing</span>
          <% elsif template_2.published? && template_2.draft_changes? %>
            <span class="<%= admin_badge_class(:warning) %>">Published with changes</span>
          <% elsif template_2.published? %>
            <span class="<%= admin_badge_class(:positive) %>">Published</span>
          <% else %>
            <span class="<%= admin_badge_class(:warning) %>">Draft - not sending</span>
          <% end %>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="flex flex-col gap-4">
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">
            Sent only once per contact. Contacts who already received Marketing email 2 are skipped, so nobody is emailed twice.
          </p>

          <% if template_2.present? %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark"><strong>Subject:</strong> <%= template_2.live_subject %></p>
            <div class="flex flex-wrap items-center justify-start gap-3">
              <%= link_to "Edit Template", edit_admin_marketing_email_template_path(template_2), class: admin_button_class(variant: :secondary, size: :small) %>
              <%= link_to "Preview", preview_admin_marketing_email_template_path(template_2, source: template_2.published? ? "published" : "draft"),
                  class: admin_button_class(variant: :secondary, size: :small),
                  target: "_blank",
                  rel: "noopener" %>
            </div>
          <% else %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The default template has not been loaded into the database yet.</p>
            <%= button_to "Load Default Templates", install_defaults_admin_marketing_email_templates_path,
                class: admin_button_class(variant: :secondary, size: :small) %>
          <% end %>

          <div class="flex flex-wrap items-center justify-start gap-3">
            <%= button_to admin_send_marketing_email_2_path,
                class: [ admin_button_class, "disabled:cursor-not-allowed disabled:opacity-50" ],
                disabled: !@emailing_enabled,
                data: { turbo_confirm: admin_marketing_send_confirm("Marketing Email 2", @marketing_2_batch_size) } do %>
              Send Marketing Email 2
            <% end %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
              Batch size: <strong class="text-ink dark:text-ink-dark"><%= pluralize(@email_batch_quantity, "contact") %></strong> per send.
              <%= link_to "Edit in Settings", admin_settings_section_path("email"), class: admin_link_class %>
            </p>
          </div>

          <% if template_2.present? %>
            <%= render "test_email_form", template: template_2, contacts: @test_contacts %>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <div class="<%= admin_notice_class %>" role="note">
    <div>
      <p><strong>Note:</strong> Unsubscribed contacts are skipped by both marketing campaigns. Any contacts with the same email as a newly confirmed reservation are removed automatically (unless they have unsubscribed from marketing), so a row may disappear from this table once that contact reserves again.</p>
    </div>
  </div>

  <div class="admin-toolbar justify-end">
    <%= form_with url: admin_marketing_index_path, method: :get, class: "flex max-w-sm items-center gap-2" do |form| %>
      <%= form.label :q, "Search contacts", class: "sr-only" %>
      <%= form.text_field :q, value: params[:q], placeholder: "Search name, email, or address", class: admin_input_class %>
      <%= form.submit "Search", class: admin_button_class(variant: "secondary") %>
    <% end %>
  </div>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Contacts (<%= @pagy.count %>)</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Contacts from prior reservations and restored backups. <%= link_to "Data", admin_data_path, class: admin_link_class %></p>
      </div>
      <%= link_to "New Contact", new_admin_contact_path, class: admin_button_class %>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="<%= admin_th_class %>">Name</th>
            <th scope="col" class="<%= admin_th_class %>">Street</th>
            <th scope="col" class="<%= admin_th_class %>">Contact</th>
            <th scope="col" class="<%= admin_th_class %>">Email 1</th>
            <th scope="col" class="<%= admin_th_class %>">Email 2</th>
            <th scope="col" class="<%= admin_th_class %>">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @contacts.each do |contact| %>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="<%= admin_td_class %>"><%= contact.name %></td>
              <td class="<%= admin_td_class %>"><%= contact.street %></td>
              <td class="<%= admin_td_class %>">
                <%= contact.email %><br>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= contact.mobile.present? ? Phonelib.parse(contact.mobile).national : nil %></span>
                <% if contact.is_unsubscribed_from_marketing? %>
                  <br><span class="<%= admin_badge_class(:warning) %>">Unsubscribed</span>
                <% end %>
              </td>
              <td class="<%= admin_td_class %>">
                <% if contact.is_unsubscribed_from_marketing? %>
                  <span class="<%= admin_badge_class(:neutral) %>">Skipped</span>
                <% elsif contact.marketing_1_email_sent_at.present? %>
                  <div class="admin-table-inline">
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= admin_marketing_sent_at(contact.marketing_1_email_sent_at) %></span>
                    <%= button_to clear_marketing_email_1_admin_contact_path(contact),
                        method: :delete,
                        class: "admin-icon-action text-ink-soft hover:text-danger dark:text-ink-soft-dark dark:hover:text-danger-dark",
                        form_class: "admin-icon-form",
                        title: "Clear Marketing email 1 sent date",
                        aria: { label: "Clear Marketing email 1 sent date" },
                        data: { turbo_confirm: "Clear the Marketing email 1 sent date for this contact? They can be emailed again." } do %>
                      <%= admin_trash_icon %>
                    <% end %>
                  </div>
                <% elsif contact.eligible_for_marketing_email?(1) %>
                  <%= button_to send_marketing_email_1_admin_contact_path(contact),
                      class: "admin-icon-action text-ink-soft hover:text-sage-deep dark:text-ink-soft-dark dark:hover:text-sage-deep-dark",
                      form_class: "admin-icon-form",
                      title: "Send Marketing email 1 to #{contact.email}",
                      aria: { label: "Send Marketing email 1 to #{contact.email}" },
                      data: { turbo_confirm: "Send Marketing email 1 to #{contact.email}? This cannot be undone." } do %>
                    <%= admin_mail_icon %>
                  <% end %>
                <% else %>
                  <span class="<%= admin_badge_class(:neutral) %>">Not sent</span>
                <% end %>
              </td>
              <td class="<%= admin_td_class %>">
                <% if contact.is_unsubscribed_from_marketing? %>
                  <span class="<%= admin_badge_class(:neutral) %>">Skipped</span>
                <% elsif contact.marketing_2_email_sent_at.present? %>
                  <div class="admin-table-inline">
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= admin_marketing_sent_at(contact.marketing_2_email_sent_at) %></span>
                    <%= button_to clear_marketing_email_2_admin_contact_path(contact),
                        method: :delete,
                        class: "admin-icon-action text-ink-soft hover:text-danger dark:text-ink-soft-dark dark:hover:text-danger-dark",
                        form_class: "admin-icon-form",
                        title: "Clear Marketing email 2 sent date",
                        aria: { label: "Clear Marketing email 2 sent date" },
                        data: { turbo_confirm: "Clear the Marketing email 2 sent date for this contact? They can be emailed again." } do %>
                      <%= admin_trash_icon %>
                    <% end %>
                  </div>
                <% elsif contact.eligible_for_marketing_email?(2) %>
                  <%= button_to send_marketing_email_2_admin_contact_path(contact),
                      class: "admin-icon-action text-ink-soft hover:text-sage-deep dark:text-ink-soft-dark dark:hover:text-sage-deep-dark",
                      form_class: "admin-icon-form",
                      title: "Send Marketing email 2 to #{contact.email}",
                      aria: { label: "Send Marketing email 2 to #{contact.email}" },
                      data: { turbo_confirm: "Send Marketing email 2 to #{contact.email}? This cannot be undone." } do %>
                    <%= admin_mail_icon %>
                  <% end %>
                <% else %>
                  <span class="<%= admin_badge_class(:neutral) %>">Not sent</span>
                <% end %>
              </td>
              <td class="<%= admin_td_class %>">
                <div class="admin-table-actions">
                  <%= link_to "Show", admin_contact_path(contact), class: admin_link_class %>
                  <%= link_to "Edit", edit_admin_contact_path(contact), class: admin_link_class %>
                  <%= button_to "Delete", admin_contact_path(contact),
                      method: :delete,
                      data: {
                        turbo_confirm: "Are you sure you want to delete this contact? This action cannot be undone.",
                        turbo_method: :delete
                      },
                      class: admin_link_class(variant: :danger) %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy if @pagy.present? %>

    <% if @contacts.empty? %>
      <%= render "admin/shared/empty_state", message: "No contacts are available for marketing." %>
    <% end %>
  </section>
</div>
