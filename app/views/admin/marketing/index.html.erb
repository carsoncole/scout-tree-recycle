<%= render "admin/shared/page_header",
           title: "Marketing",
           description: "Send campaign emails and review contacts." do %>
  <%= link_to "View Email Images", admin_marketing_images_path, class: "admin-button admin-button--secondary" %>
  <%= link_to "Manage Email Templates", admin_marketing_email_templates_path, class: "admin-button admin-button--secondary" %>
<% end %>

<% template_1 = @marketing_email_templates["marketing_email_1"] %>
<% template_2 = @marketing_email_templates["marketing_email_2"] %>

<div class="admin-stack">
  <div class="admin-grid admin-grid--two">
    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Marketing email 1</h2>
          <p class="admin-panel-description"><%= @marketing_1_count %> emails remaining.</p>
        </div>
        <div class="admin-table-inline">
          <% if template_1.nil? %>
            <span class="admin-badge admin-badge--danger">Template missing</span>
          <% elsif template_1.published? && template_1.draft_changes? %>
            <span class="admin-badge admin-badge--warning">Published with changes</span>
          <% elsif template_1.published? %>
            <span class="admin-badge admin-badge--positive">Published</span>
          <% else %>
            <span class="admin-badge admin-badge--warning">Draft - not sending</span>
          <% end %>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="admin-stack admin-stack--tight">
          <p class="admin-panel-description">
            Sent only once per contact. Contacts who already received Marketing email 1 are skipped, so nobody is emailed twice.
          </p>

          <% if template_1.present? %>
            <p class="admin-hint"><strong>Subject:</strong> <%= template_1.live_subject %></p>
            <div class="admin-actions admin-actions--start">
              <%= link_to "Edit Template", edit_admin_marketing_email_template_path(template_1), class: "admin-button admin-button--secondary admin-button--small" %>
              <%= link_to "Preview", preview_admin_marketing_email_template_path(template_1, source: template_1.published? ? "published" : "draft"),
                  class: "admin-button admin-button--secondary admin-button--small",
                  target: "_blank",
                  rel: "noopener" %>
            </div>
          <% else %>
            <p class="admin-hint">The default template has not been loaded into the database yet.</p>
            <%= button_to "Load Default Templates", install_defaults_admin_marketing_email_templates_path,
                class: "admin-button admin-button--secondary admin-button--small" %>
          <% end %>

          <%= button_to admin_send_marketing_email_1_path, class: "admin-button" do %>
            Send Marketing Email 1
          <% end %>
        </div>
      </div>
    </section>

    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Marketing email 2</h2>
          <p class="admin-panel-description"><%= @marketing_2_count %> emails remaining.</p>
        </div>
        <div class="admin-table-inline">
          <% if template_2.nil? %>
            <span class="admin-badge admin-badge--danger">Template missing</span>
          <% elsif template_2.published? && template_2.draft_changes? %>
            <span class="admin-badge admin-badge--warning">Published with changes</span>
          <% elsif template_2.published? %>
            <span class="admin-badge admin-badge--positive">Published</span>
          <% else %>
            <span class="admin-badge admin-badge--warning">Draft - not sending</span>
          <% end %>
        </div>
      </div>
      <div class="admin-panel-body">
        <div class="admin-stack admin-stack--tight">
          <p class="admin-panel-description">
            Sent only once per contact. Contacts who already received Marketing email 2 are skipped, so nobody is emailed twice.
          </p>

          <% if template_2.present? %>
            <p class="admin-hint"><strong>Subject:</strong> <%= template_2.live_subject %></p>
            <div class="admin-actions admin-actions--start">
              <%= link_to "Edit Template", edit_admin_marketing_email_template_path(template_2), class: "admin-button admin-button--secondary admin-button--small" %>
              <%= link_to "Preview", preview_admin_marketing_email_template_path(template_2, source: template_2.published? ? "published" : "draft"),
                  class: "admin-button admin-button--secondary admin-button--small",
                  target: "_blank",
                  rel: "noopener" %>
            </div>
          <% else %>
            <p class="admin-hint">The default template has not been loaded into the database yet.</p>
            <%= button_to "Load Default Templates", install_defaults_admin_marketing_email_templates_path,
                class: "admin-button admin-button--secondary admin-button--small" %>
          <% end %>

          <%= button_to admin_send_marketing_email_2_path, class: "admin-button" do %>
            Send Marketing Email 2
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <div class="admin-notice" role="note">
    <div>
      <p><strong>Note:</strong> Any contacts with the same email as a newly confirmed reservation are removed automatically, so a row may disappear from this table once that contact reserves again.</p>
    </div>
  </div>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Contacts</h2>
        <p class="admin-panel-description">Contacts from prior reservations and imported contacts. <%= link_to "Import data", admin_data_path, class: "admin-link" %></p>
      </div>
      <%= link_to "New Contact", new_admin_contact_path, class: "admin-button" %>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Street</th>
            <th scope="col">Contact</th>
            <th scope="col">Email 1</th>
            <th scope="col">Email 2</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @contacts.each do |contact| %>
            <tr>
              <td><%= contact.name %></td>
              <td><%= contact.street %></td>
              <td>
                <%= contact.email %><br>
                <span class="admin-table-note"><%= contact.mobile.present? ? Phonelib.parse(contact.mobile).national : nil %></span>
              </td>
              <td>
                <% if contact.marketing_1_email_sent_at.present? %>
                  <div class="admin-table-inline">
                    <span class="admin-table-note"><%= admin_marketing_sent_at(contact.marketing_1_email_sent_at) %></span>
                    <%= button_to clear_marketing_email_1_admin_contact_path(contact),
                        method: :delete,
                        class: "admin-icon-action",
                        form_class: "admin-icon-form",
                        title: "Clear Marketing email 1 sent date",
                        aria: { label: "Clear Marketing email 1 sent date" },
                        data: { turbo_confirm: "Clear the Marketing email 1 sent date for this contact? They can be emailed again." } do %>
                      <%= admin_trash_icon %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="admin-badge admin-badge--neutral">Not sent</span>
                <% end %>
              </td>
              <td>
                <% if contact.marketing_2_email_sent_at.present? %>
                  <div class="admin-table-inline">
                    <span class="admin-table-note"><%= admin_marketing_sent_at(contact.marketing_2_email_sent_at) %></span>
                    <%= button_to clear_marketing_email_2_admin_contact_path(contact),
                        method: :delete,
                        class: "admin-icon-action",
                        form_class: "admin-icon-form",
                        title: "Clear Marketing email 2 sent date",
                        aria: { label: "Clear Marketing email 2 sent date" },
                        data: { turbo_confirm: "Clear the Marketing email 2 sent date for this contact? They can be emailed again." } do %>
                      <%= admin_trash_icon %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="admin-badge admin-badge--neutral">Not sent</span>
                <% end %>
              </td>
              <td>
                <div class="admin-table-actions">
                  <%= link_to "Edit", edit_admin_contact_path(contact), class: "admin-link" %>
                  <%= button_to "Delete", admin_contact_path(contact),
                      method: :delete,
                      data: {
                        turbo_confirm: "Are you sure you want to delete this contact? This action cannot be undone.",
                        turbo_method: :delete
                      },
                      class: "admin-link admin-link--danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy if @pagy.present? %>

    <% if @contacts.empty? %>
      <p class="admin-empty">No contacts are available for marketing.</p>
    <% end %>

    <% if @pagy.present? && @pagy.count.positive? %>
      <div class="admin-danger-zone" id="delete-all-contacts">
        <div class="admin-toolbar">
          <div>
            <h3 class="admin-toggle-title">Delete all contacts</h3>
            <p class="admin-hint">
              This permanently deletes <strong><%= pluralize(@pagy.count, "contact") %></strong>. Type DELETE to confirm.
            </p>
          </div>

          <details class="admin-destructive">
            <summary class="admin-button admin-button--danger">Delete All Contacts</summary>
            <div class="admin-destructive-body">
              <%= form_with url: destroy_all_admin_contacts_path, method: :delete, class: "admin-inline-form" do %>
                <div class="admin-field">
                  <%= label_tag :confirmation, "Type DELETE to confirm", class: "admin-label" %>
                  <%= text_field_tag :confirmation, nil,
                      class: "admin-input",
                      required: true,
                      pattern: "DELETE",
                      title: "Type DELETE exactly to confirm.",
                      autocomplete: "off",
                      spellcheck: false %>
                </div>
                <%= submit_tag "Confirm Delete All Contacts", class: "admin-button admin-button--danger" %>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    <% end %>
  </section>
</div>
