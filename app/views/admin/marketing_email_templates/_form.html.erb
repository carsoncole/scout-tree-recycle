<%= form_with(model: [ :admin, template ], class: "admin-stack") do |f| %>
  <%= render "shared/form_errors", object: template %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Template details</h2>
        <p class="admin-panel-description">The name is the identifier used by the mailer. It cannot be changed after the template is created.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label" %>
            <%= f.text_field :name, class: "admin-input", readonly: template.persisted?, spellcheck: false, autocomplete: "off" %>
            <p class="admin-hint">Lowercase letters, numbers, and underscores. Example: <code>marketing_email_1</code>.</p>
          </div>

          <div class="admin-field">
            <%= f.label :from, "From (optional)", class: "admin-label" %>
            <%= f.text_field :from, class: "admin-input", placeholder: "Leave blank to use Settings" %>
            <p class="admin-hint">Override the From address for this template only.</p>
          </div>
        </div>

        <div class="admin-field">
          <%= f.label :description, class: "admin-label" %>
          <%= f.text_area :description, rows: 2, class: "admin-textarea", placeholder: "What is this email for?" %>
        </div>

        <div class="admin-field">
          <%= f.label :subject, class: "admin-label" %>
          <%= f.text_field :subject, class: "admin-input" %>
          <p class="admin-hint">Liquid variables work here too, for example <code>{{ event.pickup_start_short }}</code>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">HTML body</h2>
        <p class="admin-panel-description">Write the body as an HTML fragment; the mailer supplies the document wrapper. Add a <code>&lt;style&gt;</code> block or use classes; styles are inlined automatically at send time.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.text_area :body_html,
              rows: 28,
              class: "admin-textarea admin-code-input",
              spellcheck: false,
              data: { email_template_editor_target: "field" } %>
          <p class="admin-hint">Use Liquid tags such as <code>{{ contact.name }}</code> and <code>{% if contact.has_name %}...{% endif %}</code>. When inserting contact-provided values into HTML, add the <code>escape</code> filter (for example <code>{{ contact.name | escape }}</code>). See the available variables next to the editor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Plain-text body</h2>
        <p class="admin-panel-description">Optional, but recommended. If left blank, a plain-text version is generated from the HTML when the email is sent.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.text_area :body_text,
              rows: 12,
              class: "admin-textarea admin-code-input",
              spellcheck: false,
              data: { email_template_editor_target: "field" } %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_marketing_email_templates_path, class: "admin-button admin-button--secondary" %>
      <% if template.persisted? %>
        <%= link_to "Preview Draft",
            preview_admin_marketing_email_template_path(template, source: "draft"),
            class: "admin-button admin-button--secondary",
            target: "_blank",
            rel: "noopener" %>
      <% end %>
      <%= f.submit(template.persisted? ? "Save Draft" : "Create Template", class: "admin-button") %>
    </div>
  </section>
<% end %>
