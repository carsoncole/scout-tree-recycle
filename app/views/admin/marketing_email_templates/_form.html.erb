<%= form_with(model: [ :admin, template ], class: "flex flex-col gap-6") do |f| %>
  <%= render "shared/form_errors", object: template %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Template details</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">The name is the identifier used by the mailer. It cannot be changed after the template is created.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :name, class: admin_input_class, readonly: template.persisted?, spellcheck: false, autocomplete: "off" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Lowercase letters, numbers, and underscores. Example: <code>marketing_email_1</code>.</p>
          </div>

          <div class="admin-field">
            <%= f.label :from, "From (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :from, class: admin_input_class, placeholder: "Leave blank to use Settings" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Override the From address for this template only.</p>
          </div>
        </div>

        <div class="admin-field">
          <%= f.label :description, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= f.text_area :description, rows: 2, class: admin_textarea_class, placeholder: "What is this email for?" %>
        </div>

        <div class="admin-field">
          <%= f.label :subject, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= f.text_field :subject, class: admin_input_class %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Liquid variables work here too, for example <code>{{ event.pickup_start_short }}</code>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Header image</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">The image is embedded in the email. Choose an image from the email image library.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :image, "Image", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.select :image,
                options_for_select([ [ "No image", "" ] ] + EmailImageLibrary.available_images.map { |filename| [ filename, filename ] }, template.image),
                {},
                class: admin_select_class %>
          </div>
        </div>

        <div class="admin-field">
          <%= f.label :image_alt, "Image alt text", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= f.text_field :image_alt, class: admin_input_class, placeholder: "Scouts standing beside a Christmas tree" %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown when images are blocked or by screen readers.</p>
        </div>

        <div class="admin-panel bg-stone text-center dark:bg-stone-dark">
          <% if template.image.present? %>
            <img src="<%= image_path(template.image) %>" alt="<%= template.image_alt.presence || "Image preview" %>" class="h-auto max-w-full" style="max-width: 280px;">
          <% else %>
            <p class="text-ink-soft dark:text-ink-soft-dark">No image selected.</p>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">HTML body</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Write the body as an HTML fragment; the mailer supplies the document wrapper. Add a <code>&lt;style&gt;</code> block or use classes; styles are inlined automatically at send time.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="<%= admin_notice_class(spaced: true) %>" role="note">
        <div>
          <p><strong>Unsubscribe is added automatically.</strong> Every marketing email includes an unsubscribe link at the bottom of the HTML and plain-text versions. Leave it out of this template. The link is required, and it is included even when it is not written here.</p>
        </div>
      </div>

      <div class="admin-form">
        <div class="admin-field">
          <%= f.text_area :body_html,
              rows: 28,
              class: "admin-code-input #{admin_textarea_class}",
              spellcheck: false,
              data: { email_template_editor_target: "field" } %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Use Liquid tags such as <code>{{ contact.name }}</code> and <code>{% if contact.has_name %}...{% endif %}</code>. When inserting contact-provided values into HTML, add the <code>escape</code> filter (for example <code>{{ contact.name | escape }}</code>). See the available variables next to the editor.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Plain-text body</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Optional, but recommended. If left blank, a plain-text version is generated from the HTML when the email is sent. The unsubscribe line is added automatically and is not part of this field.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.text_area :body_text,
              rows: 12,
              class: "admin-code-input #{admin_textarea_class}",
              spellcheck: false,
              data: { email_template_editor_target: "field" } %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_marketing_email_templates_path, class: admin_button_class(variant: :secondary) %>
      <% if template.persisted? %>
        <%= link_to "Preview Draft",
            preview_admin_marketing_email_template_path(template, source: "draft"),
            class: admin_button_class(variant: :secondary),
            target: "_blank",
            rel: "noopener" %>
      <% end %>
      <%= f.submit(template.persisted? ? "Save Draft" : "Create Template", class: admin_button_class) %>
    </div>
  </section>
<% end %>
