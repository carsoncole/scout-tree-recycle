<%= render "admin/shared/page_header",
           title: "Edit #{@template.display_name}",
           description: "Update the draft, preview it with real contact data, then publish it when it is ready to send." do %>
  <%= link_to "Back to Templates", admin_marketing_email_templates_path, class: "admin-button admin-button--secondary" %>
  <%= link_to "Preview Draft",
      preview_admin_marketing_email_template_path(@template, contact_id: @selected_contact.id, source: "draft"),
      class: "admin-button admin-button--secondary",
      target: "_blank",
      rel: "noopener" %>
<% end %>

<div data-controller="email-template-editor"
     data-action="keydown->email-template-editor#handleKeydown focusin->email-template-editor#focus">
  <div class="admin-template-layout">
    <div>
      <%= render "form", template: @template %>
    </div>

    <aside class="admin-template-sidebar">
      <section class="admin-panel">
        <div class="admin-panel-header">
          <div>
            <h2 class="admin-panel-title">Publishing</h2>
            <p class="admin-panel-description">Drafts are safe to edit. Emails use the last published version. Publishing uses the last saved draft, so save your changes first.</p>
          </div>
          <div>
            <% if @template.published? && @template.draft_changes? %>
              <span class="admin-badge admin-badge--warning">Draft changes</span>
            <% elsif @template.published? %>
              <span class="admin-badge admin-badge--positive">Published</span>
            <% else %>
              <span class="admin-badge admin-badge--neutral">Draft</span>
            <% end %>
          </div>
        </div>

        <div class="admin-panel-body">
          <div class="admin-stack admin-stack--tight">
            <% if @template.published_at.present? %>
              <p class="admin-hint">Last published <%= admin_marketing_sent_at(@template.published_at) %>.</p>
            <% else %>
              <p class="admin-hint">This template has never been published, so marketing emails using it will not send.</p>
            <% end %>

            <% if @template.published? && @template.draft_changes? %>
              <p class="admin-hint">The saved draft is different from the live version. Publish to make your changes live.</p>
            <% end %>

            <div class="admin-actions admin-actions--start">
              <%= button_to "Publish Template",
                  publish_admin_marketing_email_template_path(@template),
                  method: :patch,
                  class: "admin-button admin-button--small" %>

              <% if @template.published? %>
                <%= button_to "Unpublish",
                    unpublish_admin_marketing_email_template_path(@template),
                    method: :patch,
                    class: "admin-button admin-button--secondary admin-button--small",
                    data: { turbo_confirm: "Unpublish this template? Marketing emails using it will stop sending until it is published again." } %>
              <% end %>
            </div>

            <% if @template.default? %>
              <p class="admin-hint">This is a built-in template. You can restore the original content as a draft at any time.</p>
              <%= button_to "Restore Default Content",
                  restore_default_admin_marketing_email_template_path(@template),
                  method: :post,
                  class: "admin-button admin-button--secondary admin-button--small",
                  data: { turbo_confirm: "Replace the saved draft with the built-in default content? The live published version will not change until you publish." } %>
            <% end %>
          </div>
        </div>

        <% unless @template.default? %>
          <div class="admin-danger-zone">
            <%= button_to "Delete Template",
                admin_marketing_email_template_path(@template),
                method: :delete,
                class: "admin-button admin-button--danger admin-button--small",
                data: { turbo_confirm: "Are you sure you want to delete this template? This action cannot be undone." } %>
          </div>
        <% end %>
      </section>

      <turbo-frame id="template-preview">
        <section class="admin-panel">
          <div class="admin-panel-header">
            <div>
              <h2 class="admin-panel-title">Preview</h2>
              <p class="admin-panel-description">Preview reflects the last saved draft. Save your changes first to see them here.</p>
            </div>
          </div>

          <div class="admin-panel-body">
            <div class="admin-stack admin-stack--tight">
              <%= form_with url: edit_admin_marketing_email_template_path(@template),
                  method: :get,
                  class: "admin-stack admin-stack--tight",
                  data: { controller: "form", turbo_frame: "template-preview" } do %>
              <div class="admin-field">
                <%= label_tag :preview_contact_id, "Preview with contact", class: "admin-label" %>
                <%= select_tag :contact_id,
                    options_for_select([ [ "Sample data", "" ] ] + @contacts.map { |contact| [ "#{contact.name} <#{contact.email}>", contact.id ] }, @selected_contact.id.to_s),
                    id: "preview_contact_id",
                    class: "admin-select",
                    data: { action: "change->form#submit" } %>
              </div>

              <div class="admin-field">
                <%= label_tag :preview_source, "Version", class: "admin-label" %>
                <%= select_tag :source,
                    options_for_select([ [ "Draft", "draft" ] ] + (@template.published? ? [ [ "Published", "published" ] ] : []), @preview_source.to_s),
                    id: "preview_source",
                    class: "admin-select",
                    data: { action: "change->form#submit" } %>
              </div>

              <%= submit_tag "Update Preview", class: "admin-button admin-button--secondary admin-button--small" %>
            <% end %>

            <% if @preview_error.present? %>
              <p class="admin-error-text">Preview error: <%= @preview_error %></p>
            <% end %>

            <p class="admin-hint"><strong>Subject:</strong> <%= @preview_subject.presence || "(empty)" %></p>

            <iframe class="admin-preview-frame"
                    title="Email template preview"
                    sandbox
                    src="<%= preview_admin_marketing_email_template_path(@template, contact_id: @selected_contact.id, source: @preview_source) %>"></iframe>

            <details>
              <summary class="admin-link">Plain-text preview</summary>
              <pre class="admin-code"><%= @preview_text.presence || "(empty)" %></pre>
            </details>
          </div>
        </div>
        </section>
      </turbo-frame>

      <section class="admin-panel">
        <div class="admin-panel-header">
          <div>
            <h2 class="admin-panel-title">Send test email</h2>
            <p class="admin-panel-description">Save the draft first, then send a test using the contact data selected below. Test sends do not update contact send dates.</p>
          </div>
        </div>

        <div class="admin-panel-body">
          <%= form_with url: send_test_admin_marketing_email_template_path(@template), method: :post, class: "admin-stack admin-stack--tight" do %>
            <div class="admin-field">
              <%= label_tag :email, "Send to", class: "admin-label" %>
              <%= email_field_tag :email,
                  Setting.instance.contact_email.presence || Current.user&.email,
                  class: "admin-input",
                  required: true,
                  autocomplete: "email" %>
            </div>

            <div class="admin-field">
              <%= label_tag :test_contact_id, "Use contact data from", class: "admin-label" %>
              <%= select_tag :contact_id,
                  options_for_select([ [ "Sample data", "" ] ] + @contacts.map { |contact| [ "#{contact.name} <#{contact.email}>", contact.id ] }, @selected_contact.id.to_s),
                  id: "test_contact_id",
                  class: "admin-select" %>
            </div>

            <div class="admin-field">
              <%= label_tag :test_source, "Version", class: "admin-label" %>
              <%= select_tag :source,
                  options_for_select([ [ "Draft", "draft" ] ] + (@template.published? ? [ [ "Published", "published" ] ] : []), "draft"),
                  id: "test_source",
                  class: "admin-select" %>
            </div>

            <%= submit_tag "Send Test Email", class: "admin-button admin-button--secondary admin-button--full" %>
          <% end %>
        </div>
      </section>

      <section class="admin-panel">
        <div class="admin-panel-header">
          <div>
            <h2 class="admin-panel-title">Available variables</h2>
            <p class="admin-panel-description">Click a variable to insert it into the editor you last focused.</p>
          </div>
        </div>

        <div class="admin-panel-body">
          <div class="admin-variable-list">
            <% MarketingEmailTemplate.available_variables.each do |variable| %>
              <button type="button"
                      class="admin-variable-button"
                      title="<%= variable[:description] %>"
                      data-action="email-template-editor#insert"
                      data-variable="{{ <%= variable[:name] %> }}">
                {{ <%= variable[:name] %> }}
              </button>
            <% end %>
          </div>

          <details class="admin-hint--spaced">
            <summary class="admin-link">Show variable descriptions</summary>
            <table class="admin-variable-table">
              <tbody>
                <% MarketingEmailTemplate.available_variables.each do |variable| %>
                  <tr>
                    <th scope="row">{{ <%= variable[:name] %> }}</th>
                    <td><%= variable[:description] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </details>
        </div>
      </section>
    </aside>
  </div>
</div>
