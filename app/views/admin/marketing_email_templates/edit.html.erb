<%= render "admin/shared/page_header",
           title: "Edit #{@template.display_name}",
           description: "Update the draft, preview it with real contact data, then publish it when it is ready to send." do %>
  <%= link_to "Back to Templates", admin_marketing_email_templates_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "Preview Draft",
      preview_admin_marketing_email_template_path(@template, contact_id: @selected_contact.id, source: "draft"),
      class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark",
      target: "_blank",
      rel: "noopener" %>
<% end %>

<div data-controller="email-template-editor"
     data-action="keydown->email-template-editor#handleKeydown focusin->email-template-editor#focus">
  <div class="admin-template-layout">
    <div>
      <%= render "form", template: @template %>
    </div>

    <aside class="admin-template-sidebar">
      <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
        <div class="admin-panel-header border-line dark:border-line-dark">
          <div>
            <h2 class="admin-panel-title text-ink dark:text-ink-dark">Publishing</h2>
            <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Drafts are safe to edit. Emails use the last published version. Publishing uses the last saved draft, so save your changes first.</p>
          </div>
          <div>
            <% if @template.published? && @template.draft_changes? %>
              <span class="admin-badge admin-badge--warning bg-warning-badge text-warning-badge-text dark:bg-warning-badge-dark dark:text-warning-badge-text-dark">Draft changes</span>
            <% elsif @template.published? %>
              <span class="admin-badge admin-badge--positive bg-positive-bg text-positive dark:bg-positive-bg-dark dark:text-positive-dark">Published</span>
            <% else %>
              <span class="admin-badge admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">Draft</span>
            <% end %>
          </div>
        </div>

        <div class="admin-panel-body">
          <div class="flex flex-col gap-4">
            <% if @template.published_at.present? %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Last published <%= admin_marketing_sent_at(@template.published_at) %>.</p>
            <% else %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">This template has never been published, so marketing emails using it will not send.</p>
            <% end %>

            <% if @template.published? && @template.draft_changes? %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The saved draft is different from the live version. Publish to make your changes live.</p>
            <% end %>

            <div class="flex flex-wrap items-center justify-start gap-3">
              <%= button_to "Publish Template",
                  publish_admin_marketing_email_template_path(@template),
                  method: :patch,
                  class: "admin-button admin-button--small bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>

              <% if @template.published? %>
                <%= button_to "Unpublish",
                    unpublish_admin_marketing_email_template_path(@template),
                    method: :patch,
                    class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark",
                    data: { turbo_confirm: "Unpublish this template? Marketing emails using it will stop sending until it is published again." } %>
              <% end %>
            </div>

            <% if @template.default? %>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">This is a built-in template. You can restore the original content as a draft at any time.</p>
              <%= button_to "Restore Default Content",
                  restore_default_admin_marketing_email_template_path(@template),
                  method: :post,
                  class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark",
                  data: { turbo_confirm: "Replace the saved draft with the built-in default content? The live published version will not change until you publish." } %>
            <% end %>
          </div>
        </div>

        <% unless @template.default? %>
          <div class="admin-danger-zone border-danger-border bg-danger-bg dark:border-danger-border-dark dark:bg-danger-bg-dark">
            <%= button_to "Delete Template",
                admin_marketing_email_template_path(@template),
                method: :delete,
                class: "admin-button admin-button--danger admin-button--small bg-danger text-surface hover:bg-[#743730] dark:bg-danger-dark dark:text-page-dark dark:hover:bg-danger-border-dark",
                data: { turbo_confirm: "Are you sure you want to delete this template? This action cannot be undone." } %>
          </div>
        <% end %>
      </section>

      <turbo-frame id="template-preview">
        <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
          <div class="admin-panel-header border-line dark:border-line-dark">
            <div>
              <h2 class="admin-panel-title text-ink dark:text-ink-dark">Preview</h2>
              <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Preview reflects the last saved draft. Save your changes first to see them here.</p>
            </div>
          </div>

          <div class="admin-panel-body">
            <div class="flex flex-col gap-4">
              <%= form_with url: edit_admin_marketing_email_template_path(@template),
                  method: :get,
                  class: "flex flex-col gap-4",
                  data: { controller: "form", turbo_frame: "template-preview" } do %>
              <div class="admin-field">
                <%= label_tag :preview_contact_id, "Preview with contact", class: "admin-label text-ink dark:text-ink-dark" %>
                <%= select_tag :contact_id,
                    options_for_select([ [ "Sample data", "" ] ] + @contacts.map { |contact| [ "#{contact.name} <#{contact.email}>", contact.id ] }, @selected_contact.id.to_s),
                    id: "preview_contact_id",
                    class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark",
                    data: { action: "change->form#submit" } %>
              </div>

              <div class="admin-field">
                <%= label_tag :preview_source, "Version", class: "admin-label text-ink dark:text-ink-dark" %>
                <%= select_tag :source,
                    options_for_select([ [ "Draft", "draft" ] ] + (@template.published? ? [ [ "Published", "published" ] ] : []), @preview_source.to_s),
                    id: "preview_source",
                    class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark",
                    data: { action: "change->form#submit" } %>
              </div>

              <%= submit_tag "Update Preview", class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
            <% end %>

            <% if @preview_error.present? %>
              <p class="admin-error-text text-danger dark:text-danger-dark">Preview error: <%= @preview_error %></p>
            <% end %>

            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark"><strong>Subject:</strong> <%= @preview_subject.presence || "(empty)" %></p>

            <iframe class="admin-preview-frame"
                    title="Email template preview"
                    sandbox
                    src="<%= preview_admin_marketing_email_template_path(@template, contact_id: @selected_contact.id, source: @preview_source) %>"></iframe>

            <details>
              <summary class="admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark">Plain-text preview</summary>
              <pre class="admin-code bg-stone text-ink dark:bg-stone-dark dark:text-ink-dark"><%= @preview_text.presence || "(empty)" %></pre>
            </details>
          </div>
        </div>
        </section>
      </turbo-frame>

      <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
        <div class="admin-panel-header border-line dark:border-line-dark">
          <div>
            <h2 class="admin-panel-title text-ink dark:text-ink-dark">Send test email</h2>
            <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Save the draft first, then send a test using the contact data selected below. Test sends do not update contact send dates.</p>
          </div>
        </div>

        <div class="admin-panel-body">
          <%= form_with url: send_test_admin_marketing_email_template_path(@template), method: :post, class: "flex flex-col gap-4" do %>
            <div class="admin-field">
              <%= label_tag :email, "Send to", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= email_field_tag :email,
                  admin_test_email_recipient,
                  class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark",
                  required: true,
                  autocomplete: "email" %>
            </div>

            <div class="admin-field">
              <%= label_tag :test_contact_id, "Use contact data from", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= select_tag :contact_id,
                  options_for_select([ [ "Sample data", "" ] ] + @contacts.map { |contact| [ "#{contact.name} <#{contact.email}>", contact.id ] }, @selected_contact.id.to_s),
                  id: "test_contact_id",
                  class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
            </div>

            <div class="admin-field">
              <%= label_tag :test_source, "Version", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= select_tag :source,
                  options_for_select([ [ "Draft", "draft" ] ] + (@template.published? ? [ [ "Published", "published" ] ] : []), "draft"),
                  id: "test_source",
                  class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
            </div>

            <%= submit_tag "Send Test Email", class: "admin-button admin-button--secondary admin-button--full border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
          <% end %>
        </div>
      </section>

      <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
        <div class="admin-panel-header border-line dark:border-line-dark">
          <div>
            <h2 class="admin-panel-title text-ink dark:text-ink-dark">Available variables</h2>
            <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Click a variable to insert it into the editor you last focused.</p>
          </div>
        </div>

        <div class="admin-panel-body">
          <div class="admin-variable-list">
            <% MarketingEmailTemplate.available_variables.each do |variable| %>
              <button type="button"
                      class="admin-variable-button border border-line-strong bg-stone text-ink dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark"
                      title="<%= variable[:description] %>"
                      data-action="email-template-editor#insert"
                      data-variable="{{ <%= variable[:name] %> }}">
                {{ <%= variable[:name] %> }}
              </button>
            <% end %>
          </div>

          <details class="admin-hint--spaced">
            <summary class="admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark">Show variable descriptions</summary>
            <table class="admin-variable-table text-ink dark:text-ink-dark">
              <tbody>
                <% MarketingEmailTemplate.available_variables.each do |variable| %>
                  <tr>
                    <th scope="row" class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">{{ <%= variable[:name] %> }}</th>
                    <td class="border-b border-line text-ink-soft dark:border-line-dark dark:text-ink-soft-dark"><%= variable[:description] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </details>
        </div>
      </section>
    </aside>
  </div>
</div>
