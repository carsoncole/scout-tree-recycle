<%= render "admin/shared/page_header",
           title: "Email Templates",
           description: "Edit the marketing emails sent to contacts. Changes are saved as drafts until you publish them." do %>
  <%= link_to "Back to Marketing", admin_marketing_index_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "New Template", new_admin_marketing_email_template_path, class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
  <%= button_to "Load Default Templates",
      install_defaults_admin_marketing_email_templates_path,
      class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark",
      data: { turbo_confirm: "Load the built-in default content? Existing templates will be refreshed as drafts, but published emails will not change until you publish them." } %>
<% end %>

<% if @missing_default_names.any? %>
  <div class="admin-notice admin-notice--warning admin-notice--spaced border border-line border-l-[3px] border-l-warning bg-warning-bg text-ink dark:border-line-dark dark:border-l-warning-dark dark:bg-warning-bg-dark dark:text-ink-dark" role="note">
    <div>
      <p class="admin-notice-title">Default templates are missing</p>
      <p><%= @missing_default_names.map(&:titleize).to_sentence %> can be loaded from the built-in defaults. Use “Load Default Templates” above to create them.</p>
    </div>
  </div>
<% end %>

<div class="admin-notice admin-notice--spaced border border-line border-l-[3px] border-l-sage bg-sage-soft text-ink dark:border-line-dark dark:border-l-sage-dark dark:bg-sage-soft-dark dark:text-ink-dark" role="note">
  <div>
    <p><strong>How templates work:</strong> Write normal HTML with a <code>&lt;style&gt;</code> block and Liquid variables such as <code>{{ contact.first_name }}</code>. CSS is inlined automatically when the email is sent. Publishing copies the current draft to the live version, so edits do not go out until you choose to publish.</p>
  </div>
</div>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Template</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Status</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Subject</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Last published</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @templates.each do |template| %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <strong><%= template.display_name %></strong>
              <div class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= template.name %></div>
              <% if template.description.present? %>
                <div class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= template.description %></div>
              <% end %>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <% if template.published? && template.draft_changes? %>
                <span class="admin-badge admin-badge--warning bg-warning-badge text-warning-badge-text dark:bg-warning-badge-dark dark:text-warning-badge-text-dark">Published with draft changes</span>
              <% elsif template.published? %>
                <span class="admin-badge admin-badge--positive bg-positive-bg text-positive dark:bg-positive-bg-dark dark:text-positive-dark">Published</span>
              <% else %>
                <span class="admin-badge admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">Draft</span>
              <% end %>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <%= template.live_subject %>
              <% if template.published? && template.draft_changes? %>
                <div class="admin-table-note text-ink-soft dark:text-ink-soft-dark">Draft: <%= template.subject %></div>
              <% end %>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <% if template.published_at.present? %>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark"><%= admin_marketing_sent_at(template.published_at) %></span>
              <% else %>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">Never published</span>
              <% end %>
            </td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
              <div class="admin-table-actions">
                <%= link_to "Edit", edit_admin_marketing_email_template_path(template), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                <%= link_to "Preview", preview_admin_marketing_email_template_path(template, source: template.published? ? "published" : "draft"),
                    class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark",
                    target: "_blank",
                    rel: "noopener" %>

                <% if template.published? %>
                  <%= button_to "Unpublish", unpublish_admin_marketing_email_template_path(template),
                      method: :patch,
                      class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark",
                      form_class: "admin-inline-form",
                      data: { turbo_confirm: "Unpublish this template? Marketing emails using it will stop sending until it is published again." } %>
                <% else %>
                  <%= button_to "Publish", publish_admin_marketing_email_template_path(template),
                      method: :patch,
                      class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark",
                      form_class: "admin-inline-form" %>
                <% end %>

                <% unless template.default? %>
                  <%= button_to "Delete", admin_marketing_email_template_path(template),
                      method: :delete,
                      class: "admin-link admin-link--danger text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark",
                      form_class: "admin-inline-form",
                      data: { turbo_confirm: "Are you sure you want to delete this template? This action cannot be undone." } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @templates.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No email templates have been created yet. Load the default templates to get started.</p>
  <% end %>
</section>
