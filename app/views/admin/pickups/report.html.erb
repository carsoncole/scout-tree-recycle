<% content_for :title, "Pending Pickups Report" %>

<% if @pickups_by_route.any? %>
  <%# Render at the printable page width (letter minus @page margins) so Leaflet
      fits the route to the same width that Chrome prints, keeping the map
      centered and uncropped in the PDF. %>
  <div class="mx-auto w-full max-w-[7.8in]">
    <% @pickups_by_route.each_with_index do |(route, reservations), index| %>
    <% if index.positive? %>
      <div class="admin-page-break"></div>
    <% end %>

    <div class="admin-pickup-sheet border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-pickup-header">
        <div>
          <h1 class="admin-pickup-driver text-ink dark:text-ink-dark"><%= route&.name || "No Route Assigned" %></h1>
          <p class="admin-table-note text-ink-soft dark:text-ink-soft-dark">
            <%= route&.zone&.name || "No Zone" %> · <%= pluralize(reservations.size, "reservation") %>
          </p>
        </div>
        <p class="admin-table-note text-muted dark:text-muted-dark">
          Report printed <%= Time.current.strftime("%B %-d, %Y at %-l:%M %p %Z") %>
        </p>
      </div>

      <div class="<%= admin_notice_class(:warning, spaced: true) %>" role="status">
        <div>
          <p class="admin-notice-title">Important — this is a backup report</p>
          <p>
            Mark each tree as <strong>picked</strong> or <strong>missing</strong> below, then update
            its pickup status on the website at
            <strong><%= pickups_root_url %></strong> as soon as possible.
          </p>
        </div>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Name</th>
              <th scope="col" class="<%= admin_th_class %>">Street Address</th>
              <th scope="col" class="<%= admin_th_class %>">Picked</th>
              <th scope="col" class="<%= admin_th_class %>">Missing</th>
            </tr>
          </thead>
          <tbody>
            <% reservations.each do |reservation| %>
              <tr>
                <td class="<%= admin_td_class %>"><%= reservation.name %></td>
                <td class="<%= admin_td_class %>">
                  <%= reservation.street %>
                  <% if reservation.pickup_notes.present? %>
                    <br>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">Notes: <%= reservation.pickup_notes %></span>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <input type="checkbox" class="admin-pickup-check accent-sage dark:accent-sage-dark"
                         aria-label="Mark <%= reservation.name %> as picked">
                </td>
                <td class="<%= admin_td_class %>">
                  <input type="checkbox" class="admin-pickup-check accent-sage dark:accent-sage-dark"
                         aria-label="Mark <%= reservation.name %> as missing">
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-4">
        <%# Large route map: boundary polygon plus every reservation on this sheet. %>
        <%= render "shared/map",
              polygons: (route ? route_boundary_polygon(route) : []),
              markers: reservation_map_markers(reservations),
              height_class: "h-[840px] print:break-inside-avoid",
              show_empty_message: false %>
      </div>

      <% if route && route.drivers.any? %>
        <div class="mt-4 <%= admin_notice_class(:info) %>" role="contentinfo">
          <div>
            <p class="admin-notice-title">Route drivers</p>
            <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
              <% route.drivers.each do |driver| %>
                <span><%= driver.name %> — <%= Phonelib.parse(driver.mobile).national if driver.mobile.present? %></span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  </div>
<% else %>
  <%= render "admin/shared/empty_state", message: "No pending pickups." %>
<% end %>
