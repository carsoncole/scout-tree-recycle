<details class="border-t border-line pt-4 dark:border-line-dark">
  <summary class="<%= admin_link_class %>">Send test email</summary>

  <%= form_with url: send_test_admin_reservation_email_template_path(template), method: :post, class: "mt-4 flex flex-col gap-3" do %>
    <%= hidden_field_tag :source, "published" %>
    <%= hidden_field_tag :return_to, "index" %>

    <div class="admin-field">
      <%= label_tag "test_email_#{template.name}", "Send to", class: "admin-label text-ink dark:text-ink-dark" %>
      <%= email_field_tag :email, admin_test_email_recipient,
          id: "test_email_#{template.name}",
          class: admin_input_class,
          required: true,
          autocomplete: "email" %>
    </div>

    <div class="admin-field">
      <%= label_tag "test_reservation_id_#{template.name}", "Use reservation data from", class: "admin-label text-ink dark:text-ink-dark" %>
      <%= select_tag :reservation_id,
          options_for_select(
            [ [ "Sample data", "" ] ] + reservations.map { |reservation| [ "#{reservation.name.presence || reservation.email} — #{reservation.street}", reservation.id ] }
          ),
          id: "test_reservation_id_#{template.name}",
          class: admin_select_class %>
    </div>

    <% if template.name == "missing_tree_email" %>
      <label class="admin-check-row text-ink dark:text-ink-dark">
        <%= check_box_tag :follow_up, "1", false, id: "test_follow_up_#{template.name}", class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
        <span>Send the follow-up version</span>
      </label>
    <% end %>

    <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
      <% if template.published? %>
        Sends the published version of this email. Test sends do not update reservation send dates.
      <% else %>
        This template is not published yet. Publish it first, or send a draft test from the edit page.
      <% end %>
    </p>

    <%= submit_tag "Send Test Email",
        class: admin_button_class(variant: :secondary, size: :small) %>
  <% end %>
</details>
