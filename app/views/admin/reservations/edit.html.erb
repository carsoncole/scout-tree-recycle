<div class="w-full bg-gray-50 dark:bg-gray-900">
  <div class="min-h-screen">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          Edit Reservation
        </h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">
          Update reservation #<%= @reservation.id %>
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <%= form_with(model: [:admin, @reservation], class: "space-y-6") do |f| %>
            <% if @reservation.errors.any? %>
              <div class="bg-red-50 dark:bg-red-900 p-4 rounded-md">
                <div class="flex">
                  <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-red-400 dark:text-red-300" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                  </div>
                  <div class="ml-3">
                    <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
                      <%= pluralize(@reservation.errors.count, "error") %> prohibited this reservation from being saved:
                    </h3>
                    <div class="mt-2 text-sm text-red-700 dark:text-red-300">
                      <ul class="list-disc pl-5 space-y-1">
                        <% @reservation.errors.full_messages.each do |message| %>
                          <li><%= message %></li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="space-y-6">
              <!-- Contact Information -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Contact Information</h2>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div>
                    <%= f.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_field :name, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-3 py-2" %>
                    </div>
                  </div>

                  <div>
                    <%= f.label :email, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.email_field :email, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-3 py-2" %>
                    </div>
                  </div>

                  <div>
                    <%= f.label :mobile, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.telephone_field :mobile, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-3 py-2" %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Address Information -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Address Information</h2>
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                  <div>
                    <%= f.label :street, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_field :street, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                    </div>
                  </div>

                  <div>
                    <%= f.label :city, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_field :city, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                    </div>
                  </div>

                  <div>
                    <%= f.label :state, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_field :state, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                    </div>
                  </div>

                  <div>
                    <%= f.label :country, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_field :country, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                    </div>
                  </div>
                </div>

                <!-- Coordinates Component -->
                <div class="mt-8 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg border border-yellow-200 dark:border-yellow-800 overflow-hidden">
                  <div class="px-4 py-3 bg-yellow-100 dark:bg-yellow-800/30 border-b border-yellow-200 dark:border-yellow-800">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-2">
                        <h3 class="text-lg font-medium text-yellow-800 dark:text-yellow-200">Coordinates</h3>
                        <% if @reservation.geocoding_failed? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-800 text-red-800 dark:text-red-200" id="status-geocoding-failed">
                            <svg class="mr-1.5 h-2 w-2 text-red-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Auto Geocoding Failed
                          </span>
                        <% elsif @reservation.was_automatically_geocoded? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-800 text-green-800 dark:text-green-200" id="status-auto-geocoded">
                            <svg class="mr-1.5 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Auto Geocoded
                          </span>
                        <% elsif @reservation.is_manually_geocoded? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 dark:bg-yellow-800 text-yellow-800 dark:text-yellow-200" id="status-manually-geocoded">
                            <svg class="mr-1.5 h-2 w-2 text-yellow-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Manually Geocoded
                          </span>
                        <% else %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200" id="status-pending-geocoding">
                            <svg class="mr-1.5 h-2 w-2 text-gray-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Pending
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="p-4">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                      <div>
                        <%= f.label :latitude, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                        <div>
                          <%= f.number_field :latitude, step: :any, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                        </div>
                      </div>

                      <div>
                        <%= f.label :longitude, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                        <div>
                          <%= f.number_field :longitude, step: :any, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2" %>
                        </div>
                      </div>
                    </div>
                    <p class="mt-3 text-sm text-yellow-700 dark:text-yellow-300">
                      <% if @reservation.is_manually_geocoded? %>
                        These coordinates were manually set and will not be automatically updated. For automatic updates, clear the coordinates and save.
                      <% else %>
                        Coordinates automatically updated on address changes.
                      <% end %>
                    </p>
                  </div>
                </div>

                <!-- Route and Status Component -->
                <div class="mt-8 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800 overflow-hidden">
                  <div class="px-4 py-3 bg-blue-100 dark:bg-blue-800/30 border-b border-blue-200 dark:border-blue-800">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-2">
                        <h3 class="text-lg font-medium text-blue-800 dark:text-blue-200">Route and Status</h3>
                        <% if @reservation.routing_failed? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-800 text-red-800 dark:text-red-200" id="status-routing-failed">
                            <svg class="mr-1.5 h-2 w-2 text-red-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Routing Failed
                          </span>
                        <% elsif @reservation.was_automatically_routed? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 dark:bg-green-800 text-green-800 dark:text-green-200" id="status-auto-routed">
                            <svg class="mr-1.5 h-2 w-2 text-green-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Auto Routed
                          </span>
                        <% elsif @reservation.route_id.present? %>
                          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 dark:bg-yellow-800 text-yellow-800 dark:text-yellow-200" id="status-routing">
                            <svg class="mr-1.5 h-2 w-2 text-yellow-400" fill="currentColor" viewBox="0 0 8 8">
                              <circle cx="4" cy="4" r="3" />
                            </svg>
                            Manually Routed
                          </span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="p-4">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                      <div>
                        <%= f.label :route_id, "Route", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                        <div>
                          <%= f.collection_select :route_id, Route.order(:name), :id, :name, 
                              { include_blank: 'Select a route' }, 
                              class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2.5 appearance-none bg-white dark:bg-gray-700" %>
                        </div>
                      </div>

                      <div>
                        <%= f.label :status, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                        <div>
                          <%= f.select :status, 
                              Reservation.statuses.except(:reservation_form, :address_verification, :donation).keys.map { |s| [s.titleize, s] },
                              {},
                              class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-4 py-2.5 appearance-none bg-white dark:bg-gray-700" %>
                        </div>
                      </div>
                    </div>
                    <p class="mt-3 text-sm text-blue-700 dark:text-blue-300">
                      <% if @reservation.is_manually_routed? %>
                        To enable automatic routing, remove the existing route and save. Routes will then be automatically assigned based on address and coordinates.
                      <% else %>
                        Route will be automatically updated when address or coordinates change.
                      <% end %>
                    </p>
                  </div>
                </div>
              </div>

              <!-- Additional Information -->
              <div class="border-b border-gray-200 dark:border-gray-700 pb-6">
                <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Additional Information</h2>
                <div class="grid grid-cols-1 gap-6">
                  <div>
                    <%= f.label :pickup_notes, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
                    <div>
                      <%= f.text_area :pickup_notes, rows: 3, class: "block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:text-white sm:text-sm px-3 py-2" %>
                    </div>
                  </div>

                  
                </div>
              </div>
            </div>

            <div class="flex justify-end space-x-3">
              <%= link_to "Cancel", admin_reservation_path(@reservation), class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 shadow-sm text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
              <%= f.submit "Update Reservation", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
