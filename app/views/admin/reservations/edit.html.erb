<%= render "admin/shared/page_header",
           title: "Edit Reservation",
           description: "Update reservation ##{@reservation.id}." do %>
  <%= link_to "Back to reservation", admin_reservation_path(@reservation), class: "admin-button admin-button--secondary" %>
<% end %>

<%= form_with(model: [:admin, @reservation], class: "admin-stack") do |f| %>
  <%= render "shared/form_errors", object: @reservation %>

  <section class="admin-panel">
    <div class="admin-panel-body">
      <div class="admin-form-section">
        <h2 class="admin-section-title">Contact information</h2>
        <p class="admin-section-description">Customer name, email, and mobile number.</p>

        <div class="admin-field-grid admin-field-grid--three">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label" %>
            <%= f.text_field :name, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= f.label :email, class: "admin-label" %>
            <%= f.email_field :email, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= f.label :mobile, class: "admin-label" %>
            <%= f.telephone_field :mobile, class: "admin-input" %>
          </div>
        </div>
      </div>

      <div class="admin-form-section">
        <h2 class="admin-section-title">Address information</h2>
        <p class="admin-section-description">Update the pickup address and coordinates.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :street, class: "admin-label" %>
            <%= f.text_field :street, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= f.label :city, class: "admin-label" %>
            <%= f.text_field :city, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= f.label :state, class: "admin-label" %>
            <%= f.text_field :state, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= f.label :country, class: "admin-label" %>
            <%= f.text_field :country, class: "admin-input" %>
          </div>
        </div>

        <div class="admin-panel admin-panel--nested">
          <div class="admin-panel-header">
            <div>
              <h3 class="admin-panel-title">Coordinates</h3>
              <p class="admin-panel-description">Used for routing and driver maps.</p>
            </div>

            <% if @reservation.geocoding_failed? %>
              <span class="admin-badge admin-badge--danger" id="status-geocoding-failed">Auto Geocoding Failed</span>
            <% elsif @reservation.was_automatically_geocoded? %>
              <span class="admin-badge admin-badge--positive" id="status-auto-geocoded">Auto Geocoded</span>
            <% elsif @reservation.is_manually_geocoded? %>
              <span class="admin-badge admin-badge--warning" id="status-manually-geocoded">Manually Geocoded</span>
            <% else %>
              <span class="admin-badge admin-badge--neutral" id="status-pending-geocoding">Pending</span>
            <% end %>
          </div>

          <div class="admin-panel-body">
            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= f.label :latitude, class: "admin-label" %>
                <%= f.number_field :latitude, step: :any, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= f.label :longitude, class: "admin-label" %>
                <%= f.number_field :longitude, step: :any, class: "admin-input" %>
              </div>
            </div>

            <p class="admin-hint admin-hint--spaced">
              <% if @reservation.is_manually_geocoded? %>
                These coordinates were manually set and will not be automatically updated. Clear them and save to resume automatic updates.
              <% else %>
                Coordinates are updated automatically when the address changes.
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <div class="admin-form-section">
        <h2 class="admin-section-title">Route and status</h2>
        <p class="admin-section-description">Assign a route or change the reservation state.</p>

        <% if @reservation.routing_failed? %>
          <span class="admin-badge admin-badge--danger" id="status-routing-failed">Routing Failed</span>
        <% elsif @reservation.was_automatically_routed? %>
          <span class="admin-badge admin-badge--positive" id="status-auto-routed">Auto Routed</span>
        <% elsif @reservation.route_id.present? %>
          <span class="admin-badge admin-badge--warning" id="status-routing">Manually Routed</span>
        <% end %>

        <div class="admin-field-grid admin-field-grid--two admin-field-grid--spaced">
          <div class="admin-field">
            <%= f.label :route_id, "Route", class: "admin-label" %>
            <%= f.collection_select :route_id, Route.order(:name), :id, :name,
                { include_blank: "Select a route" },
                class: "admin-select" %>
          </div>
          <div class="admin-field">
            <%= f.label :status, class: "admin-label" %>
            <%= f.select :status,
                Reservation.statuses.except(:reservation_form, :address_verification, :donation).keys.map { |s| [ s.titleize, s ] },
                {},
                class: "admin-select" %>
          </div>
        </div>

        <p class="admin-hint admin-hint--spaced">
          <% if @reservation.is_manually_routed? %>
            Remove the existing route and save to allow automatic routing based on address and coordinates.
          <% else %>
            The route updates automatically when the address or coordinates change.
          <% end %>
        </p>
      </div>

      <div class="admin-form-section">
        <h2 class="admin-section-title">Additional information</h2>
        <p class="admin-section-description">Internal notes for the pickup crew.</p>

        <div class="admin-field">
          <%= f.label :pickup_notes, class: "admin-label" %>
          <%= f.text_area :pickup_notes, rows: 3, class: "admin-textarea" %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_reservation_path(@reservation), class: "admin-button admin-button--secondary" %>
      <%= f.submit "Update Reservation", class: "admin-button" %>
    </div>
  </section>
<% end %>
