<%= content_for :title, "Edit Reservation" %>
<%= render "admin/shared/page_header",
           title: "Edit Reservation",
           description: "Update reservation ##{@reservation.id}." do %>
  <%= link_to "Back to reservation", admin_reservation_path(@reservation), class: admin_button_class(variant: :secondary) %>
<% end %>

<%= form_with(model: [:admin, @reservation], class: "flex flex-col gap-6") do |f| %>
  <%= render "shared/form_errors", object: @reservation %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-body">
      <div class="admin-form-section border-line dark:border-line-dark">
        <h2 class="admin-section-title text-ink dark:text-ink-dark">Contact information</h2>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Customer name, email, and mobile number.</p>

        <div class="admin-field-grid admin-field-grid--three">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :name, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= f.label :email, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.email_field :email, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= f.label :mobile, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.telephone_field :mobile, class: admin_input_class %>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h2 class="admin-section-title text-ink dark:text-ink-dark">Address information</h2>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Update the pickup address and coordinates.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :street, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :street, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= f.label :city, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :city, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= f.label :state, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :state, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= f.label :country, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :country, class: admin_input_class %>
          </div>
        </div>

        <div class="admin-panel admin-panel--nested border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
          <div class="admin-panel-header border-line dark:border-line-dark">
            <div>
              <h3 class="admin-panel-title text-ink dark:text-ink-dark">Coordinates</h3>
              <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Used for routing and driver maps.</p>
            </div>

            <% if @reservation.geocoding_failed? %>
              <span class="<%= admin_badge_class("danger") %>" id="status-geocoding-failed">Auto Geocoding Failed</span>
            <% elsif @reservation.was_automatically_geocoded? %>
              <span class="<%= admin_badge_class("positive") %>" id="status-auto-geocoded">Auto Geocoded</span>
            <% elsif @reservation.is_manually_geocoded? %>
              <span class="<%= admin_badge_class("warning") %>" id="status-manually-geocoded">Manually Geocoded</span>
            <% else %>
              <span class="<%= admin_badge_class("neutral") %>" id="status-pending-geocoding">Pending</span>
            <% end %>
          </div>

          <div class="admin-panel-body">
            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= f.label :latitude, class: "admin-label text-ink dark:text-ink-dark" %>
                <%= f.number_field :latitude, step: :any, class: admin_input_class %>
              </div>
              <div class="admin-field">
                <%= f.label :longitude, class: "admin-label text-ink dark:text-ink-dark" %>
                <%= f.number_field :longitude, step: :any, class: admin_input_class %>
              </div>
            </div>

            <p class="admin-hint admin-hint--spaced text-ink-soft dark:text-ink-soft-dark">
              <% if @reservation.is_manually_geocoded? %>
                These coordinates were manually set and will not be automatically updated. Clear them and save to resume automatic updates.
              <% else %>
                Coordinates are updated automatically when the address changes.
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h2 class="admin-section-title text-ink dark:text-ink-dark">Route and status</h2>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Assign a route or change the reservation state.</p>

        <% if @reservation.routing_failed? %>
          <span class="<%= admin_badge_class("danger") %>" id="status-routing-failed">Routing Failed</span>
        <% elsif @reservation.was_automatically_routed? %>
          <span class="<%= admin_badge_class("positive") %>" id="status-auto-routed">Auto Routed</span>
        <% elsif @reservation.route_id.present? %>
          <span class="<%= admin_badge_class("warning") %>" id="status-routing">Manually Routed</span>
        <% end %>

        <div class="admin-field-grid admin-field-grid--two admin-field-grid--spaced">
          <div class="admin-field">
            <%= f.label :route_id, "Route", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.collection_select :route_id, Route.order(:name), :id, :name,
                { include_blank: "Select a route" },
                class: admin_select_class %>
          </div>
          <div class="admin-field">
            <%= f.label :status, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.select :status,
                Reservation.statuses.except(:reservation_form, :address_verification, :donation).keys.map { |s| [ s.titleize, s ] },
                {},
                class: admin_select_class %>
          </div>
        </div>

        <p class="admin-hint admin-hint--spaced text-ink-soft dark:text-ink-soft-dark">
          <% if @reservation.is_manually_routed? %>
            Remove the existing route and save to allow automatic routing based on address and coordinates.
          <% else %>
            The route updates automatically when the address or coordinates change.
          <% end %>
        </p>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h2 class="admin-section-title text-ink dark:text-ink-dark">Additional information</h2>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Internal notes for the pickup crew.</p>

        <div class="admin-field">
          <%= f.label :pickup_notes, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= f.text_area :pickup_notes, rows: 3, class: admin_textarea_class %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_reservation_path(@reservation), class: admin_button_class(variant: :secondary) %>
      <%= f.submit "Update Reservation", class: admin_button_class %>
    </div>
  </section>
<% end %>
