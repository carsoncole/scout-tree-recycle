<%= render "admin/shared/page_header",
           title: "Reservations",
           description: "Manage tree pickup reservations, routing, and customer details." %>

<div class="admin-stack">
  <div class="admin-toolbar">
    <div class="admin-filter-group" role="group" aria-label="Filter reservations">
      <%= link_to "All Reservations", admin_reservations_path,
                  class: "admin-filter #{'is-active' if params[:status].nil?}" %>
      <%= link_to "Needs Routing", admin_reservations_path(status: "routing"),
                  class: "admin-filter #{'is-active' if params[:status] == 'routing'}" %>
    </div>
  </div>

  <% unless setting.is_routing_enabled %>
    <div class="admin-notice admin-notice--warning" role="status">
      <div>
        <p class="admin-notice-title">Automatic routing is disabled</p>
        <p>
          Routes will need to be manually assigned. Enable automatic routing in
          <%= link_to "Settings", admin_settings_path, class: "admin-link" %>.
        </p>
      </div>
    </div>
  <% end %>

  <section class="admin-panel">
    <div class="admin-table-wrap">
      <table class="admin-table <%= params[:status] == 'routing' ? 'needs-routing' : 'all-reservations' %>">
        <thead>
          <tr>
            <th scope="col">
              <%= link_to admin_reservations_path(sort: "name", direction: params[:sort] == "name" && params[:direction] == "asc" ? "desc" : "asc", status: params[:status]) do %>
                Name<% if params[:sort] == "name" %> <%= params[:direction] == "asc" ? "↑" : "↓" %><% end %>
              <% end %>
            </th>
            <th scope="col">
              <%= link_to admin_reservations_path(sort: "address", direction: params[:sort] == "address" && params[:direction] == "asc" ? "desc" : "asc", status: params[:status]) do %>
                Address<% if params[:sort] == "address" %> <%= params[:direction] == "asc" ? "↑" : "↓" %><% end %>
              <% end %>
            </th>
            <th scope="col">
              <%= link_to admin_reservations_path(sort: "email", direction: params[:sort] == "email" && params[:direction] == "asc" ? "desc" : "asc", status: params[:status]) do %>
                Contact<% if params[:sort] == "email" %> <%= params[:direction] == "asc" ? "↑" : "↓" %><% end %>
              <% end %>
            </th>
            <th scope="col">
              <%= link_to admin_reservations_path(sort: "route", direction: params[:sort] == "route" && params[:direction] == "asc" ? "desc" : "asc", status: params[:status]) do %>
                Route<% if params[:sort] == "route" %> <%= params[:direction] == "asc" ? "↑" : "↓" %><% end %>
              <% end %>
            </th>
            <th scope="col">
              <%= link_to admin_reservations_path(sort: "status", direction: params[:sort] == "status" && params[:direction] == "asc" ? "desc" : "asc", status: params[:status]) do %>
                Status<% if params[:sort] == "status" %> <%= params[:direction] == "asc" ? "↑" : "↓" %><% end %>
              <% end %>
            </th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @reservations.each do |reservation| %>
            <tr class="<%= "is-warning" if reservation.routing_status == "Pending" %><%= "is-danger" if reservation.routing_status == "Manual" %>">
              <td><%= reservation.name %></td>
              <td>
                <%= reservation.street %><br>
                <span class="admin-table-note"><%= reservation.city %></span>
              </td>
              <td>
                <%= reservation.email %><br>
                <span class="admin-table-note"><%= reservation.mobile.present? ? Phonelib.parse(reservation.mobile).national : nil %></span>
              </td>
              <td>
                <span class="admin-badge <%= "admin-badge--warning" if reservation.routing_status == "Pending" %><%= "admin-badge--danger" if reservation.routing_status == "Manual" %>">
                  <%= reservation.routing_status %>
                </span>
                <% if reservation.manual_routing_required? %>
                  <span class="admin-table-note" title="Route needs to be manually set">Needs attention</span>
                <% end %>
              </td>
              <td>
                <span class="<%= admin_reservation_status_badge(reservation.status) %>">
                  <%= reservation.status.titleize %>
                </span>
              </td>
              <td>
                <div class="admin-table-actions">
                  <%= link_to "View", admin_reservation_path(reservation), class: "admin-link" %>
                  <%= link_to "Edit", edit_admin_reservation_path(reservation), class: "admin-link" %>
                  <%= button_to "Delete", admin_reservation_path(reservation),
                      method: :delete,
                      data: {
                        turbo_confirm: "Are you sure you want to delete this reservation? This action cannot be undone.",
                        turbo_method: :delete
                      },
                      class: "admin-link admin-link--danger" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "admin/shared/pagination", pagy: @pagy %>
  </section>
</div>
