<%= render "admin/shared/page_header",
           title: "Reservation Details",
           description: "View and manage reservation ##{@reservation.id}." do %>
  <%= link_to "Edit", edit_admin_reservation_path(@reservation), class: "admin-button" %>
  <%= link_to "Back to list", admin_reservations_path, class: "admin-button admin-button--secondary" %>
<% end %>

<div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Status</h2>
        <p class="admin-panel-description">
          Created <%= time_ago_in_words(@reservation.created_at) %> ago
        </p>
      </div>
      <span class="<%= admin_reservation_status_badge(@reservation.status) %>" id="status-<%= @reservation.status %>">
        <%= @reservation.status.titleize %>
      </span>
    </div>

    <div class="admin-panel-body">
      <%= form_with model: [:admin, @reservation], local: false, class: "admin-field-grid admin-field-grid--two",
                    data: { controller: "form" } do |form| %>
        <div class="admin-field">
          <%= form.label :status, "Update status", class: "admin-label" %>
          <%= form.select :status,
              options_for_select([
                [ "Routing", "routing" ],
                [ "Pending Pickup", "pending_pickup" ],
                [ "Picked Up", "picked_up" ],
                [ "Missing", "missing" ],
                [ "Cancelled", "cancelled" ]
              ], @reservation.status),
              {},
              class: "admin-select",
              data: { action: "change->form#submit" } %>
        </div>
        <p class="admin-hint">Status updates automatically when changed.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Route information</h2>
        <p class="admin-panel-description">Routing and geocoding results for this address.</p>
      </div>
    </div>

    <div class="admin-panel-body admin-stack admin-stack--tight">
      <% if @reservation.geocoding_failed? %>
        <div class="admin-notice admin-notice--danger" role="status">
          <div>
            <p class="admin-notice-title">Auto geocoding failed</p>
            <p>The system was unable to geocode this address. Verify the address and try again.</p>
          </div>
        </div>
      <% end %>

      <% if @reservation.routing_failed? %>
        <div class="admin-notice admin-notice--danger" role="status">
          <div>
            <p class="admin-notice-title">Auto routing failed</p>
            <p>The system was unable to route this reservation. Verify the coordinates and try again.</p>
          </div>
        </div>
      <% end %>

      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Assigned route</dt>
          <dd class="admin-detail-value"><%= @reservation.route&.name || "Unassigned" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <h2 class="admin-panel-title">Contact information</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Name</dt>
          <dd class="admin-detail-value"><%= @reservation.name %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Email</dt>
          <dd class="admin-detail-value">
            <%= mail_to @reservation.email, @reservation.email, class: "admin-link" %>
          </dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Mobile</dt>
          <dd class="admin-detail-value">
            <%= @reservation.mobile.present? ? Phonelib.parse(@reservation.mobile).national : "Not provided" %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Address information</h2>
        <p class="admin-panel-description">Coordinates are used for routing and driver maps.</p>
      </div>
      <%= button_to "Geocode Address", geocode_admin_reservation_path(@reservation),
          method: :post,
          class: "admin-button admin-button--secondary admin-button--small" %>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Street</dt>
          <dd class="admin-detail-value"><%= @reservation.street %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">City</dt>
          <dd class="admin-detail-value"><%= @reservation.city %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">State</dt>
          <dd class="admin-detail-value"><%= @reservation.state %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Country</dt>
          <dd class="admin-detail-value"><%= @reservation.country %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Latitude</dt>
          <dd class="admin-detail-value"><%= @reservation.latitude || "Not available" %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Longitude</dt>
          <dd class="admin-detail-value"><%= @reservation.longitude || "Not available" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <h2 class="admin-panel-title">Additional information</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Pickup notes</dt>
          <dd class="admin-detail-value">
            <%= @reservation.pickup_notes.presence || "No notes provided" %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <h2 class="admin-panel-title">Email history</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <% {
          "Confirmation email" => @reservation.confirmed_reservation_email_sent_at,
          "Cancellation email" => @reservation.cancelled_reservation_email_sent_at,
          "Missing tree email" => @reservation.missing_tree_email_sent_at
        }.each do |label, sent_at| %>
          <div class="admin-detail">
            <dt class="admin-detail-label"><%= label %></dt>
            <dd class="admin-detail-value">
              <% if sent_at.present? %>
                <span class="admin-badge admin-badge--positive">
                  Sent <%= sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                </span>
              <% else %>
                <span class="admin-badge admin-badge--neutral">Not sent</span>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <% if @reservation.missing_tree_sms_sent_at.present? || @reservation.missing_tree_email_sent_at.present? %>
    <section class="admin-panel">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Missing tree notifications</h2>
          <p class="admin-panel-description">This reservation was marked as missing and the customer was notified.</p>
        </div>
        <span class="admin-badge admin-badge--warning">Customer notified</span>
      </div>
      <div class="admin-panel-body">
        <dl class="admin-detail-list">
          <% if @reservation.missing_tree_sms_sent_at.present? %>
            <div class="admin-detail">
              <dt class="admin-detail-label">SMS notification</dt>
              <dd class="admin-detail-value">
                <span class="admin-badge admin-badge--info">
                  Sent <%= @reservation.missing_tree_sms_sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                </span>
              </dd>
            </div>
          <% end %>
          <% if @reservation.missing_tree_email_sent_at.present? %>
            <div class="admin-detail">
              <dt class="admin-detail-label">Email notification</dt>
              <dd class="admin-detail-value">
                <span class="admin-badge admin-badge--positive">
                  Sent <%= @reservation.missing_tree_email_sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                </span>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    </section>
  <% end %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <h2 class="admin-panel-title">Timestamps</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail">
          <dt class="admin-detail-label">Created at</dt>
          <dd class="admin-detail-value"><%= @reservation.created_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
        <div class="admin-detail">
          <dt class="admin-detail-label">Updated at</dt>
          <dd class="admin-detail-value"><%= @reservation.updated_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
      </dl>
    </div>
    <div class="admin-panel-footer">
      <%= button_to "Delete Reservation", admin_reservation_path(@reservation),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this reservation? This action cannot be undone.",
            turbo_method: :delete
          },
          class: "admin-button admin-button--danger" %>
    </div>
  </section>
</div>
