<%= render "admin/shared/page_header",
           title: "Reservation Details",
           description: "View and manage reservation ##{@reservation.id}." do %>
  <%= link_to "Edit", edit_admin_reservation_path(@reservation), class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
  <%= link_to "Back to list", admin_reservations_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
<% end %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Status</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">
          Created <%= time_ago_in_words(@reservation.created_at) %> ago
        </p>
      </div>
      <span class="<%= admin_reservation_status_badge(@reservation.status) %>" id="status-<%= @reservation.status %>">
        <%= @reservation.status.titleize %>
      </span>
    </div>

    <div class="admin-panel-body">
      <%= form_with model: [:admin, @reservation], local: false, class: "admin-field-grid",
                    data: { controller: "form" } do |form| %>
        <div class="admin-field admin-field--short">
          <%= form.label :status, "Update status", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.select :status,
              options_for_select([
                [ "Routing", "routing" ],
                [ "Pending Pickup", "pending_pickup" ],
                [ "Picked Up", "picked_up" ],
                [ "Missing", "missing" ],
                [ "Cancelled", "cancelled" ]
              ], @reservation.status),
              {},
              class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark",
              data: {
                action: "change->form#submit",
                form_confirm_param: "Change this reservation's status? Selecting Missing will generate a missing tree email and/or text message to the customer."
              } %>
        </div>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
          Status updates automatically after you confirm. Selecting Missing will generate a missing tree email and/or text message.
        </p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Route information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Routing results for this reservation</p>
      </div>
      <%= button_to "Route reservation", route_admin_reservation_path(@reservation),
          method: :post,
          class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
    </div>

    <div class="admin-panel-body flex flex-col gap-4">
      <% if @reservation.geocoding_failed? %>
        <div class="admin-notice admin-notice--danger border border-line border-l-[3px] border-l-danger-border bg-danger-bg text-ink dark:border-line-dark dark:border-l-danger-border-dark dark:bg-danger-bg-dark dark:text-ink-dark" role="status">
          <div>
            <p class="admin-notice-title">Auto geocoding failed</p>
            <p>The system was unable to geocode this address. Verify the address and try again.</p>
          </div>
        </div>
      <% end %>

      <% if @reservation.routing_failed? %>
        <div class="admin-notice admin-notice--danger border border-line border-l-[3px] border-l-danger-border bg-danger-bg text-ink dark:border-line-dark dark:border-l-danger-border-dark dark:bg-danger-bg-dark dark:text-ink-dark" role="status">
          <div>
            <p class="admin-notice-title">Auto routing failed</p>
            <p>The system was unable to route this reservation. Verify the coordinates and try again.</p>
          </div>
        </div>
      <% end %>

      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Assigned route</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark">
            <span class="flex flex-wrap items-center gap-2">
              <% if @reservation.route %>
                <%= link_to @reservation.route.name, admin_route_path(@reservation.route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
              <% else %>
                Unassigned
              <% end %>
              <% if @reservation.is_manually_routed? %>
                <span class="admin-badge admin-badge--warning bg-warning-badge text-warning-badge-text dark:bg-warning-badge-dark dark:text-warning-badge-text-dark">Manually assigned</span>
              <% end %>
            </span>
          </dd>
        </div>
      </dl>

      <%= form_with model: [:admin, @reservation],
                    url: assign_route_admin_reservation_path(@reservation),
                    method: :patch,
                    class: "flex flex-wrap items-end gap-3" do |form| %>
        <div class="admin-field w-full sm:max-w-sm">
          <%= form.label :route_id, "Manually assign route", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.collection_select :route_id, Route.order(:name), :id, :name,
              { include_blank: "Unassigned" },
              class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark" %>
        </div>
        <%= form.submit "Save route", class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
      <% end %>
      <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
        Selecting a route marks this reservation as manually routed. Choose Unassigned to clear the route and allow automatic routing again.
      </p>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Contact information</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Name</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.name %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Email</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark">
            <%= mail_to @reservation.email, @reservation.email, class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
          </dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Mobile</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark">
            <%= @reservation.mobile.present? ? Phonelib.parse(@reservation.mobile).national : "Not provided" %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Address information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Coordinates are used for routing and driver maps.</p>
      </div>
      <%= button_to "Geocode Address", geocode_admin_reservation_path(@reservation),
          method: :post,
          class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Street</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.street %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">City</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.city %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">State</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.state %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Country</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.country %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Latitude</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.latitude || "Not available" %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Longitude</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.longitude || "Not available" %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Additional information</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Pickup notes</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark">
            <%= @reservation.pickup_notes.presence || "No notes provided" %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Email history</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Send or resend emails to the customer. Resending updates the sent date below.</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <% Reservation::EMAIL_KINDS.each do |kind, config| %>
          <% sent_at = @reservation.public_send(config[:sent_at]) %>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark"><%= config[:label] %></dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <% if sent_at.present? %>
                  <span class="admin-badge admin-badge--positive bg-positive-bg text-positive dark:bg-positive-bg-dark dark:text-positive-dark">
                    Sent <%= sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                  </span>
                <% else %>
                  <span class="admin-badge admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">Not sent</span>
                <% end %>
                <%= button_to sent_at.present? ? "Resend" : "Send",
                    resend_email_admin_reservation_path(@reservation),
                    params: { kind: kind },
                    data: { turbo_confirm: admin_resend_email_confirm(config[:label], sent_at, @reservation.email) },
                    class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
              </div>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </section>

  <% missing_tree_notified = @reservation.missing_tree_sms_sent_at.present? || @reservation.missing_tree_email_sent_at.present? %>
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Missing tree notifications</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">
          <% if missing_tree_notified %>
            This reservation was marked as missing and the customer was notified.
          <% elsif @reservation.is_missing_tree_notifications_enabled? %>
            Automated email and text notifications are sent when this reservation is marked missing.
          <% else %>
            Automated email and text notifications are disabled for this reservation.
          <% end %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <% if missing_tree_notified %>
          <span class="admin-badge admin-badge--warning bg-warning-badge text-warning-badge-text dark:bg-warning-badge-dark dark:text-warning-badge-text-dark">Customer notified</span>
        <% end %>
        <% unless @reservation.is_missing_tree_notifications_enabled? %>
          <span class="admin-badge admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">Notifications disabled</span>
        <% end %>
      </div>
    </div>
    <div class="admin-panel-body flex flex-col gap-4">
      <div class="admin-toggle-list">
        <div class="admin-toggle-row border-line dark:border-line-dark">
          <div class="admin-toggle-copy">
            <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Automated notifications</h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
              <% if @reservation.is_missing_tree_notifications_enabled? %>
                Send an email and/or text message when this reservation is marked missing.
              <% else %>
                Automated missing tree notifications are disabled for this reservation.
              <% end %>
            </p>
          </div>
          <div class="admin-toggle-control">
            <%= form_with model: [:admin, @reservation], local: false, data: { controller: "form" } do |form| %>
              <label class="admin-switch" id="missing-tree-notifications-toggle" aria-label="Enable automated missing tree notifications">
                <%= form.check_box :is_missing_tree_notifications_enabled,
                    { class: "admin-switch-input peer",
                      data: { testid: "missing-tree-notifications-toggle", action: "change->form#submit" } }, "1", "0" %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <% if missing_tree_notified %>
        <dl class="admin-detail-list">
          <% if @reservation.missing_tree_sms_sent_at.present? %>
            <div class="admin-detail border-line dark:border-line-dark">
              <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">SMS notification</dt>
              <dd class="admin-detail-value text-ink dark:text-ink-dark">
                <span class="admin-badge admin-badge--info bg-info-bg text-info dark:bg-info-bg-dark dark:text-info-dark">
                  Sent <%= @reservation.missing_tree_sms_sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                </span>
              </dd>
            </div>
          <% end %>
          <% if @reservation.missing_tree_email_sent_at.present? %>
            <div class="admin-detail border-line dark:border-line-dark">
              <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Email notification</dt>
              <dd class="admin-detail-value text-ink dark:text-ink-dark">
                <span class="admin-badge admin-badge--positive bg-positive-bg text-positive dark:bg-positive-bg-dark dark:text-positive-dark">
                  Sent <%= @reservation.missing_tree_email_sent_at.strftime("%B %-d, %Y at %-l:%M %p") %>
                </span>
              </dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Timestamps</h2>
    </div>
    <div class="admin-panel-body">
      <dl class="admin-detail-list">
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Created at</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.created_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
        <div class="admin-detail border-line dark:border-line-dark">
          <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Updated at</dt>
          <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @reservation.updated_at.strftime("%B %-d, %Y at %-l:%M %p") %></dd>
        </div>
      </dl>
    </div>
    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= button_to "Delete Reservation", admin_reservation_path(@reservation),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this reservation? This action cannot be undone.",
            turbo_method: :delete
          },
          class: "admin-button admin-button--danger bg-danger text-surface hover:bg-[#743730] dark:bg-danger-dark dark:text-page-dark dark:hover:bg-danger-border-dark" %>
    </div>
  </section>
</div>
