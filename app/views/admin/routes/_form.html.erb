<%= form_with(model: [:admin, @route], class: "space-y-8 divide-y divide-gray-200 dark:divide-gray-700 max-w-xl mx-auto") do |f| %>
  <% if @route.errors.any? %>
    <div class="rounded-md bg-red-50 dark:bg-red-900 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400 dark:text-red-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">
            <%= pluralize(@route.errors.count, "error") %> prohibited this route from being saved:
          </h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-300">
            <ul role="list" class="list-disc space-y-1 pl-5">
              <% @route.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="space-y-8 divide-y divide-gray-200 dark:divide-gray-700">
    <div class="pt-8">
      <div>
        <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Route Information</h3>
        <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">Enter the route details below.</p>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
        <div class="sm:col-span-6">
          <%= f.label :name, class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
          <div class="mt-2">
            <%= f.text_field :name, class: "block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <div class="sm:col-span-6">
          <%= f.label :driver_id, class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
          <div class="mt-2">
            <%= f.collection_select :driver_id, Driver.all, :id, :name, { prompt: "Select a driver" }, 
              class: "block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6",
              style: "appearance: none; background-image: url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\"); background-position: right 0.5rem center; background-repeat: no-repeat; background-size: 1.5em 1.5em; padding-right: 2.5rem;" %>
          </div>
        </div>

        <div class="sm:col-span-6">
          <%= f.label :zone_id, "Zone", class: "block text-sm font-medium leading-6 text-gray-900 dark:text-white" %>
          <div class="mt-2">
            <%= f.collection_select :zone_id, Zone.all, :id, :name,
              { include_blank: "Select a zone" }, 
              { class: "block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6",
                style: "appearance: none; background-image: url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\"); background-position: right 0.5rem center; background-repeat: no-repeat; background-size: 1.5em 1.5em; padding-right: 2.5rem;" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-end gap-x-6">
    <%= link_to "Cancel", admin_routes_path, class: "text-sm font-semibold leading-6 text-gray-900 dark:text-white" %>
    <%= f.submit class: "rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
  </div>
<% end %>

<!-- Route Points Section - Now outside the main form -->
<div class="pt-8 mt-8">
  <div>
    <h3 class="text-base font-semibold leading-7 text-gray-900 dark:text-white">Route Points</h3>
    <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">Define the polygon points that make up this route's area.</p>
  </div>

  <div class="mt-6">
    <!-- Add New Point Form -->
    <div class="bg-gray-50 dark:bg-gray-700 p-4 rounded-lg mb-6">
      <h4 class="text-sm font-medium text-gray-900 dark:text-white mb-4">Add New Point</h4>
      <%= form_with(model: [:admin, @route, Point.new], url: admin_route_points_path(@route), class: "grid grid-cols-1 gap-4 sm:grid-cols-4") do |point_form| %>
        <div>
          <%= point_form.label :latitude, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= point_form.number_field :latitude, step: :any, required: true, class: "mt-1 block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6" %>
        </div>

        <div>
          <%= point_form.label :longitude, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= point_form.number_field :longitude, step: :any, required: true, class: "mt-1 block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6" %>
        </div>

        <div>
          <%= point_form.label :order, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= point_form.number_field :order, required: true, class: "mt-1 block w-full rounded-md border-0 py-2 px-3 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-700 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 dark:bg-gray-800 sm:text-sm sm:leading-6" %>
        </div>

        <div class="flex items-end mt-4">
          <%= point_form.submit "Add Point", class: "w-full rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
        </div>
      <% end %>
    </div>

    <!-- Points List -->
    <div class="bg-white dark:bg-gray-800 shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flow-root">
          <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
              <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-700">
                <thead>
                  <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-white sm:pl-0">Order</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Latitude</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Longitude</th>
                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
                      <span class="sr-only">Actions</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                  <% @route.points.order(:order).each do |point| %>
                    <tr>
                      <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-white sm:pl-0"><%= point.order %></td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-400"><%= point.latitude %></td>
                      <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-400"><%= point.longitude %></td>
                      <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-0">
                        <%= button_to "Delete", admin_route_point_path(@route, point), 
                            method: :delete,
                            class: "text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300",
                            form: { data: { turbo_confirm: "Are you sure you want to delete this point?" } } %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
