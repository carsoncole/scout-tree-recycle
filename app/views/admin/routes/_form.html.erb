<div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Route information</h2>
        <p class="admin-panel-description">Name the route and assign it to a zone.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with(model: [:admin, @route], class: "admin-form") do |f| %>
        <%= render "shared/form_errors", object: @route %>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label" %>
            <%= f.text_field :name, class: "admin-input" %>
          </div>

          <div class="admin-field">
            <%= f.label :zone_id, "Zone", class: "admin-label" %>
            <%= f.collection_select :zone_id, Zone.ordered, :id, :name,
                { include_blank: "Select a zone" },
                class: "admin-select" %>
          </div>
        </div>

        <div class="admin-actions">
          <%= link_to "Cancel", admin_routes_path, class: "admin-button admin-button--secondary" %>
          <%= f.submit class: "admin-button" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Route points</h2>
        <p class="admin-panel-description">Define the polygon points that make up this route's area.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with(model: [:admin, @route, Point.new], url: admin_route_points_path(@route), class: "admin-form") do |point_form| %>
        <div class="admin-field-grid admin-field-grid--three">
          <div class="admin-field">
            <%= point_form.label :latitude, class: "admin-label" %>
            <%= point_form.number_field :latitude, step: :any, required: true, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= point_form.label :longitude, class: "admin-label" %>
            <%= point_form.number_field :longitude, step: :any, required: true, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= point_form.label :order, class: "admin-label" %>
            <%= point_form.number_field :order, required: true, class: "admin-input" %>
          </div>
        </div>

        <div class="admin-actions">
          <%= point_form.submit "Add Point", class: "admin-button admin-button--small" %>
        </div>
      <% end %>

      <% if @route.points.any? %>
        <div class="admin-table-wrap admin-table-wrap--spaced">
          <table class="admin-table">
            <thead>
              <tr>
                <th scope="col">Order</th>
                <th scope="col">Latitude</th>
                <th scope="col">Longitude</th>
                <th scope="col">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @route.points.order(:order).each do |point| %>
                <tr>
                  <td><%= point.order %></td>
                  <td><%= point.latitude %></td>
                  <td><%= point.longitude %></td>
                  <td>
                    <%= button_to "Delete", admin_route_point_path(@route, point),
                        method: :delete,
                        class: "admin-link admin-link--danger",
                        form: { data: { turbo_confirm: "Are you sure you want to delete this point?" } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="admin-empty">No points defined for this route.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Route drivers</h2>
        <p class="admin-panel-description">Manage the drivers assigned to this route.</p>
      </div>
    </div>

    <div class="admin-panel-body admin-stack">
      <%= form_with(url: add_driver_admin_route_path(@route), method: :post, class: "admin-form") do |driver_form| %>
        <div class="admin-field">
          <label for="driver_id" class="admin-label">Add driver</label>
          <div class="admin-toolbar">
            <div class="admin-toolbar-field">
              <%= driver_form.select :driver_id,
                  options_from_collection_for_select(Driver.all - @route.drivers, :id, :name),
                  { include_blank: "Select a driver" },
                  class: "admin-select" %>
            </div>
            <%= driver_form.submit "Add Driver", class: "admin-button admin-button--small" %>
          </div>
        </div>
      <% end %>

      <% if @route.drivers.any? %>
        <dl class="admin-detail-list">
          <% @route.drivers.each do |driver| %>
            <div class="admin-detail">
              <dt class="admin-detail-label"><%= driver.name %></dt>
              <dd class="admin-detail-value">
                <div class="admin-toolbar">
                  <span><%= driver.mobile %></span>
                  <%= button_to "Remove",
                      remove_driver_admin_route_path(@route, driver_id: driver.id),
                      method: :delete,
                      class: "admin-link admin-link--danger",
                      data: { turbo_confirm: "Are you sure you want to remove this driver from the route?" } %>
                </div>
              </dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <p class="admin-empty">No drivers assigned to this route.</p>
      <% end %>
    </div>
  </section>
</div>
