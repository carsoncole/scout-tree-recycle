<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Route information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Name the route and assign it to a zone.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with(model: [:admin, @route], class: "admin-form") do |f| %>
        <%= render "shared/form_errors", object: @route %>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :name, class: admin_input_class %>
          </div>

          <div class="admin-field">
            <%= f.label :zone_id, "Zone", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.collection_select :zone_id, Zone.ordered, :id, :name,
                { include_blank: "Select a zone" },
                class: admin_select_class %>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
          <%= link_to "Cancel", admin_routes_path, class: admin_button_class(variant: :secondary) %>
          <%= f.submit class: admin_button_class %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Route points</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Define the polygon points that make up this route's area.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with(model: [:admin, @route, Point.new], url: admin_route_points_path(@route), class: "admin-form") do |point_form| %>
        <div class="admin-field-grid admin-field-grid--three">
          <div class="admin-field">
            <%= point_form.label :latitude, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= point_form.number_field :latitude, step: :any, required: true, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= point_form.label :longitude, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= point_form.number_field :longitude, step: :any, required: true, class: admin_input_class %>
          </div>
          <div class="admin-field">
            <%= point_form.label :order, class: "admin-label text-ink dark:text-ink-dark" %>
            <%= point_form.number_field :order, required: true, class: admin_input_class %>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
          <%= point_form.submit "Add Point", class: admin_button_class(size: :small) %>
        </div>
      <% end %>

      <% if @route.points.any? %>
        <div class="admin-table-wrap admin-table-wrap--spaced">
          <table class="admin-table text-ink dark:text-ink-dark">
            <thead>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <th scope="col" class="<%= admin_th_class %>">Order</th>
                <th scope="col" class="<%= admin_th_class %>">Latitude</th>
                <th scope="col" class="<%= admin_th_class %>">Longitude</th>
                <th scope="col" class="<%= admin_th_class %>">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @route.points.order(:order).each do |point| %>
                <% point_form_id = "edit_point_#{point.id}" %>
                <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                  <td class="<%= admin_td_class %>">
                    <%= number_field_tag "point[order]", point.order,
                        id: "point_#{point.id}_order",
                        form: point_form_id,
                        required: true,
                        class: admin_input_class %>
                  </td>
                  <td class="<%= admin_td_class %>">
                    <%= number_field_tag "point[latitude]", point.latitude,
                        id: "point_#{point.id}_latitude",
                        step: :any,
                        form: point_form_id,
                        required: true,
                        class: admin_input_class %>
                  </td>
                  <td class="<%= admin_td_class %>">
                    <%= number_field_tag "point[longitude]", point.longitude,
                        id: "point_#{point.id}_longitude",
                        step: :any,
                        form: point_form_id,
                        required: true,
                        class: admin_input_class %>
                  </td>
                  <td class="<%= admin_td_class %>">
                    <div class="flex flex-wrap items-center gap-2">
                      <%= form_with(model: [:admin, @route, point], id: point_form_id) do |pf| %>
                        <%= pf.submit "Update", class: admin_button_class(size: :small) %>
                      <% end %>
                      <%= button_to "Delete", admin_route_point_path(@route, point),
                          method: :delete,
                          class: admin_link_class(variant: :danger),
                          form: { data: { turbo_confirm: "Are you sure you want to delete this point?" } } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <%= render "admin/shared/empty_state", message: "No points defined for this route." %>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Route drivers</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Manage the drivers assigned to this route.</p>
      </div>
    </div>

    <div class="admin-panel-body flex flex-col gap-6">
      <%= form_with(url: add_driver_admin_route_path(@route), method: :post, class: "admin-form") do |driver_form| %>
        <div class="admin-field">
          <label for="driver_id" class="admin-label text-ink dark:text-ink-dark">Add driver</label>
          <div class="admin-toolbar">
            <div class="admin-toolbar-field">
              <%= driver_form.select :driver_id,
                  options_from_collection_for_select(Driver.all - @route.drivers, :id, :name),
                  { include_blank: "Select a driver" },
                  class: admin_select_class %>
            </div>
            <%= driver_form.submit "Add Driver", class: admin_button_class(size: :small) %>
          </div>
        </div>
      <% end %>

      <% if @route.drivers.any? %>
        <dl class="admin-detail-list">
          <% @route.drivers.each do |driver| %>
            <div class="admin-detail border-line dark:border-line-dark">
              <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark"><%= driver.name %></dt>
              <dd class="admin-detail-value text-ink dark:text-ink-dark">
                <div class="admin-toolbar">
                  <span><%= driver.mobile %></span>
                  <%= button_to "Remove",
                      remove_driver_admin_route_path(@route, driver_id: driver.id),
                      method: :delete,
                      class: admin_link_class(variant: :danger),
                      data: { turbo_confirm: "Are you sure you want to remove this driver from the route?" } %>
                </div>
              </dd>
            </div>
          <% end %>
        </dl>
      <% else %>
        <%= render "admin/shared/empty_state", message: "No drivers assigned to this route." %>
      <% end %>
    </div>
  </section>
</div>
