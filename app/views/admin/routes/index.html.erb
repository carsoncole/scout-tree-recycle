<%= render "admin/shared/page_header",
           title: "Routes",
           description: "Manage pickup routes, zones, and driver assignments." do %>
  <%= link_to "Drivers", admin_drivers_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "Zones", admin_zones_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= link_to "New Route", new_admin_route_path, class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Name</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Zone</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Reservations</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Assigned drivers</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @routes.each do |route| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= link_to route.name, admin_route_path(route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <% if route.zone %>
                    <%= link_to route.zone.name, admin_zone_path(route.zone), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                  <% else %>
                    Unzoned
                  <% end %>
                </td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route.reservations.count %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <% if route.drivers.any? %>
                    <div class="admin-table-actions">
                      <% route.drivers.each do |driver| %>
                        <span class="admin-badge admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark"><%= driver.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No drivers assigned</span>
                  <% end %>
                </td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <div class="admin-table-actions">
                    <%= link_to "View", admin_route_path(route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                    <%= link_to "Edit", edit_admin_route_path(route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                    <%= button_to "Delete", admin_route_path(route),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this route? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: "admin-link admin-link--danger text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark" %>
                  </div>
                </td>
              </tr>
            <% end %>

            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">Unassigned</td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">—</td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= Reservation.where(route_id: nil).count %></td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No route</span></td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                <div class="admin-table-actions">
                  <%= link_to "View", admin_reservations_path(route_id: nil), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <%= render "admin/shared/pagination", pagy: @pagy %>
    </section>
  </div>
</div>
