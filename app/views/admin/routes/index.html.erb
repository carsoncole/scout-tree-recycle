<%= content_for :title, "Routes" %>
<%= render "admin/shared/page_header",
           title: "Routes",
           description: "Manage pickup routes, zones, and driver assignments." do %>
  <%= link_to "Drivers", admin_drivers_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "Zones", admin_zones_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "New Route", new_admin_route_path, class: admin_button_class %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Name</th>
              <th scope="col" class="<%= admin_th_class %>">Zone</th>
              <th scope="col" class="<%= admin_th_class %>">Reservations</th>
              <th scope="col" class="<%= admin_th_class %>">Assigned drivers</th>
              <th scope="col" class="<%= admin_th_class %>">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @routes.each do |route| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= link_to route.name, admin_route_path(route), class: admin_link_class %></td>
                <td class="<%= admin_td_class %>">
                  <% if route.zone %>
                    <%= link_to route.zone.name, admin_zone_path(route.zone), class: admin_link_class %>
                  <% else %>
                    Unzoned
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>"><%= route.reservations.count %></td>
                <td class="<%= admin_td_class %>">
                  <% if route.drivers.any? %>
                    <div class="admin-table-actions">
                      <% route.drivers.each do |driver| %>
                        <span class="<%= admin_badge_class(:neutral) %>"><%= driver.name %></span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No drivers assigned</span>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <div class="admin-table-actions">
                    <%= link_to "View", admin_route_path(route), class: admin_link_class %>
                    <%= link_to "Edit", edit_admin_route_path(route), class: admin_link_class %>
                    <%= button_to "Delete", admin_route_path(route),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this route? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: admin_link_class(variant: :danger) %>
                  </div>
                </td>
              </tr>
            <% end %>

            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="<%= admin_td_class %>">Unassigned</td>
              <td class="<%= admin_td_class %>">—</td>
              <td class="<%= admin_td_class %>"><%= Reservation.where(route_id: nil).count %></td>
              <td class="<%= admin_td_class %>"><span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No route</span></td>
              <td class="<%= admin_td_class %>">
                <div class="admin-table-actions">
                  <%= link_to "View", admin_reservations_path(route_id: nil), class: admin_link_class %>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <%= render "admin/shared/pagination", pagy: @pagy %>
    </section>
  </div>
</div>
