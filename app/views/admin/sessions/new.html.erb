<div class="admin-container--small admin-container--flush">
  <div class="admin-login-header">
    <h1 class="admin-page-title text-ink dark:text-ink-dark">Sign in to your account</h1>
    <p class="mt-[0.45rem] mb-0 max-w-[44rem] text-[0.96rem] leading-[1.55] text-ink-soft dark:text-ink-soft-dark">Enter your admin credentials to continue.</p>
  </div>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-body">
      <%= form_with url: admin_session_url, class: "admin-form" do |form| %>
        <div class="admin-field">
          <%= form.label :email, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "Enter your email address",
              value: params[:email],
              class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
        </div>

        <div class="admin-field">
          <%= form.label :password, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.password_field :password,
              required: true,
              autocomplete: "current-password",
              placeholder: "Enter your password",
              maxlength: 72,
              class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
        </div>

        <div>
          <%= link_to "Forgot your password?", new_password_path, class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
        </div>

        <%= form.submit "Sign in", id: "sign-in-button", class: "admin-button admin-button--full bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      <% end %>
    </div>
  </section>
</div>
