<div class="admin-container--small admin-container--flush">
  <div class="admin-login-header">
    <h1 class="admin-page-title">Sign in to your account</h1>
    <p class="admin-page-description">Enter your admin credentials to continue.</p>
  </div>

  <section class="admin-panel">
    <div class="admin-panel-body">
      <%= form_with url: admin_session_url, class: "admin-form" do |form| %>
        <div class="admin-field">
          <%= form.label :email, class: "admin-label" %>
          <%= form.email_field :email,
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "Enter your email address",
              value: params[:email],
              class: "admin-input" %>
        </div>

        <div class="admin-field">
          <%= form.label :password, class: "admin-label" %>
          <%= form.password_field :password,
              required: true,
              autocomplete: "current-password",
              placeholder: "Enter your password",
              maxlength: 72,
              class: "admin-input" %>
        </div>

        <div>
          <%= link_to "Forgot your password?", new_password_path, class: "admin-link" %>
        </div>

        <%= form.submit "Sign in", id: "sign-in-button", class: "admin-button admin-button--full" %>
      <% end %>
    </div>
  </section>
</div>
