<details class="mt-2">
  <summary class="cursor-pointer select-none text-sm font-medium text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark">Markdown supported</summary>
  <dl class="mt-2 space-y-1 rounded-md border border-line bg-stone p-3 text-sm dark:border-line-dark dark:bg-stone-dark">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="font-mono text-ink dark:text-ink-dark">**bold text**</dt>
      <dd class="text-ink-soft dark:text-ink-soft-dark">Bold text</dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="font-mono text-ink dark:text-ink-dark">*italic text*</dt>
      <dd class="text-ink-soft dark:text-ink-soft-dark">Italic text</dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="font-mono text-ink dark:text-ink-dark">- item</dt>
      <dd class="text-ink-soft dark:text-ink-soft-dark">Bullet list, one item per line</dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="font-mono text-ink dark:text-ink-dark">[link text](https://example.com)</dt>
      <dd class="text-ink-soft dark:text-ink-soft-dark">Link (http/https only)</dd>
    </div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <dt class="font-mono text-ink dark:text-ink-dark">Blank line</dt>
      <dd class="text-ink-soft dark:text-ink-soft-dark">Separates paragraphs</dd>
    </div>
  </dl>
</details>
