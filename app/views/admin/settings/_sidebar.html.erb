<nav class="admin-settings-nav border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" aria-label="Settings sections">
  <ul class="admin-settings-nav-list">
    <li>
      <%= link_to "Overview", admin_settings_path,
          class: admin_settings_nav_class("overview"),
          aria: { current: ("page" if admin_settings_active_key == "overview") } %>
    </li>
    <% admin_settings_nav_items.each do |item| %>
      <li>
        <%= link_to item[:label], item[:path],
            class: admin_settings_nav_class(item[:key]),
            aria: { current: ("page" if admin_settings_active_key == item[:key]) } %>
      </li>
    <% end %>
  </ul>
</nav>
