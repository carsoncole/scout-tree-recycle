<%= render "admin/shared/page_header",
           title: "Settings",
           description: "Manage event details, feature toggles, and portal access." %>

<% missing_settings = setting.missing_required_settings %>
<section class="admin-panel admin-settings-status" id="configuration-status">
  <div class="admin-panel-header">
    <div>
      <h2 class="admin-panel-title">Configuration status</h2>
      <p class="admin-panel-description">Required settings needed for the application to run correctly.</p>
    </div>
    <span class="admin-badge <%= missing_settings.empty? ? "admin-badge--positive" : "admin-badge--warning" %>">
      <%= missing_settings.empty? ? "Ready" : "#{missing_settings.size} missing" %>
    </span>
  </div>

  <div class="admin-panel-body">
    <% if missing_settings.empty? %>
      <p class="admin-hint">All required settings are configured.</p>
    <% else %>
      <div class="admin-notice admin-notice--warning" role="status">
        <div>
          <p class="admin-notice-title">Missing required settings</p>
          <ul class="admin-setup-missing-list">
            <% missing_settings.each do |item| %>
              <li><%= link_to item[:label], "##{item[:section]}", class: "admin-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>
</section>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="admin-stack">
    <section class="admin-panel" id="event-settings" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">The Event</h2>
          <p class="admin-panel-description">Public copy, pickup windows, reservation availability, and contact information.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section">
            <h3 class="admin-section-title">Reservations</h3>
            <p class="admin-section-description">Allow customers to make tree pickup reservations. Changes save immediately.</p>

            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable Reservations</h3>
                  <p class="admin-hint">Allow customers to make tree pickup reservations.</p>
                  <%= link_to "View Reservations Site", root_path, target: "_blank", rel: "noopener", class: "admin-link" %>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="reservations-toggle" aria-label="Enable reservations">
                    <%= check_box_tag "setting[is_reservations_open]", "1", setting.is_reservations_open,
                        class: "admin-switch-input",
                        data: {
                          testid: "reservations-toggle",
                          toggle_target: "toggle",
                          setting: "is_reservations_open"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="admin-field admin-field--spaced">
              <%= label_tag "setting[reservations_closed_message]", "Reservations Closed Message", class: "admin-label" %>
              <%= text_area_tag "setting[reservations_closed_message]", setting.reservations_closed_message, rows: 3, class: "admin-textarea", placeholder: Setting::DEFAULT_RESERVATIONS_CLOSED_MESSAGE %>
              <p class="admin-hint">Displayed on the public home page in place of the reservation form when Enable Reservations is off. Leave blank to use the default message.</p>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Event Details</h3>
            <p class="admin-section-description">Pickup window, sign-up deadline, and default address values.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[event_pickup_start]", "Event Pickup Date/Time", class: "admin-label" %>
                <%= datetime_field_tag "setting[event_pickup_start]", setting.event_pickup_start&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[event_pickup_end]", "Event Pickup End Date/Time", class: "admin-label" %>
                <%= datetime_field_tag "setting[event_pickup_end]", setting.event_pickup_end&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[event_sign_up_deadline]", "Sign Up Deadline", class: "admin-label" %>
                <%= datetime_field_tag "setting[event_sign_up_deadline]", setting.event_sign_up_deadline&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[suggested_donation]", "Suggested Donation", class: "admin-label" %>
                <%= number_field_tag "setting[suggested_donation]", setting.suggested_donation, class: "admin-input", min: 0, step: 1, placeholder: Setting::DEFAULT_SUGGESTED_DONATION %>
                <p class="admin-hint">Leave blank to use the default of <%= Setting::DEFAULT_SUGGESTED_DONATION %>.</p>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[default_city]", "Default City", class: "admin-label" %>
                <%= text_field_tag "setting[default_city]", setting.default_city, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[default_state]", "Default State", class: "admin-label" %>
                <%= text_field_tag "setting[default_state]", setting.default_state, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Event Contacts</h3>
            <p class="admin-section-description">All fields are optional. Any information provided here will be displayed on the public site so customers can reach the event organizers.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[contact_name]", "Contact Name", class: "admin-label" %>
                <%= text_field_tag "setting[contact_name]", setting.contact_name, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[contact_email]", "Contact Email", class: "admin-label" %>
                <%= email_field_tag "setting[contact_email]", setting.contact_email, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[contact_phone]", "Contact Phone", class: "admin-label" %>
                <%= telephone_field_tag "setting[contact_phone]", setting.contact_phone, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[contact_sms]", "Contact SMS", class: "admin-label" %>
                <%= telephone_field_tag "setting[contact_sms]", setting.contact_sms, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="organization">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Organization</h2>
          <p class="admin-panel-description">Organization name and website.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[organization_name]", "Organization Name", class: "admin-label" %>
                <%= text_field_tag "setting[organization_name]", setting.organization_name, class: "admin-input" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[organization_url]", "Organization URL", class: "admin-label" %>
                <%= url_field_tag "setting[organization_url]", setting.organization_url, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Organization Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="site-details">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Site Details</h2>
          <p class="admin-panel-description">Site address, time zone, and default country used throughout the app.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[site_url]", "Site URL", class: "admin-label" %>
                <%= url_field_tag "setting[site_url]", setting.site_url, class: "admin-input", placeholder: "https://example.com" %>
                <p class="admin-hint">Used for links in emails, such as password resets and unsubscribe links.</p>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[time_zone]", "Time Zone", class: "admin-label" %>
                <%= select_tag "setting[time_zone]", options_for_select(Setting::AVAILABLE_TIME_ZONES, setting.time_zone), class: "admin-select" %>
                <p class="admin-hint">All event and message times are shown in this time zone.</p>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[default_country]", "Default Country", class: "admin-label" %>
                <%= text_field_tag "setting[default_country]", setting.default_country, class: "admin-input", placeholder: "United States" %>
                <p class="admin-hint">Used as the default country for new reservations.</p>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[phone_default_country]", "Default Phone Country", class: "admin-label" %>
                <%= text_field_tag "setting[phone_default_country]", setting.phone_default_country, class: "admin-input", maxlength: 2, placeholder: "US" %>
                <p class="admin-hint">Two-letter ISO country code used to parse phone numbers.</p>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Site Details", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>


    <section class="admin-panel" id="site-content">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Site Content</h2>
          <p class="admin-panel-description">Headline, home page image, and supporting copy shown on the public site.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toolbar">
              <div>
                <%= label_tag "setting[home_page_header]", "Header/Tab Title", class: "admin-section-title" %>
                <p class="admin-section-description">The title shown in the browser tab and site header.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= text_field_tag "setting[home_page_header]", setting.home_page_header, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Home page image</h3>
            <p class="admin-section-description">Choose the image shown at the top of the public home page. It is displayed at a fixed size.</p>

            <div class="admin-field admin-field--spaced">
              <%= label_tag "setting[home_page_image]", "Home Page Image", class: "admin-label" %>
              <%= select_tag "setting[home_page_image]",
                  options_for_select(MarketingEmailTemplate.available_images, setting.home_page_image_name),
                  class: "admin-select" %>
              <p class="admin-hint">Images come from app/assets/images. <%= link_to "View available images", admin_marketing_images_path, class: "admin-link" %>.</p>
            </div>

            <div class="admin-image-preview admin-image-preview--settings">
              <%= image_tag setting.home_page_image_name, alt: "Home page image preview" %>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Page copy</h3>
            <p class="admin-section-description">Supporting copy shown on the public site.</p>

            <div class="admin-field admin-field--spaced">
              <%= label_tag "setting[about_event_description]", "About", class: "admin-label" %>
              <%= text_area_tag "setting[about_event_description]", setting.about_event_description, rows: 3, class: "admin-textarea", placeholder: Setting::DEFAULT_ABOUT_EVENT_DESCRIPTION %>
              <p class="admin-hint">Leave blank to use the default description.</p>
            </div>

            <div class="admin-field admin-field--spaced">
              <%= label_tag "setting[on_day_of_pickup_instructions]", "On Day of Pickup Instructions", class: "admin-label" %>
              <%= text_area_tag "setting[on_day_of_pickup_instructions]", setting.on_day_of_pickup_instructions, rows: 3, class: "admin-textarea", placeholder: Setting::DEFAULT_PICKUP_INSTRUCTIONS %>
              <p class="admin-hint">Leave blank to use the default instructions.</p>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Site Content", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="tree-pickups" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Pickups Portal</h2>
          <p class="admin-panel-description">Enable the driver portal and manage driver access.</p>
        </div>
        <%= link_to "Manage Drivers", admin_drivers_path, class: "admin-button admin-button--secondary admin-button--small" %>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable Pickups Portal</h3>
                  <p class="admin-hint">Make the driver portal available at <code>/pickups</code>.</p>
                  <%= link_to "View Pickups Portal", pickups_root_path, target: "_blank", rel: "noopener", class: "admin-link" %>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="pickups-toggle" aria-label="Enable pickups portal">
                    <%= check_box_tag "setting[is_pickups_site_enabled]", "1", setting.is_pickups_site_enabled,
                        class: "admin-switch-input",
                        data: {
                          testid: "pickups-toggle",
                          toggle_target: "toggle",
                          setting: "is_pickups_site_enabled"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <div class="admin-toolbar">
              <div>
                <%= label_tag "setting[driver_secret_key]", "Password", class: "admin-section-title" %>
                <p class="admin-section-description">The password drivers use to open their pickup lists.</p>
                <p class="admin-hint">Drivers enter this password at <code>/pickups</code> to open their pickup lists.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= text_field_tag "setting[driver_secret_key]", setting.driver_secret_key, class: "admin-input" %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Portal Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="sms" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">SMS</h2>
          <p class="admin-panel-description">Send and receive text messages through Twilio.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable SMS</h3>
                  <p class="admin-hint">Send SMS messages, including missing tree notifications.</p>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="sms-toggle" aria-label="Enable SMS">
                    <%= check_box_tag "setting[is_sms_enabled]", "1", setting.is_sms_enabled,
                        class: "admin-switch-input",
                        data: {
                          testid: "sms-toggle",
                          toggle_target: "toggle",
                          setting: "is_sms_enabled"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Twilio credentials</h3>
            <p class="admin-section-description">Find these values in your Twilio console. They are stored in the application database.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[twilio_account_sid]", "Account SID", class: "admin-label" %>
                <%= text_field_tag "setting[twilio_account_sid]", setting.twilio_account_sid, class: "admin-input", autocomplete: "off" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[twilio_auth_token]", "Auth Token", class: "admin-label" %>
                <%= password_field_tag "setting[twilio_auth_token]", setting.twilio_auth_token, class: "admin-input", autocomplete: "new-password" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[twilio_from_number]", "From Number", class: "admin-label" %>
                <%= telephone_field_tag "setting[twilio_from_number]", setting.twilio_from_number, class: "admin-input", placeholder: "+15555550123" %>
                <p class="admin-hint">The Twilio phone number messages are sent from, in E.164 format.</p>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <div class="admin-toolbar">
              <div>
                <%= label_tag "setting[sms_quick_responses]", "Quick Responses", class: "admin-section-title" %>
                <p class="admin-section-description">One response per line. These appear as buttons when replying to a conversation.</p>
              </div>

              <div class="admin-field admin-field--medium admin-toolbar-field">
                <%= text_area_tag "setting[sms_quick_responses]", setting.sms_quick_responses, rows: 5, class: "admin-textarea" %>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Missing Tree Messages</h3>
            <p class="admin-section-description">Sent automatically when a reservation is marked missing. Leave a message blank to use the default shown in the field.</p>

            <div class="admin-toolbar admin-field--spaced">
              <div>
                <%= label_tag "setting[missing_tree_sms_message]", "First Message", class: "admin-label" %>
                <p class="admin-hint">Sent the first time a tree is marked missing.</p>
              </div>

              <div class="admin-field admin-field--medium admin-toolbar-field">
                <%= text_area_tag "setting[missing_tree_sms_message]", setting.missing_tree_sms_message, rows: 4, class: "admin-textarea", placeholder: Reservation::DEFAULT_MISSING_TREE_SMS %>
                <p class="admin-hint">Leave blank to use the default message.</p>
              </div>
            </div>

            <div class="admin-toolbar admin-field--spaced">
              <div>
                <%= label_tag "setting[missing_tree_sms_follow_up_message]", "Follow-up Message", class: "admin-label" %>
                <p class="admin-hint">Sent if the tree is marked missing again.</p>
              </div>

              <div class="admin-field admin-field--medium admin-toolbar-field">
                <%= text_area_tag "setting[missing_tree_sms_follow_up_message]", setting.missing_tree_sms_follow_up_message, rows: 4, class: "admin-textarea", placeholder: Reservation::DEFAULT_MISSING_TREE_SMS_FOLLOW_UP %>
                <p class="admin-hint">Leave blank to use the default message.</p>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <div class="admin-toolbar">
              <div>
                <%= label_tag :sms_webhook_url, "Webhook URL", class: "admin-section-title" %>
                <p class="admin-section-description">Set this URL as the messaging webhook for your Twilio phone number so replies arrive in the app.</p>
              </div>

              <div class="admin-field admin-field--medium admin-toolbar-field">
                <%= text_field_tag :sms_webhook_url, api_v1_sms_reply_url, class: "admin-input", readonly: true %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save SMS Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="email" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Email</h2>
          <p class="admin-panel-description">Send notifications and marketing messages through SMTP.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable Email</h3>
                  <p class="admin-hint">Send email notifications and marketing messages.</p>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="emailing-toggle" aria-label="Enable email">
                    <%= check_box_tag "setting[is_emailing_enabled]", "1", setting.is_emailing_enabled,
                        class: "admin-switch-input",
                        data: {
                          testid: "emailing-toggle",
                          toggle_target: "toggle",
                          setting: "is_emailing_enabled"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <div class="admin-toolbar">
              <div>
                <%= label_tag "setting[email_from_address]", "From Address", class: "admin-section-title" %>
                <p class="admin-section-description">The address recipients see in the From field.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= text_field_tag "setting[email_from_address]", setting.email_from_address, class: "admin-input", placeholder: "Anytown Tree Recycle <example@example.com>" %>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">SMTP server</h3>
            <p class="admin-section-description">Outgoing mail server details, stored in the application database.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[smtp_address]", "SMTP Address", class: "admin-label" %>
                <%= text_field_tag "setting[smtp_address]", setting.smtp_address, class: "admin-input", placeholder: "smtp.gmail.com" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[smtp_port]", "Port", class: "admin-label" %>
                <%= number_field_tag "setting[smtp_port]", setting.smtp_port, class: "admin-input", min: 1, step: 1, placeholder: "587" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[smtp_user_name]", "Username", class: "admin-label" %>
                <%= text_field_tag "setting[smtp_user_name]", setting.smtp_user_name, class: "admin-input", autocomplete: "off" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[smtp_password]", "Password", class: "admin-label" %>
                <%= password_field_tag "setting[smtp_password]", setting.smtp_password, class: "admin-input", autocomplete: "new-password" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[smtp_authentication]", "Authentication", class: "admin-label" %>
                <%= select_tag "setting[smtp_authentication]",
                    options_for_select([ [ "Plain", "plain" ], [ "Login", "login" ], [ "CRAM-MD5", "cram_md5" ] ], setting.smtp_authentication),
                    class: "admin-select" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[smtp_encryption]", "Encryption", class: "admin-label" %>
                <%= select_tag "setting[smtp_encryption]",
                    options_for_select([ [ "STARTTLS (recommended)", "starttls" ], [ "TLS", "tls" ], [ "None", "none" ] ], setting.smtp_encryption),
                    class: "admin-select" %>
                <p class="admin-hint">Most providers, including Gmail, use STARTTLS on port 587.</p>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Marketing</h3>
            <p class="admin-section-description">Controls batch size and how soon the second marketing email can follow the first for the same person.</p>

            <div class="admin-toolbar admin-field--spaced">
              <div>
                <%= label_tag "setting[email_batch_quantity]", "Email Batch Quantity", class: "admin-label" %>
                <p class="admin-hint">Number of emails to send in each batch.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= number_field_tag "setting[email_batch_quantity]", setting.email_batch_quantity, class: "admin-input", min: 1, step: 1 %>
              </div>
            </div>

            <div class="admin-toolbar admin-field--spaced">
              <div>
                <%= label_tag "setting[marketing_email_cooldown_days]", "Days Between Marketing Emails", class: "admin-label" %>
                <p class="admin-hint">Set to 0 to allow both emails immediately.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= number_field_tag "setting[marketing_email_cooldown_days]", setting.marketing_email_cooldown_days, class: "admin-input", min: 0, step: 1 %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Email Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="donations" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Donations</h2>
          <p class="admin-panel-description">Accept online donations through Stripe.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable Online Donations</h3>
                  <p class="admin-hint">Accept donations through Stripe. When disabled, customers see information about other donation methods.</p>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="donations-toggle" aria-label="Enable online donations">
                    <%= check_box_tag "setting[is_donations_enabled]", "1", setting.is_donations_enabled,
                        class: "admin-switch-input",
                        data: {
                          testid: "donations-toggle",
                          toggle_target: "toggle",
                          setting: "is_donations_enabled"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">Stripe credentials</h3>
            <p class="admin-section-description">Find these values in your Stripe dashboard. They are stored in the application database.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[stripe_secret_key]", "Secret Key", class: "admin-label" %>
                <%= password_field_tag "setting[stripe_secret_key]", setting.stripe_secret_key, class: "admin-input", autocomplete: "new-password" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[stripe_price_id]", "Price ID", class: "admin-label" %>
                <%= text_field_tag "setting[stripe_price_id]", setting.stripe_price_id, class: "admin-input", placeholder: "price_..." %>
                <p class="admin-hint">The Stripe price used for the donation checkout.</p>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <div class="admin-toolbar">
              <div>
                <%= label_tag :stripe_webhook_url, "Webhook URL", class: "admin-section-title" %>
                <p class="admin-section-description">Set this URL as the webhook endpoint in Stripe so completed donations are recorded.</p>
              </div>

              <div class="admin-field admin-field--medium admin-toolbar-field">
                <%= text_field_tag :stripe_webhook_url, api_v1_stripe_webhook_url, class: "admin-input", readonly: true %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Donations Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="location-services" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Location Services</h2>
          <p class="admin-panel-description">Geocode reservation and route addresses with Amazon Location Service.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toggle-list">
              <div class="admin-toggle-row" data-toggle-row>
                <div class="admin-toggle-copy" data-toggle-copy>
                  <h3 class="admin-toggle-title">Enable Automatic Routing</h3>
                  <p class="admin-hint">When disabled, pickups must be routed manually.</p>
                </div>
                <div class="admin-toggle-control" data-toggle-control>
                  <label class="admin-switch" id="routing-toggle" aria-label="Enable automatic routing">
                    <%= check_box_tag "setting[is_routing_enabled]", "1", setting.is_routing_enabled,
                        class: "admin-switch-input",
                        data: {
                          testid: "routing-toggle",
                          toggle_target: "toggle",
                          setting: "is_routing_enabled"
                        } %>
                    <span class="admin-switch-track" aria-hidden="true"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="admin-form-section">
            <h3 class="admin-section-title">AWS credentials</h3>
            <p class="admin-section-description">Find these values in your AWS account. They are stored in the application database. If Location Services is not configured, reservations will need to be manually assigned to routes.</p>

            <div class="admin-field-grid admin-field-grid--two">
              <div class="admin-field">
                <%= label_tag "setting[aws_access_key_id]", "Access Key ID", class: "admin-label" %>
                <%= text_field_tag "setting[aws_access_key_id]", setting.aws_access_key_id, class: "admin-input", autocomplete: "off" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[aws_secret_access_key]", "Secret Access Key", class: "admin-label" %>
                <%= password_field_tag "setting[aws_secret_access_key]", setting.aws_secret_access_key, class: "admin-input", autocomplete: "new-password" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[aws_region]", "Region", class: "admin-label" %>
                <%= text_field_tag "setting[aws_region]", setting.aws_region, class: "admin-input", placeholder: "us-west-2" %>
              </div>
              <div class="admin-field">
                <%= label_tag "setting[aws_location_index_name]", "Place Index Name", class: "admin-label" %>
                <%= text_field_tag "setting[aws_location_index_name]", setting.aws_location_index_name, class: "admin-input", placeholder: "tree_recycle" %>
                <p class="admin-hint">The Amazon Location Service place index used for address lookups.</p>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Location Services Settings", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="operations">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Operations</h2>
          <p class="admin-panel-description">Retention and end-of-season data cleanup.</p>
        </div>
      </div>

      <div class="admin-panel-body">
        <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
          <div class="admin-form-section admin-form-section--flush">
            <div class="admin-toolbar">
              <div>
                <%= label_tag "setting[contact_retention_months]", "Retention (Months)", class: "admin-section-title" %>
                <p class="admin-section-description">How long past participants remain available for marketing. Contacts older than this are removed during cleanup.</p>
              </div>

              <div class="admin-field admin-field--short admin-toolbar-field">
                <%= number_field_tag "setting[contact_retention_months]", setting.contact_retention_months, class: "admin-input", min: 1, step: 1 %>
              </div>
            </div>
          </div>

          <div class="admin-actions">
            <%= submit_tag "Save Operations Settings", class: "admin-button" %>
          </div>
        <% end %>

        <div class="admin-form-section admin-form-section--spaced">
          <div class="admin-toolbar">
            <div>
              <h3 class="admin-toggle-title">Migrate Reservations</h3>
              <p class="admin-hint">Move reservations to contacts for next season's marketing.</p>
            </div>
            <%= button_to admin_post_event_cleanup_path,
                class: "admin-button admin-button--danger",
                data: {
                  turbo_confirm: "Are you sure you want to migrate reservations? This will move all reservations to contacts which will be used for marketing. This action cannot be undone. ",
                  turbo_method: :post
                } do %>
              Migrate
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <section class="admin-panel" id="system" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">System</h2>
          <p class="admin-panel-description">Review system errors and application events.</p>
        </div>
        <%= link_to admin_logs_path, class: "admin-button admin-button--secondary admin-button--small" do %>
          System Logs
          <% if @unviewed_logs_count.to_i.positive? %>
            <span class="admin-nav-badge"><%= @unviewed_logs_count %></span>
          <% end %>
        <% end %>
      </div>
      <div class="admin-panel-body">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title">Send error messages to admins</h3>
              <p class="admin-hint">Admins will receive email notifications when system errors are logged.</p>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="log-notifications-toggle" aria-label="Send error messages to admins">
                <%= check_box_tag "setting[is_log_notifications_enabled]", "1", setting.is_log_notifications_enabled,
                    class: "admin-switch-input",
                    disabled: !setting.is_emailing_enabled?,
                    data: {
                      testid: "log-notifications-toggle",
                      toggle_target: "toggle",
                      setting: "is_log_notifications_enabled"
                    } %>
                <span class="admin-switch-track" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
        <% unless setting.is_emailing_enabled? %>
          <p class="admin-hint">Enable and configure Email to send error notifications to admins.</p>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="data">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Data</h2>
          <p class="admin-panel-description">Import and export reservation data as CSV.</p>
        </div>
        <%= link_to "Manage Data", admin_data_path, class: "admin-button admin-button--secondary admin-button--small" %>
      </div>
    </section>

    <section class="admin-panel" id="jobs">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">Jobs</h2>
          <p class="admin-panel-description">Monitor background jobs, queues, and failures.</p>
        </div>
        <%= link_to "View Jobs Dashboard", "/admin/jobs", class: "admin-button admin-button--secondary" %>
      </div>
    </section>

    <section class="admin-panel" id="user-management">
      <div class="admin-panel-header">
        <div>
          <h2 class="admin-panel-title">User Management</h2>
          <p class="admin-panel-description">Manage system users and their permissions.</p>
        </div>
        <%= link_to "Manage Users", admin_users_path, class: "admin-button admin-button--secondary" %>
      </div>
    </section>
  </div>
</div>
