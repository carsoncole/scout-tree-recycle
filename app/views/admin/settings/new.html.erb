<%= content_for :title, "Initial Application Setup" %>
<%= render "admin/shared/page_header",
           eyebrow: "First run",
           title: "Initial Application Setup",
           description: "Create your administrator account to get started. The only thing required at this time is the administrator account details." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="admin-container--medium admin-container--flush">
    <%= form_with url: admin_settings_path, method: :post, model: @setting, local: true, class: "flex flex-col gap-6" do |f| %>
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-body">
        <div class="admin-form">
          <div class="admin-field" id="organization_name_section">
            <%= f.label :organization_name, "Organization Name (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :organization_name,
                class: admin_input_class(error: @setting&.errors[:organization_name].any?) %>
            <% if @setting&.errors[:organization_name].any? %>
              <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:organization_name].first %></p>
            <% end %>
          </div>

          <div class="admin-field">
            <%= f.label :site_url, "Site URL (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.url_field :site_url, class: admin_input_class, placeholder: "https://example.com" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Used for links in emails, such as password resets.</p>
          </div>

          <div class="admin-field-grid admin-field-grid--two">
            <div class="admin-field" id="default_city_section">
              <%= f.label :default_city, "Default City (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= f.text_field :default_city,
                  class: admin_input_class(error: @setting&.errors[:default_city].any?) %>
              <% if @setting&.errors[:default_city].any? %>
                <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:default_city].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="default_state_section">
              <%= f.label :default_state, "Default State (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= f.select :default_state, options_for_select(us_states), { include_blank: true },
                  class: admin_select_class(error: @setting&.errors[:default_state].any?) %>
              <% if @setting&.errors[:default_state].any? %>
                <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:default_state].first %></p>
              <% end %>
            </div>
          </div>

          <div class="admin-field-grid admin-field-grid--three">
            <div class="admin-field" id="event_pickup_start_section">
              <%= f.label :event_pickup_start, "Event Pickup Start (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= f.datetime_field :event_pickup_start,
                  class: admin_input_class(error: @setting&.errors[:event_pickup_start].any?) %>
              <% if @setting&.errors[:event_pickup_start].any? %>
                <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:event_pickup_start].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="event_pickup_end_section">
              <%= f.label :event_pickup_end, "Event Pickup End (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= f.datetime_field :event_pickup_end,
                  class: admin_input_class(error: @setting&.errors[:event_pickup_end].any?) %>
              <% if @setting&.errors[:event_pickup_end].any? %>
                <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:event_pickup_end].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="sign_up_deadline_section">
              <%= f.label :event_sign_up_deadline, "Sign Up Deadline (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= f.datetime_field :event_sign_up_deadline,
                  class: admin_input_class(error: @setting&.errors[:event_sign_up_deadline].any?) %>
              <% if @setting&.errors[:event_sign_up_deadline].any? %>
                <p class="admin-error-text text-danger dark:text-danger-dark"><%= @setting.errors[:event_sign_up_deadline].first %></p>
              <% end %>
            </div>
          </div>

          <% unless User.exists?(role: "admin") %>
            <div class="admin-divider"></div>
            <div class="flex flex-col gap-6">
              <div>
                <h2 class="admin-section-title text-ink dark:text-ink-dark">Administrator account</h2>
                <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Create the initial admin user to sign in and manage the application. Email and password are required.</p>
              </div>

              <%= fields_for :admin_user, @admin_user || User.new do |af| %>
                <div class="admin-field" id="admin_email_section">
                  <%= af.label :email, "Admin Email (required)", class: "admin-label text-ink dark:text-ink-dark" %>
                  <%= af.email_field :email, autocomplete: "username", required: true,
                      class: admin_input_class(error: @admin_user&.errors[:email].any?) %>
                  <% if @admin_user&.errors[:email].any? %>
                    <p class="admin-error-text text-danger dark:text-danger-dark"><%= @admin_user.errors[:email].first %></p>
                  <% end %>
                </div>

                <div class="admin-field-grid admin-field-grid--two">
                  <div class="admin-field" id="admin_password_section">
                    <%= af.label :password, "Admin Password (required)", class: "admin-label text-ink dark:text-ink-dark" %>
                    <%= af.password_field :password, autocomplete: "new-password", required: true,
                        class: admin_input_class(error: @admin_user&.errors[:password].any?) %>
                    <% if @admin_user&.errors[:password].any? %>
                      <p class="admin-error-text text-danger dark:text-danger-dark"><%= @admin_user.errors[:password].first %></p>
                    <% end %>
                  </div>

                  <div class="admin-field" id="admin_password_confirmation_section">
                    <%= af.label :password_confirmation, "Confirm Admin Password (required)", class: "admin-label text-ink dark:text-ink-dark" %>
                    <%= af.password_field :password_confirmation, autocomplete: "new-password", required: true,
                        class: admin_input_class(error: @admin_user&.errors[:password_confirmation].any?) %>
                    <% if @admin_user&.errors[:password_confirmation].any? %>
                      <p class="admin-error-text text-danger dark:text-danger-dark"><%= @admin_user.errors[:password_confirmation].first %></p>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="admin-panel-footer border-line dark:border-line-dark">
        <%= f.submit "Save Settings", class: admin_button_class %>
      </div>
    </section>
  <% end %>
</div>
</div>
