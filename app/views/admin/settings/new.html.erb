<div class="admin-container--medium admin-container--flush">
  <div class="admin-page-header">
    <div>
      <p class="admin-eyebrow">First run</p>
      <h1 class="admin-page-title">Initial Application Setup</h1>
      <p class="admin-page-description">Please configure the required settings to continue.</p>
    </div>
  </div>

  <%= form_with url: admin_settings_path, method: :post, model: @setting, local: true, class: "admin-stack" do |f| %>
    <section class="admin-panel">
      <div class="admin-panel-body">
        <div class="admin-form">
          <div class="admin-field" id="organization_name_section">
            <%= f.label :organization_name, "Organization Name", class: "admin-label" %>
            <%= f.text_field :organization_name,
                class: "admin-input #{'admin-input--error' if @setting&.errors[:organization_name].any?}" %>
            <% if @setting&.errors[:organization_name].any? %>
              <p class="admin-error-text"><%= @setting.errors[:organization_name].first %></p>
            <% end %>
          </div>

          <div class="admin-field">
            <%= f.label :site_url, "Site URL", class: "admin-label" %>
            <%= f.url_field :site_url, class: "admin-input", placeholder: "https://example.com" %>
            <p class="admin-hint">Used for links in emails, such as password resets.</p>
          </div>

          <div class="admin-field-grid admin-field-grid--two">
            <div class="admin-field" id="default_city_section">
              <%= f.label :default_city, "Default City", class: "admin-label" %>
              <%= f.text_field :default_city,
                  class: "admin-input #{'admin-input--error' if @setting&.errors[:default_city].any?}" %>
              <% if @setting&.errors[:default_city].any? %>
                <p class="admin-error-text"><%= @setting.errors[:default_city].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="default_state_section">
              <%= f.label :default_state, "Default State", class: "admin-label" %>
              <%= f.select :default_state, options_for_select(us_states), { include_blank: true },
                  class: "admin-select #{'admin-select--error' if @setting&.errors[:default_state].any?}" %>
              <% if @setting&.errors[:default_state].any? %>
                <p class="admin-error-text"><%= @setting.errors[:default_state].first %></p>
              <% end %>
            </div>
          </div>

          <div class="admin-field-grid admin-field-grid--three">
            <div class="admin-field" id="event_pickup_start_section">
              <%= f.label :event_pickup_start, "Event Pickup Start", class: "admin-label" %>
              <%= f.datetime_field :event_pickup_start,
                  class: "admin-input #{'admin-input--error' if @setting&.errors[:event_pickup_start].any?}" %>
              <% if @setting&.errors[:event_pickup_start].any? %>
                <p class="admin-error-text"><%= @setting.errors[:event_pickup_start].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="event_pickup_end_section">
              <%= f.label :event_pickup_end, "Event Pickup End", class: "admin-label" %>
              <%= f.datetime_field :event_pickup_end,
                  class: "admin-input #{'admin-input--error' if @setting&.errors[:event_pickup_end].any?}" %>
              <% if @setting&.errors[:event_pickup_end].any? %>
                <p class="admin-error-text"><%= @setting.errors[:event_pickup_end].first %></p>
              <% end %>
            </div>

            <div class="admin-field" id="sign_up_deadline_section">
              <%= f.label :event_sign_up_deadline, "Sign Up Deadline", class: "admin-label" %>
              <%= f.datetime_field :event_sign_up_deadline,
                  class: "admin-input #{'admin-input--error' if @setting&.errors[:event_sign_up_deadline].any?}" %>
              <% if @setting&.errors[:event_sign_up_deadline].any? %>
                <p class="admin-error-text"><%= @setting.errors[:event_sign_up_deadline].first %></p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-panel-footer">
        <%= f.submit "Save Settings", class: "admin-button" %>
      </div>
    </section>
  <% end %>
</div>
