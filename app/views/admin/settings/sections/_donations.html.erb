<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="donations" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Donations</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Accept online donations through Stripe.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "donations" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Enable Online Donations</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Accept donations through Stripe. When disabled, customers see information about other donation methods.</p>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="donations-toggle" aria-label="Enable online donations">
                <%= check_box_tag "setting[is_donations_enabled]", "1", setting.is_donations_enabled,
                    class: "admin-switch-input peer",
                    data: {
                      testid: "donations-toggle",
                      toggle_target: "toggle",
                      setting: "is_donations_enabled"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Stripe credentials</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Find these values in your Stripe dashboard. They are stored in the application database.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[stripe_secret_key]", "Secret Key", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[stripe_secret_key]", Setting.mask_credential(setting.stripe_secret_key), class: admin_input_class, autocomplete: "off" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[stripe_price_id]", "Price ID", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[stripe_price_id]", setting.stripe_price_id, class: admin_input_class, placeholder: "price_..." %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The Stripe price used for the donation checkout.</p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag :stripe_webhook_url, "Webhook URL", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Set this URL as the webhook endpoint in Stripe so completed donations are recorded.</p>
          </div>

          <div class="admin-field admin-toolbar-field">
            <%= text_area_tag :stripe_webhook_url, api_v1_stripe_webhook_url(**setting.site_url_options), rows: 2, class: "admin-code-input #{admin_textarea_class}", readonly: true %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Donations Settings", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>
