<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="event-settings" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">The Event</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Public copy, pickup windows, reservation availability, and contact information.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "event" %>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Reservations</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Allow customers to make tree pickup reservations. Changes save immediately.</p>

        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Enable Reservations</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Allow customers to make tree pickup reservations.</p>
              <%= link_to "View Reservations Site", root_path, target: "_blank", rel: "noopener", class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="reservations-toggle" aria-label="Enable reservations">
                <%= check_box_tag "setting[is_reservations_open]", "1", setting.is_reservations_open,
                    class: "admin-switch-input peer",
                    data: {
                      testid: "reservations-toggle",
                      toggle_target: "toggle",
                      setting: "is_reservations_open"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[reservations_closed_message]", "Reservations Closed Message", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[reservations_closed_message]", setting.reservations_closed_message, rows: 3, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_RESERVATIONS_CLOSED_MESSAGE %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Displayed on the public home page in place of the reservation form when Enable Reservations is off. Leave blank to use the default message.</p>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Event Details</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Pickup window, sign-up deadline, and default address values.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[event_pickup_start]", "Event Pickup Date/Time", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= datetime_field_tag "setting[event_pickup_start]", setting.event_pickup_start&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[event_pickup_end]", "Event Pickup End Date/Time", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= datetime_field_tag "setting[event_pickup_end]", setting.event_pickup_end&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[event_sign_up_deadline]", "Sign Up Deadline", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= datetime_field_tag "setting[event_sign_up_deadline]", setting.event_sign_up_deadline&.strftime("%Y-%m-%dT%H:%M"), class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[suggested_donation]", "Suggested Donation", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= number_field_tag "setting[suggested_donation]", setting.suggested_donation, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", min: 0, step: 1, placeholder: Setting::DEFAULT_SUGGESTED_DONATION %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default of <%= Setting::DEFAULT_SUGGESTED_DONATION %>.</p>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[default_city]", "Default City", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[default_city]", setting.default_city, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[default_state]", "Default State", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[default_state]", setting.default_state, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Event Contacts</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">All fields are optional. Any information provided here will be displayed on the public site so customers can reach the event organizers.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[contact_name]", "Contact Name", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[contact_name]", setting.contact_name, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[contact_email]", "Contact Email", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= email_field_tag "setting[contact_email]", setting.contact_email, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[contact_phone]", "Contact Phone", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= telephone_field_tag "setting[contact_phone]", setting.contact_phone, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[contact_sms]", "Contact SMS", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= telephone_field_tag "setting[contact_sms]", setting.contact_sms, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Settings", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      </div>
    <% end %>
  </div>
</section>
