<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="location-services" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Location Services</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Geocode reservation and route addresses with Amazon Location Service. Pick the legacy Places v1 access or the Places v2 API key.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "location_services" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">
                Enable Automatic Routing
                <span class="<%= admin_badge_class("info") %> ml-2 align-middle">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  Location
                </span>
              </h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">When disabled, pickups must be routed manually.</p>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="routing-toggle" aria-label="Enable automatic routing">
                <%= check_box_tag "setting[is_routing_enabled]", "1", setting.is_routing_enabled,
                    class: "admin-switch-input peer",
                    data: {
                      testid: "routing-toggle",
                      toggle_target: "toggle",
                      setting: "is_routing_enabled"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Provider</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Places v2 is the default. Only the selected provider is used. Switching changes future geocoding and address verification only; existing addresses are not re-geocoded.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[location_provider]", "Provider", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= select_tag "setting[location_provider]",
                options_for_select([
                  [ "Legacy — Places v1 (AWS access key)", "places_v1" ],
                  [ "Places v2 (API key)", "places_v2" ]
                ], setting.location_provider),
                class: admin_select_class %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[aws_region]", "Region", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[aws_region]", setting.aws_region, class: admin_input_class, autocomplete: "off", placeholder: "us-west-2" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Used by both providers.</p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Legacy — Places v1</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Uses an AWS access key and a place index. This is the default until you switch providers.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[aws_access_key_id]", "Access Key ID", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[aws_access_key_id]", setting.aws_access_key_id, class: admin_input_class, autocomplete: "off" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[aws_secret_access_key]", "Secret Access Key", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= password_field_tag "setting[aws_secret_access_key]", setting.aws_secret_access_key, class: admin_input_class, autocomplete: "new-password" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[aws_location_index_name]", "Place Index Name", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[aws_location_index_name]", setting.aws_location_index_name, class: admin_input_class, autocomplete: "off", placeholder: "tree_recycle" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The Amazon Location Service place index used by the legacy provider.</p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">
          Places v2 — API key
          <% if setting.aws_location_api_key.present? %>
            <span class="<%= admin_badge_class("positive") %> ml-2 align-middle">Configured</span>
          <% end %>
        </h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Create an API key in the Amazon Location console and restrict it to <span class="font-medium">geo-places:Geocode</span>. Address verification runs when automatic routing is enabled and a reservation is submitted. The saved key is shown masked; enter a new key to replace it.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[aws_location_api_key]", "API Key", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= password_field_tag "setting[aws_location_api_key]", setting.aws_location_api_key,
                class: admin_input_class,
                autocomplete: "new-password",
                placeholder: "v1.public..." %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Location Services Settings", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>
