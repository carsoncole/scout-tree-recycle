<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="operations">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Operations</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Close the current event and prepare contacts for the next one.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <div class="admin-toolbar">
      <div>
        <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Close Event</h3>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Copy this event's reservations into contacts, delete every reservation, and reset marketing so the next event can begin. How long contacts are kept is set on that page.</p>
      </div>
      <% if Current.user&.admin? %>
        <%= link_to "Close Event", admin_close_event_path, class: admin_button_class(variant: :danger) %>
      <% else %>
        <span class="<%= admin_badge_class("neutral") %>">Admin only</span>
      <% end %>
    </div>
    <% unless Current.user&.admin? %>
      <p class="admin-hint mt-2 text-ink-soft dark:text-ink-soft-dark">Only admins can close the event or change how long contacts are kept.</p>
      <%= link_to "View close event", admin_close_event_path, class: "#{admin_link_class} mt-2 inline-block" %>
    <% end %>
  </div>
</section>
