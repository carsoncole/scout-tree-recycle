<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="operations">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Operations</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Retention and end-of-season data cleanup.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "operations" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag "setting[contact_retention_months]", "Retention (Months)", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">How long past participants remain available for marketing. Contacts older than this are removed during cleanup.</p>
          </div>

          <div class="admin-field admin-field--short admin-toolbar-field">
            <%= number_field_tag "setting[contact_retention_months]", setting.contact_retention_months, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", min: 1, step: 1 %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Operations Settings", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      </div>
    <% end %>

    <div class="admin-form-section admin-form-section--spaced border-line dark:border-line-dark">
      <div class="admin-toolbar">
        <div>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Migrate Reservations</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Move reservations to contacts for next season's marketing.</p>
        </div>
        <%= button_to admin_post_event_cleanup_path,
            class: "admin-button admin-button--danger bg-danger text-surface hover:bg-[#743730] dark:bg-danger-dark dark:text-page-dark dark:hover:bg-danger-border-dark",
            data: {
              turbo_confirm: "Are you sure you want to migrate reservations? This will move all reservations to contacts which will be used for marketing. This action cannot be undone. ",
              turbo_method: :post
            } do %>
          Migrate
        <% end %>
      </div>
    </div>
  </div>
</section>
