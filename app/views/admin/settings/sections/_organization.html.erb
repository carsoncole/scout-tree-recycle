<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="organization">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Organization</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Organization name and website.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "organization" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[organization_name]", "Organization Name", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[organization_name]", setting.organization_name, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[organization_url]", "Organization URL", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= url_field_tag "setting[organization_url]", setting.organization_url, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Organization Settings", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      </div>
    <% end %>
  </div>
</section>
