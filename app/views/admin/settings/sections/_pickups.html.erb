<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="tree-pickups" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Pickups Portal</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Enable the driver portal and manage driver access.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "pickups" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Enable Pickups Portal</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Make the driver portal available at <code>/pickups</code>.</p>
              <%= link_to "View Pickups Portal", pickups_root_path, target: "_blank", rel: "noopener", class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="pickups-toggle" aria-label="Enable pickups portal">
                <%= check_box_tag "setting[is_pickups_site_enabled]", "1", setting.is_pickups_site_enabled,
                    class: "admin-switch-input peer",
                    data: {
                      testid: "pickups-toggle",
                      toggle_target: "toggle",
                      setting: "is_pickups_site_enabled"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Drivers <%= render "admin/settings/count_badge", count: @drivers_count, label: "drivers" %></h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Manage drivers and access to pickup lists.</p>
          </div>
          <%= link_to "View drivers", admin_drivers_path, class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
        </div>

        <div class="admin-toolbar admin-field--spaced">
          <div>
            <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Zones <%= render "admin/settings/count_badge", count: @zones_count, label: "zones" %></h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Manage geographic zones for pickup routes.</p>
          </div>
          <%= link_to "View zones", admin_zones_path, class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
        </div>

        <div class="admin-toolbar admin-field--spaced">
          <div>
            <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Routes <%= render "admin/settings/count_badge", count: @routes_count, label: "routes" %></h3>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Manage pickup routes and assignments.</p>
          </div>
          <%= link_to "View routes", admin_routes_path, class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag "setting[driver_secret_key]", "Password", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">The password drivers use to open their pickup lists.</p>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Drivers enter this password at <code>/pickups</code> to open their pickup lists.</p>
          </div>

          <div class="admin-field admin-field--short admin-toolbar-field">
            <%= text_field_tag "setting[driver_secret_key]", setting.driver_secret_key, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Portal Settings", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      </div>
    <% end %>
  </div>
</section>
