<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="site-content">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Site Content</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Headline, home page image, and supporting copy shown on the public site.</p>
    </div>
    <%= link_to "Manage Thanks", admin_thanks_path, class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "site_content" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag "setting[home_page_header]", "Header/Tab Title", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">The title shown in the browser tab and site header.</p>
          </div>

          <div class="admin-field admin-field--short admin-toolbar-field">
            <%= text_field_tag "setting[home_page_header]", setting.home_page_header, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Home page image</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Choose the image shown at the top of the public home page. It is displayed at a fixed size.</p>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[home_page_image]", "Home Page Image", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= select_tag "setting[home_page_image]",
              options_for_select(MarketingEmailTemplate.available_images, setting.home_page_image_name),
              class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Images come from app/assets/images. <%= link_to "View available images", admin_marketing_images_path, class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>.</p>
        </div>

        <div class="admin-image-preview admin-image-preview--settings border-line bg-stone dark:border-line-dark dark:bg-stone-dark">
          <%= image_tag setting.home_page_image_name, alt: "Home page image preview" %>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Page copy</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Supporting copy shown on the public site.</p>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[about_event_description]", "About", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[about_event_description]", setting.about_event_description, rows: 3, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_ABOUT_EVENT_DESCRIPTION %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default description.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[on_day_of_pickup_instructions]", "On Day of Pickup Instructions", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[on_day_of_pickup_instructions]", setting.on_day_of_pickup_instructions, rows: 3, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_PICKUP_INSTRUCTIONS %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default instructions.</p>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Donations page</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Copy shown on the public donations pages.</p>
        <%= render "admin/settings/markdown_help" %>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_page_content]", "Initial Content", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_page_content]", setting.donations_page_content, rows: 3, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_DONATIONS_PAGE_CONTENT %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_page_how_to_donate]", "How to Donate", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_page_how_to_donate]", setting.donations_page_how_to_donate, rows: 4, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_DONATIONS_PAGE_HOW_TO_DONATE %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown under the How to Donate heading. Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_new_page_content]", "New Donations Page Content", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_new_page_content]", setting.donations_new_page_content, rows: 8, class: "admin-textarea border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", placeholder: Setting::DEFAULT_DONATIONS_NEW_PAGE_CONTENT %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Site Content", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      </div>
    <% end %>
  </div>
</section>
