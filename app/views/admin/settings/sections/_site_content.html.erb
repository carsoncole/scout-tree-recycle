<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="site-content">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Site Content</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Headline, home page image, and supporting copy shown on the public site.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "site_content" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag "setting[home_page_header]", "Header/Tab Title", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">The title shown in the browser tab and site header.</p>
          </div>

          <div class="admin-field admin-field--short admin-toolbar-field">
            <%= text_field_tag "setting[home_page_header]", setting.home_page_header, class: admin_input_class %>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="admin-section-title text-ink dark:text-ink-dark">Make a Reservation</h3>
          <%= link_to root_path,
              target: "_blank",
              rel: "noopener",
              title: "Open the Make a Reservation page (opens in a new tab)",
              class: "inline-flex items-center gap-1.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:focus-visible:outline-ink-dark #{admin_link_class}" do %>
            View page
            <%= external_link_icon(css_class: "size-3.5 shrink-0") %>
          <% end %>
        </div>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">The public home page, where neighbors reserve their tree pickup. The image below appears at the top of the page.</p>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[home_page_image]", "Home Page Image", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= select_tag "setting[home_page_image]",
              options_for_select(MarketingEmailTemplate.available_images, setting.home_page_image_name),
              class: admin_select_class %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Images come from app/assets/images. <%= link_to "View available images", admin_marketing_images_path, class: admin_link_class %>.</p>
        </div>

        <div class="admin-image-preview admin-image-preview--settings border-line bg-stone dark:border-line-dark dark:bg-stone-dark">
          <%= image_tag setting.home_page_image_name, alt: "Home page image preview" %>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="admin-section-title text-ink dark:text-ink-dark">About</h3>
          <%= link_to about_path,
              target: "_blank",
              rel: "noopener",
              title: "Open the About page (opens in a new tab)",
              class: "inline-flex items-center gap-1.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:focus-visible:outline-ink-dark #{admin_link_class}" do %>
            View page
            <%= external_link_icon(css_class: "size-3.5 shrink-0") %>
          <% end %>
        </div>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Copy shown on the public About page.</p>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[about_event_description]", "Description", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[about_event_description]", setting.about_event_description, rows: 3, class: admin_textarea_class, placeholder: Setting::DEFAULT_ABOUT_EVENT_DESCRIPTION %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The lede at the top of the About page. Leave blank to use the default description.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[on_day_of_pickup_instructions]", "On Day of Pickup Instructions", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[on_day_of_pickup_instructions]", setting.on_day_of_pickup_instructions, rows: 3, class: admin_textarea_class, placeholder: Setting::DEFAULT_PICKUP_INSTRUCTIONS %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown on the About page under On day of pickup. Leave blank to use the default instructions.</p>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Donations</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Copy shown on the donation pages of the reservation flow — after a neighbor reserves their tree, before pickup is confirmed.</p>
        <%= render "admin/settings/markdown_help" %>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_page_content]", "Initial Content", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_page_content]", setting.donations_page_content, rows: 3, class: admin_textarea_class, placeholder: Setting::DEFAULT_DONATIONS_PAGE_CONTENT %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown at the top of the Donations page when online giving is unavailable. Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_page_how_to_donate]", "How to Donate", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_page_how_to_donate]", setting.donations_page_how_to_donate, rows: 4, class: admin_textarea_class, placeholder: Setting::DEFAULT_DONATIONS_PAGE_HOW_TO_DONATE %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown under the How to Donate heading. Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_new_page_content]", "New Donations Page Content", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_new_page_content]", setting.donations_new_page_content, rows: 8, class: admin_textarea_class, placeholder: Setting::DEFAULT_DONATIONS_NEW_PAGE_CONTENT %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown on the page where neighbors choose a donation option after reserving. Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>

        <div class="admin-field admin-field--spaced">
          <%= label_tag "setting[donations_success_page_content]", "Donation Success Content", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_area_tag "setting[donations_success_page_content]", setting.donations_success_page_content, rows: 3, class: admin_textarea_class, placeholder: Setting::DEFAULT_DONATIONS_SUCCESS_PAGE_CONTENT %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Shown on the donation thank-you page after giving online. Leave blank to use the default content. Supports basic markdown — see Markdown supported above.</p>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <h3 class="admin-section-title text-ink dark:text-ink-dark">Thank You</h3>
          <%= link_to thanks_path,
              target: "_blank",
              rel: "noopener",
              title: "Open the Thank You page (opens in a new tab)",
              class: "inline-flex items-center gap-1.5 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:focus-visible:outline-ink-dark #{admin_link_class}" do %>
            View page
            <%= external_link_icon(css_class: "size-3.5 shrink-0") %>
          <% end %>
        </div>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Supporter cards and the thank-you message shown on the public Thank You page.</p>

        <div class="admin-field--spaced flex flex-wrap items-center gap-3">
          <%= link_to "Add thank", new_admin_thank_path, class: admin_button_class %>
          <%= link_to "Manage Thanks", admin_thanks_path, class: admin_button_class(variant: :secondary) %>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Site Content", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="email-logo">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Default Email Logo</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Logo shown at the top of system emails such as account setup, error notifications, and data exports. Marketing and reservation emails use their own logos.</p>
    </div>
  </div>
  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "site_content" %>

      <div class="admin-field admin-field--spaced">
        <%= label_tag "setting[mailer_logo]", "Logo Image", class: "admin-label text-ink dark:text-ink-dark" %>
        <%= select_tag "setting[mailer_logo]",
            options_for_select(MarketingEmailTemplate.available_images, setting.mailer_logo_name),
            class: admin_select_class %>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Images come from app/assets/images. <%= link_to "View available images", admin_marketing_images_path, class: admin_link_class %>.</p>
      </div>

      <div class="admin-image-preview admin-image-preview--settings border-line bg-stone dark:border-line-dark dark:bg-stone-dark">
        <%= image_tag setting.mailer_logo_name, alt: "Default email logo preview" %>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Email Logo", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>
