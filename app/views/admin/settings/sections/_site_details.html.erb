<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="site-details">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Site Details</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Site address, time zone, and default country used throughout the app.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "site_details" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[site_url]", "Site URL", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= url_field_tag "setting[site_url]", setting.site_url, class: admin_input_class, placeholder: "https://example.com" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Used for links in emails, such as password resets and unsubscribe links.</p>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[time_zone]", "Time Zone", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= select_tag "setting[time_zone]", options_for_select(Setting::AVAILABLE_TIME_ZONES, setting.time_zone), class: admin_select_class %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">All event and message times are shown in this time zone.</p>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[default_country]", "Default Country", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[default_country]", setting.default_country, class: admin_input_class, placeholder: "United States" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Used as the default country for new reservations.</p>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[phone_default_country]", "Default Phone Country", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[phone_default_country]", setting.phone_default_country, class: admin_input_class, maxlength: 2, placeholder: "US" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Two-letter ISO country code used to parse phone numbers.</p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Site Details", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>
