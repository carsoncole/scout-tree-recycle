<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="sms" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">SMS</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Send and receive text messages through Twilio.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "sms" %>

      <div class="admin-form-section admin-form-section--flush border-line dark:border-line-dark">
        <div class="admin-toggle-list">
          <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
            <div class="admin-toggle-copy" data-toggle-copy>
              <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Enable SMS</h3>
              <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Send SMS messages, including missing tree notifications.</p>
            </div>
            <div class="admin-toggle-control" data-toggle-control>
              <label class="admin-switch" id="sms-toggle" aria-label="Enable SMS">
                <%= check_box_tag "setting[is_sms_enabled]", "1", setting.is_sms_enabled,
                    class: "admin-switch-input peer",
                    data: {
                      testid: "sms-toggle",
                      toggle_target: "toggle",
                      setting: "is_sms_enabled"
                    } %>
                <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Twilio credentials</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Find these values in your Twilio console. They are stored in the application database.</p>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= label_tag "setting[twilio_account_sid]", "Account SID", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= text_field_tag "setting[twilio_account_sid]", setting.twilio_account_sid, class: admin_input_class, autocomplete: "off" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[twilio_auth_token]", "Auth Token", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= password_field_tag "setting[twilio_auth_token]", setting.twilio_auth_token, class: admin_input_class, autocomplete: "new-password" %>
          </div>
          <div class="admin-field">
            <%= label_tag "setting[twilio_from_number]", "From Number", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= telephone_field_tag "setting[twilio_from_number]", setting.twilio_from_number, class: admin_input_class, placeholder: "+15555550123" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The Twilio phone number messages are sent from, in E.164 format.</p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag "setting[sms_quick_responses]", "Quick Responses", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">One response per line. These appear as buttons when replying to a conversation.</p>
          </div>

          <div class="admin-field admin-field--medium admin-toolbar-field">
            <%= text_area_tag "setting[sms_quick_responses]", setting.sms_quick_responses, rows: 5, class: admin_textarea_class %>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <h3 class="admin-section-title text-ink dark:text-ink-dark">Missing Tree Messages</h3>
        <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Sent automatically when a reservation is marked missing. Leave a message blank to use the default shown in the field.</p>

        <div class="admin-toolbar admin-field--spaced">
          <div>
            <%= label_tag "setting[missing_tree_sms_message]", "First Message", class: "admin-label text-ink dark:text-ink-dark" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Sent the first time a tree is marked missing.</p>
          </div>

          <div class="admin-field admin-field--medium admin-toolbar-field">
            <%= text_area_tag "setting[missing_tree_sms_message]", setting.missing_tree_sms_message, rows: 4, class: admin_textarea_class, placeholder: Reservation::DEFAULT_MISSING_TREE_SMS %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default message.</p>
          </div>
        </div>

        <div class="admin-toolbar admin-field--spaced">
          <div>
            <%= label_tag "setting[missing_tree_sms_follow_up_message]", "Follow-up Message", class: "admin-label text-ink dark:text-ink-dark" %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Sent if the tree is marked missing again.</p>
          </div>

          <div class="admin-field admin-field--medium admin-toolbar-field">
            <%= text_area_tag "setting[missing_tree_sms_follow_up_message]", setting.missing_tree_sms_follow_up_message, rows: 4, class: admin_textarea_class, placeholder: Reservation::DEFAULT_MISSING_TREE_SMS_FOLLOW_UP %>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave blank to use the default message.</p>
          </div>
        </div>
      </div>

      <div class="admin-form-section border-line dark:border-line-dark">
        <div class="admin-toolbar">
          <div>
            <%= label_tag :sms_webhook_url, "Webhook URL", class: "admin-section-title text-ink dark:text-ink-dark" %>
            <p class="admin-section-description text-ink-soft dark:text-ink-soft-dark">Set this URL as the messaging webhook for your Twilio phone number so replies arrive in the app.</p>
          </div>

          <div class="admin-field admin-toolbar-field">
            <%= text_area_tag :sms_webhook_url, api_v1_sms_reply_url(**setting.site_url_options), rows: 2, class: "admin-code-input #{admin_textarea_class}", readonly: true %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save SMS Settings", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>
