<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="system" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">System</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Take the public site down for maintenance, show the pickup notice, and review system errors.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to "Close Event", admin_close_event_path, class: admin_button_class(variant: :secondary, size: :small) %>
      <%= link_to admin_logs_path, class: admin_button_class(variant: :secondary, size: :small) do %>
        System Logs
        <% if @unviewed_logs_count.to_i.positive? %>
          <span class="admin-nav-badge bg-ink text-surface dark:bg-ink-dark dark:text-page-dark"><%= @unviewed_logs_count %></span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="admin-panel-body">
    <div class="admin-toggle-list">
      <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
        <div class="admin-toggle-copy" data-toggle-copy>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">
            Down for maintenance
            <span class="<%= admin_badge_class("info") %> ml-2 align-middle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a15.3 15.3 0 0 1 4 9 15.3 15.3 0 0 1-4 9 15.3 15.3 0 0 1-4-9 15.3 15.3 0 0 1 4-9Z" />
              </svg>
              Website
            </span>
          </h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Visitors and drivers see a maintenance page until this is turned off. The admin area stays available.</p>
        </div>
        <div class="admin-toggle-control" data-toggle-control>
          <label class="admin-switch" id="maintenance-mode-toggle" aria-label="Down for maintenance">
            <%= check_box_tag "setting[is_maintenance_mode]", "1", setting.is_maintenance_mode,
                class: "admin-switch-input peer",
                data: {
                  testid: "maintenance-mode-toggle",
                  toggle_target: "toggle",
                  setting: "is_maintenance_mode"
                } %>
            <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
          </label>
        </div>
      </div>
      <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
        <div class="admin-toggle-copy" data-toggle-copy>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">
            Pickup notice
            <span class="<%= admin_badge_class("info") %> ml-2 align-middle">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a15.3 15.3 0 0 1 4 9 15.3 15.3 0 0 1-4 9 15.3 15.3 0 0 1-4-9 15.3 15.3 0 0 1 4-9Z" />
              </svg>
              Website
            </span>
          </h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Replace the home page reservation form with a notice that we are no longer taking reservations and are currently doing pickups. The notice includes whatever contact details are saved on The Event.</p>
        </div>
        <div class="admin-toggle-control" data-toggle-control>
          <label class="admin-switch" id="pickup-notice-toggle" aria-label="Pickup notice">
            <%= check_box_tag "setting[is_pickup_notice_enabled]", "1", setting.is_pickup_notice_enabled,
                class: "admin-switch-input peer",
                data: {
                  testid: "pickup-notice-toggle",
                  toggle_target: "toggle",
                  setting: "is_pickup_notice_enabled"
                } %>
            <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
          </label>
        </div>
      </div>
    </div>
  </div>
</section>
