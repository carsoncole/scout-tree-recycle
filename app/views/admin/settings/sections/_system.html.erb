<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="system" data-controller="toggle" data-toggle-url="<%= toggle_admin_setting_path(setting) %>">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">System</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Take the public site down for maintenance, show the pickup notice, review system errors, and close the current event.</p>
    </div>
    <%= link_to admin_logs_path, class: admin_button_class(variant: :secondary, size: :small) do %>
      System Logs
      <% if @unviewed_logs_count.to_i.positive? %>
        <span class="admin-nav-badge bg-ink text-surface dark:bg-ink-dark dark:text-page-dark"><%= @unviewed_logs_count %></span>
      <% end %>
    <% end %>
  </div>
  <div class="admin-panel-body">
    <div class="admin-toggle-list">
      <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
        <div class="admin-toggle-copy" data-toggle-copy>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Down for maintenance</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Visitors and drivers see a maintenance page until this is turned off. The admin area stays available.</p>
        </div>
        <div class="admin-toggle-control" data-toggle-control>
          <label class="admin-switch" id="maintenance-mode-toggle" aria-label="Down for maintenance">
            <%= check_box_tag "setting[is_maintenance_mode]", "1", setting.is_maintenance_mode,
                class: "admin-switch-input peer",
                data: {
                  testid: "maintenance-mode-toggle",
                  toggle_target: "toggle",
                  setting: "is_maintenance_mode"
                } %>
            <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
          </label>
        </div>
      </div>
      <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
        <div class="admin-toggle-copy" data-toggle-copy>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Pickup notice</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Replace the home page reservation form with a notice that we are no longer taking reservations and are currently doing pickups. The notice includes whatever contact details are saved on The Event.</p>
        </div>
        <div class="admin-toggle-control" data-toggle-control>
          <label class="admin-switch" id="pickup-notice-toggle" aria-label="Pickup notice">
            <%= check_box_tag "setting[is_pickup_notice_enabled]", "1", setting.is_pickup_notice_enabled,
                class: "admin-switch-input peer",
                data: {
                  testid: "pickup-notice-toggle",
                  toggle_target: "toggle",
                  setting: "is_pickup_notice_enabled"
                } %>
            <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
          </label>
        </div>
      </div>
      <div class="admin-toggle-row border-line dark:border-line-dark" data-toggle-row>
        <div class="admin-toggle-copy" data-toggle-copy>
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Send error messages to admins</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Admins will receive email notifications when system errors are logged.</p>
        </div>
        <div class="admin-toggle-control" data-toggle-control>
          <label class="admin-switch" id="log-notifications-toggle" aria-label="Send error messages to admins">
            <%= check_box_tag "setting[is_log_notifications_enabled]", "1", setting.is_log_notifications_enabled,
                class: "admin-switch-input peer",
                data: {
                  testid: "log-notifications-toggle",
                  toggle_target: "toggle",
                  setting: "is_log_notifications_enabled"
                } %>
            <span class="admin-switch-track bg-line-strong after:bg-surface peer-checked:bg-sage peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ink dark:bg-line-strong-dark dark:after:bg-surface-dark dark:peer-checked:bg-sage-dark dark:peer-focus-visible:outline-ink-dark" aria-hidden="true"></span>
          </label>
        </div>
      </div>
    </div>
    <% unless setting.email_configured? %>
      <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Add a from address, SMTP address, and port under Email before these notifications can be sent.</p>
    <% end %>
  </div>
</section>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="email-logo">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Default Email Logo</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Logo shown at the top of system emails such as account setup, error notifications, and data exports. Marketing and reservation emails use their own logos.</p>
    </div>
  </div>
  <div class="admin-panel-body">
    <%= form_tag admin_setting_path(setting), method: :patch, class: "admin-form" do %>
      <%= hidden_field_tag :section, "system" %>

      <div class="admin-field admin-field--spaced">
        <%= label_tag "setting[mailer_logo]", "Logo Image", class: "admin-label text-ink dark:text-ink-dark" %>
        <%= select_tag "setting[mailer_logo]",
            options_for_select(MarketingEmailTemplate.available_images, setting.mailer_logo_name),
            class: admin_select_class %>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Images come from app/assets/images. <%= link_to "View available images", admin_marketing_images_path, class: admin_link_class %>.</p>
      </div>

      <div class="admin-image-preview admin-image-preview--settings border-line bg-stone dark:border-line-dark dark:bg-stone-dark">
        <%= image_tag setting.mailer_logo_name, alt: "Default email logo preview" %>
      </div>

      <div class="flex flex-wrap items-center justify-end gap-3">
        <%= submit_tag "Save Email Logo", class: admin_button_class %>
      </div>
    <% end %>
  </div>
</section>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="close-event">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Close Event</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Copy this event's reservations into contacts, delete every reservation, and reset marketing so the next event can begin.</p>
    </div>
  </div>

  <div class="admin-panel-body">
    <div class="admin-toolbar">
      <div>
        <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Close this event</h3>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">How long contacts are kept is set on the close event page.</p>
      </div>
      <% if Current.user&.admin? %>
        <%= link_to "Close Event", admin_close_event_path, class: "#{admin_button_class(variant: :danger)} ml-auto shrink-0" %>
      <% else %>
        <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
      <% end %>
    </div>
    <% unless Current.user&.admin? %>
      <p class="admin-hint mt-2 text-ink-soft dark:text-ink-soft-dark">Only admins can close the event or change how long contacts are kept.</p>
      <%= link_to "View close event", admin_close_event_path, class: "#{admin_link_class} mt-2 inline-block" %>
    <% end %>
  </div>
</section>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="data-management">
  <div class="admin-panel-header border-line dark:border-line-dark">
    <div>
      <h2 class="admin-panel-title text-ink dark:text-ink-dark">Data Management</h2>
      <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Delete all reservations or contacts, wipe the database back to defaults, or load the example dataset for development and demos.</p>
    </div>
    <% unless Current.user&.admin? %>
      <span class="<%= admin_badge_class("neutral") %>">Admin only</span>
    <% end %>
  </div>
  <div class="admin-panel-body">
    <div class="admin-toggle-list">
      <div class="admin-toggle-row border-line dark:border-line-dark">
        <div class="admin-toggle-copy">
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all reservations</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
            This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@reservations_count.to_i, "reservation") %></strong>.
            Donations are kept but detached from their reservations. Type DELETE to confirm.
          </p>
        </div>
        <% if Current.user&.admin? %>
          <%= render "admin/shared/destructive_details",
              summary_label: "Delete All Reservations",
              url: admin_data_reset_path,
              method: :post,
              word: "DELETE",
              fields: { "data_reset[scope]" => "reservations" },
              submit_label: "Confirm Delete All Reservations",
              confirm: "Delete all reservations? This permanently deletes every reservation and cannot be undone." %>
        <% else %>
          <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
        <% end %>
      </div>
      <div class="admin-toggle-row border-line dark:border-line-dark">
        <div class="admin-toggle-copy">
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Delete all contacts</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
            This permanently deletes <strong class="text-ink dark:text-ink-dark"><%= pluralize(@contacts_count.to_i, "contact") %></strong>.
            Contacts from prior events and imports are removed. Type DELETE to confirm.
          </p>
        </div>
        <% if Current.user&.admin? %>
          <%= render "admin/shared/destructive_details",
              summary_label: "Delete All Contacts",
              url: admin_data_reset_path,
              method: :post,
              word: "DELETE",
              fields: { "data_reset[scope]" => "contacts" },
              submit_label: "Confirm Delete All Contacts",
              confirm: "Delete all contacts? This permanently deletes every contact and cannot be undone." %>
        <% else %>
          <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
        <% end %>
      </div>
      <div class="admin-toggle-row border-line dark:border-line-dark">
        <div class="admin-toggle-copy">
          <h3 class="admin-toggle-title text-ink dark:text-ink-dark">Load sample data</h3>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
            Queues a background job that creates the example Bainbridge Island zones, routes, route points, drivers, reservations, and contacts.
            Intended for local development and demos — it adds records to the current database, and the completed run is recorded in the System Logs.
          </p>
        </div>
        <% if Current.user&.admin? %>
          <%= button_to "Load Sample Data", admin_data_reset_path,
              params: { "data_reset[scope]" => "sample_data" },
              class: admin_button_class(variant: :secondary),
              form: { class: "ml-auto shrink-0" },
              data: { turbo_confirm: "Load sample data? This adds example zones, routes, drivers, reservations, and contacts to the database." } %>
        <% else %>
          <span class="<%= admin_badge_class("neutral") %> ml-auto shrink-0">Admin only</span>
        <% end %>
      </div>
    </div>
  </div>
  <div class="admin-danger-zone border-danger-border bg-danger-bg dark:border-danger-border-dark dark:bg-danger-bg-dark" id="reset-all-data">
    <div class="admin-toggle-row">
      <div class="admin-toggle-copy">
        <span class="<%= admin_badge_class("danger") %>">Danger zone</span>
        <h3 class="admin-toggle-title mt-2 text-ink dark:text-ink-dark">Reset all data to default</h3>
        <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
          This permanently deletes <strong class="text-ink dark:text-ink-dark">every record in every table</strong>,
          including reservations, contacts, donations, routes, users, settings, and the current sign-in sessions.
          You will be signed out and returned to first-run setup, with the default email templates reloaded.
          Sample data is not loaded — run it separately once setup is complete.
        </p>
      </div>
      <% if Current.user&.admin? %>
        <%= render "admin/shared/destructive_details",
            summary_label: "Reset All Data to Default",
            url: admin_data_reset_path,
            method: :post,
            word: "RESET ALL",
            fields: { "data_reset[scope]" => "all" },
            submit_label: "Confirm Reset All Data",
            confirm: "Are you sure? This permanently deletes ALL data, including users and settings. You will be signed out and returned to first-run setup." %>
      <% else %>
        <span class="<%= admin_badge_class("danger") %> ml-auto shrink-0">Admin only</span>
      <% end %>
    </div>
    <% if Current.user&.admin? %>
      <div class="<%= admin_notice_class("danger") %> mt-4" role="alert">
        <div>
          <p><strong>Warning:</strong> This is the most destructive action in the application. There is no undo and no backup. Export anything you need first from the <%= link_to "Data page", admin_data_path, class: admin_link_class %>.</p>
        </div>
      </div>
    <% else %>
      <p class="admin-hint mt-4 text-ink-soft dark:text-ink-soft-dark">Only admins can delete or reset data.</p>
    <% end %>
  </div>
</section>
