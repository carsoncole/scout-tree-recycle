<%# Pagination navigation for admin resources %>
<% query = request.query_parameters.except("page") %>
<% first_page = [ pagy.page - 2, 1 ].max %>
<% last_page = [ first_page + 4, pagy.pages ].min %>
<% first_page = [ last_page - 4, 1 ].max %>

<div class="admin-pagination border-line text-ink-soft dark:border-line-dark dark:text-ink-soft-dark">
  <p>
    Showing <strong><%= pagy.from %></strong> to <strong><%= pagy.to %></strong>
    of <strong><%= pagy.count %></strong> results
  </p>

  <nav class="admin-pagination-pages" aria-label="Pagination">
    <% if pagy.previous %>
      <%= link_to "Previous", url_for(query.merge(page: pagy.previous)),
                  class: admin_pagination_link_class %>
    <% else %>
      <span class="admin-pagination-link is-disabled <%= admin_pagination_link_class %>" aria-hidden="true">Previous</span>
    <% end %>

    <% (first_page..last_page).each do |page| %>
      <%= link_to page, url_for(query.merge(page: page)),
                  class: admin_pagination_link_class(current: page == pagy.page),
                  aria: { current: ("page" if page == pagy.page) } %>
    <% end %>

    <% if pagy.next %>
      <%= link_to "Next", url_for(query.merge(page: pagy.next)),
                  class: admin_pagination_link_class %>
    <% else %>
      <span class="admin-pagination-link is-disabled <%= admin_pagination_link_class %>" aria-hidden="true">Next</span>
    <% end %>
  </nav>
</div>
