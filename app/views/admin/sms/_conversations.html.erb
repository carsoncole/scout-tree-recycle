<div class="admin-conversation-list">
  <% smses_by_phone.each do |phone, smses| %>
    <% unviewed_count = smses.count { |sms| !sms.viewed && sms.incoming? } %>
    <div class="admin-conversation conversation">
      <%= link_to admin_sms_thread_path(phone), class: "admin-conversation-main" do %>
        <% if unviewed_count.positive? %>
          <span class="admin-unread-dot" aria-label="Unread messages"></span>
        <% end %>

        <div class="admin-conversation-body">
          <p class="admin-conversation-title">
            <% if smses.first&.reservations&.any? %>
              <% smses.first.reservations.each do |reservation| %>
                <span class="admin-badge admin-badge--neutral"><%= reservation.name %></span>
                <span class="admin-table-note"><%= reservation.street %></span>
                <span class="<%= admin_reservation_status_badge(reservation.status) %>">
                  <%= reservation.status.titleize %>
                </span>
              <% end %>
            <% else %>
              <%= phone %>
            <% end %>
          </p>
          <p class="admin-conversation-meta">
            <span><%= phone %></span>
            <span class="admin-conversation-time"><%= smses.last.created_at.strftime("%b %d %I:%M %p") %></span>
          </p>
        </div>
      <% end %>

      <div class="admin-conversation-actions">
        <%= link_to "Open", admin_sms_thread_path(phone), class: "admin-button admin-button--secondary admin-button--small" %>
        <%= button_to admin_sms_path(phone: phone),
            method: :delete,
            class: "delete-button admin-button admin-button--danger admin-button--small",
            data: {
              turbo_confirm: "Are you sure you want to delete this entire conversation? This action cannot be undone.",
              turbo_method: :delete
            } do %>
          Delete
        <% end %>
      </div>
    </div>
  <% end %>

  <% if smses_by_phone.empty? %>
    <p class="admin-empty">No SMS conversations yet.</p>
  <% end %>
</div>
