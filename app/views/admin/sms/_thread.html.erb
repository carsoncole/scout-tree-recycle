<% expanded = true if defined?(show_page) && show_page %>
<% expanded ||= false %>

<%= turbo_stream_from "sms_thread_#{phone.gsub(/[^0-9]/, '')}" %>

<turbo-frame id="sms-thread-<%= phone.gsub(/[^0-9]/, '') %>">
  <% unviewed_count = smses.count { |sms| !sms.viewed } %>
  <div class="admin-thread border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" data-controller="sms-thread" data-sms-thread-phone-value="<%= phone %>">
    <div class="admin-thread-header border-line dark:border-line-dark"
         <%= 'data-action="click->sms-thread#toggle"'.html_safe unless expanded %>>
      <div>
        <p class="admin-thread-title text-ink dark:text-ink-dark">
          <%= pluralize(smses.size, "message") %>
          <% if unviewed_count.positive? %>
            <span class="<%= admin_badge_class("info") %>"><%= unviewed_count %> new</span>
          <% end %>
        </p>
      </div>
      <% unless expanded %>
        <span class="<%= admin_button_class(variant: :secondary, size: :small) %>">Open thread</span>
      <% end %>
    </div>

    <div class="admin-thread-body <%= expanded ? '' : 'hidden' %>" data-sms-thread-target="content">
      <% if defined?(error) && error.present? %>
        <div class="<%= admin_notice_class(:danger, spaced: true) %>" role="alert">
          <p><%= error %></p>
        </div>
      <% end %>

      <div class="admin-thread-messages">
        <% smses.each do |sms| %>
          <div class="admin-message admin-message--<%= sms.outgoing? ? "outgoing" : "incoming" %> <%= sms.outgoing? ? 'bg-sage text-surface dark:bg-sage-dark dark:text-page-dark' : 'bg-stone text-ink dark:bg-stone-dark dark:text-ink-dark' %>">
            <% if sms.outgoing? && sms.user %>
              <span class="admin-message-sender"><%= sms.user.email %></span>
            <% end %>
            <p><%= sms.body %></p>
            <span class="admin-message-time">
              <%= sms.created_at.strftime("%b %d, %Y %I:%M %p") %>
              <% if sms.outgoing? && sms.service_status == "failed" %>
                · Failed to send
              <% end %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="admin-thread-reply border-line dark:border-line-dark">
        <div class="admin-quick-replies-header">
          <h4 class="admin-label text-ink dark:text-ink-dark">Quick Responses:</h4>
          <div class="admin-quick-replies admin-quick-replies--spaced">
            <% Setting.instance.sms_quick_response_list.each do |quick_response| %>
              <button type="button"
                      class="canned-response-btn admin-quick-reply border border-line-strong text-ink-soft hover:bg-stone hover:text-ink dark:border-line-strong-dark dark:text-ink-soft-dark dark:hover:bg-stone-dark dark:hover:text-ink-dark"
                      data-message="<%= quick_response %>"
                      data-action="click->sms-thread#insertCannedResponse">
                <%= quick_response %>
              </button>
            <% end %>
          </div>
        </div>

        <%= form_with url: admin_sms_path, scope: :sms, class: "admin-form",
                      data: { turbo_frame: "sms-thread-#{phone.gsub(/[^0-9]/, '')}" } do |f| %>
          <%= f.hidden_field :phone, value: phone %>
          <div class="admin-field">
            <%= f.label :body, "Reply", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_area :body, rows: 2, class: admin_textarea_class, placeholder: "Type your reply...", id: "reply-textarea-#{phone.gsub(/[^0-9]/, '')}" %>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-3">
            <%= f.submit "Send Reply", class: admin_button_class %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>
