<% expanded = true if defined?(show_page) && show_page %>
<% expanded ||= false %>
<turbo-frame id="sms-thread-<%= phone.gsub(/[^0-9]/, '') %>">
  <% unviewed_count = smses.count { |sms| !sms.viewed } %>
  <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg" data-controller="sms-thread" data-sms-thread-phone-value="<%= phone %>">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between <%= expanded ? '' : 'cursor-pointer' %>" <%= expanded ? '' : 'data-action="click->sms-thread#toggle"' %>>
        <div>
          <div class="text-lg font-medium text-gray-900 dark:text-white">
            <% if unviewed_count > 0 %>
              <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                <%= unviewed_count %> new
              </span>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            <%= pluralize(smses.size, 'message') %>
          </p>
        </div>
        <div class="flex items-center space-x-2">

          <% unless expanded %>
            <div class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:bg-gray-600">
              <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-4 <%= expanded ? '' : 'hidden' %>" data-sms-thread-target="content">
        <% if defined?(error) && error.present? %>
          <div class="mb-2 text-red-600 dark:text-red-400 text-sm">
            <%= error %>
          </div>
        <% end %>
        <div class="space-y-4">
          <% smses.each do |sms| %>
            <% if sms.outgoing? %>
              <!-- Outgoing message container -->
              <div class="flex w-full justify-end items-center">
                <div class="max-w-[75%] rounded-lg px-4 py-2 bg-blue-600 text-white">
                  <p class="text-sm"><%= sms.body %></p>
                  <p class="text-xs mt-1 text-blue-300 text-right">
                    <%= sms.created_at.strftime("%b %d, %Y %I:%M %p") %>
                  </p>
                </div>
                <% if sms.service_status == 'failed' %>
                  <svg class="h-5 w-5 text-red-500 dark:text-red-400 flex-shrink-0 ml-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" title="Message failed to send">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            <% else %>
              <!-- Incoming message container -->
              <div class="flex w-full justify-start">
                <div class="max-w-[75%] rounded-lg px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white">
                  <p class="text-sm"><%= sms.body %></p>
                  <p class="text-xs mt-1 text-gray-500 dark:text-gray-400 text-right">
                    <%= sms.created_at.strftime("%b %d, %Y %I:%M %p") %>
                  </p>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <!-- Reply Box -->
        <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
          <!-- Canned Responses -->
          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Quick Responses:</h4>
            <div class="flex flex-wrap gap-2">
              <% SMS_QUICK_RESPONSES.each do |quick_response| %>
                <button type="button" 
                        class="canned-response-btn inline-flex items-center px-3 py-1.5 border border-gray-300 shadow-sm text-xs font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:bg-gray-600"
                        data-message="<%= quick_response %>"
                        data-action="click->sms-thread#insertCannedResponse">
                  <%= quick_response %>
                </button>
              <% end %>
            </div>
          </div>

          <%= form_with(model: [:admin, Sms.new], class: "space-y-4", data: { turbo_frame: "sms-thread-#{phone.gsub(/[^0-9]/, '')}" }) do |f| %>
            <%= f.hidden_field :phone, value: phone %>
            <div>
              <%= f.label :body, "Reply", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
              <%= f.text_area :body, rows: 2, class: "mt-1 block p-2 w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm", placeholder: "Type your reply...", id: "reply-textarea-#{phone.gsub(/[^0-9]/, '')}" %>
            </div>

            <div class="flex justify-end">
              <%= f.submit "Send Reply", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</turbo-frame> 