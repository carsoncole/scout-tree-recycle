<% expanded = true if defined?(show_page) && show_page %>
<% expanded ||= false %>

<%= turbo_stream_from "sms_thread_#{phone.gsub(/[^0-9]/, '')}" %>

<turbo-frame id="sms-thread-<%= phone.gsub(/[^0-9]/, '') %>">
  <% unviewed_count = smses.count { |sms| !sms.viewed } %>
  <div class="admin-thread" data-controller="sms-thread" data-sms-thread-phone-value="<%= phone %>">
    <div class="admin-thread-header"
         <%= 'data-action="click->sms-thread#toggle"'.html_safe unless expanded %>>
      <div>
        <p class="admin-thread-title">
          <%= pluralize(smses.size, "message") %>
          <% if unviewed_count.positive? %>
            <span class="admin-badge admin-badge--info"><%= unviewed_count %> new</span>
          <% end %>
        </p>
      </div>
      <% unless expanded %>
        <span class="admin-button admin-button--secondary admin-button--small">Open thread</span>
      <% end %>
    </div>

    <div class="admin-thread-body <%= expanded ? '' : 'hidden' %>" data-sms-thread-target="content">
      <% if defined?(error) && error.present? %>
        <div class="admin-notice admin-notice--danger admin-notice--spaced" role="alert">
          <p><%= error %></p>
        </div>
      <% end %>

      <div class="admin-thread-messages">
        <% smses.each do |sms| %>
          <div class="admin-message admin-message--<%= sms.outgoing? ? "outgoing" : "incoming" %>">
            <% if sms.outgoing? && sms.user %>
              <span class="admin-message-sender"><%= sms.user.email %></span>
            <% end %>
            <p><%= sms.body %></p>
            <span class="admin-message-time">
              <%= sms.created_at.strftime("%b %d, %Y %I:%M %p") %>
              <% if sms.outgoing? && sms.service_status == "failed" %>
                · Failed to send
              <% end %>
            </span>
          </div>
        <% end %>
      </div>

      <div class="admin-thread-reply">
        <div class="admin-quick-replies-header">
          <h4 class="admin-label">Quick Responses:</h4>
          <div class="admin-quick-replies admin-quick-replies--spaced">
            <% Setting.instance.sms_quick_response_list.each do |quick_response| %>
              <button type="button"
                      class="canned-response-btn admin-quick-reply"
                      data-message="<%= quick_response %>"
                      data-action="click->sms-thread#insertCannedResponse">
                <%= quick_response %>
              </button>
            <% end %>
          </div>
        </div>

        <%= form_with url: admin_sms_path, scope: :sms, class: "admin-form",
                      data: { turbo_frame: "sms-thread-#{phone.gsub(/[^0-9]/, '')}" } do |f| %>
          <%= f.hidden_field :phone, value: phone %>
          <div class="admin-field">
            <%= f.label :body, "Reply", class: "admin-label" %>
            <%= f.text_area :body, rows: 2, class: "admin-textarea", placeholder: "Type your reply...", id: "reply-textarea-#{phone.gsub(/[^0-9]/, '')}" %>
          </div>

          <div class="admin-actions">
            <%= f.submit "Send Reply", class: "admin-button" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</turbo-frame>
