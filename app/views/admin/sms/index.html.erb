<% content_for :title, "SMS Messages" %>
<% content_for :description, "View and manage SMS messages" %>

<%= turbo_stream_from "smses" %>

<%= render "admin/shared/page_header",
           title: "SMS Messages",
           description: "View and reply to customer message threads." %>

<div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">New message</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Start a conversation with a customer.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with url: admin_sms_path, scope: :sms, class: "admin-form", data: { turbo: true } do |f| %>
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :phone, "Phone", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.telephone_field :phone, class: admin_input_class, placeholder: "(555) 555-5555" %>
          </div>
          <div class="admin-field">
            <%= f.label :body, "Message", class: "admin-label text-ink dark:text-ink-dark" %>
            <%= f.text_field :body, class: admin_input_class, placeholder: "Type your message here..." %>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-3">
          <%= button_tag type: "submit", class: admin_button_class do %>
            Send
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <%= render "admin/sms/conversations", smses_by_phone: @smses_by_phone %>
</div>
