<% content_for :title, "SMS Messages" %>
<% content_for :description, "View and manage SMS message history" %>

<div class="w-full bg-gray-50 dark:bg-gray-900 min-h-screen">
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 py-6 sm:px-0">
      <div class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">SMS Messages</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">View and manage SMS message history</p>
      </div>

      <!-- New Message Form -->
      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg mb-8">
        <div class="px-4 py-4 sm:p-4">
          <%= form_with(model: [:admin, Sms.new], class: "flex items-end space-x-4") do |f| %>
            <div class="w-48">
              <%= f.label :phone, class: "block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1" %>
              <%= f.telephone_field :phone, class: "block w-full p-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm", placeholder: "(555) 555-5555" %>
            </div>

            <div class="flex-1">
              <%= f.label :body, class: "block text-xs font-medium text-gray-700 dark:text-gray-300 mb-1" %>
              <%= f.text_field :body, class: "block w-full p-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm", placeholder: "Type your message here..." %>
            </div>

            <div>
              <%= button_tag type: 'submit', class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
                </svg>
                Send
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Message Threads -->
      <div class="space-y-4">
        <% @smses_by_phone.each do |phone, smses| %>
          <% unviewed_count = smses.count { |sms| !sms.viewed } %>
          <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg" data-controller="sms-thread" data-sms-thread-phone-value="<%= phone %>">
            <div class="px-4 py-5 sm:p-6">
              <div class="flex items-center justify-between cursor-pointer" data-action="click->sms-thread#toggle">
                <div>
                  <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                    <%= smses.first.formatted_phone %>
                    <% reservation = smses.first.reservation %>
                    <% if reservation %>
                      <%= link_to smses.first.reservation.name, admin_reservation_path(smses.first.reservation.id) %>
                    <% end %>
                    <% if unviewed_count > 0 %>
                      <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                        <%= unviewed_count %> new
                      </span>
                    <% end %>
                  </h3>
                  <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    <%= pluralize(smses.size, 'message') %>
                  </p>
                </div>
                <div class="flex items-center space-x-2">
                  <%= button_to admin_sms_path(phone: phone), 
                      method: :delete,
                      class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm leading-4 font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 dark:bg-gray-700 dark:border-red-600 dark:text-red-200 dark:hover:bg-red-600",
                      data: { 
                        turbo_confirm: "Are you sure you want to delete this entire thread?",
                        action: "click->sms-thread#stopPropagation"
                      } do %>
                    <svg class="h-5 w-5 mr-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    Delete Thread
                  <% end %>
                  <div class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:hover:bg-gray-600">
                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </div>

              <div class="mt-4 hidden" data-sms-thread-target="content">
                <div class="space-y-4">
                  <% smses.each do |sms| %>
                    <div class="flex <%= sms.outgoing? ? 'justify-end' : 'justify-start' %>">
                      <div class="max-w-[75%] rounded-lg px-4 py-2 <%= sms.outgoing? ? 'bg-blue-600 text-white' : 'bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white' %>">
                        <p class="text-sm"><%= sms.body %></p>
                        <p class="text-xs mt-1 <%= sms.outgoing? ? 'text-blue-100' : 'text-gray-500 dark:text-gray-400' %>">
                          <%= sms.created_at.strftime("%b %d, %Y %I:%M %p") %>
                        </p>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- Reply Box -->
                <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-700">
                  <%= form_with(model: [:admin, Sms.new], class: "space-y-4") do |f| %>
                    <%= f.hidden_field :phone, value: phone %>
                    <div>
                      <%= f.label :body, "Reply", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
                      <%= f.text_area :body, rows: 2, class: "mt-1 block p-2 w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:text-sm", placeholder: "Type your reply..." %>
                    </div>

                    <div class="flex justify-end">
                      <%= f.submit "Send Reply", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
