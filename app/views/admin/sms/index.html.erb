<% content_for :title, "SMS Messages" %>
<% content_for :description, "View and manage SMS messages" %>

<%= turbo_stream_from "smses" %>

<%= render "admin/shared/page_header",
           title: "SMS Messages",
           description: "View and reply to customer message threads." %>

<div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">New message</h2>
        <p class="admin-panel-description">Start a conversation with a customer.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <%= form_with url: admin_sms_path, scope: :sms, class: "admin-form", data: { turbo: true } do |f| %>
        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= f.label :phone, "Phone", class: "admin-label" %>
            <%= f.telephone_field :phone, class: "admin-input", placeholder: "(555) 555-5555" %>
          </div>
          <div class="admin-field">
            <%= f.label :body, "Message", class: "admin-label" %>
            <%= f.text_field :body, class: "admin-input", placeholder: "Type your message here..." %>
          </div>
        </div>

        <div class="admin-actions">
          <%= button_tag type: "submit", class: "admin-button" do %>
            Send
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <section id="sms_conversations">
    <%= render "admin/sms/conversations", smses_by_phone: @smses_by_phone %>
  </section>
</div>
