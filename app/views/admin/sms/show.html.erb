<%= turbo_stream_from "sms_thread_#{@phone.gsub(/[^0-9]/, '')}" %>

<%= render "admin/shared/page_header",
           title: @phone,
           description: "SMS conversation" do %>
  <%= link_to "Back to inbox", admin_sms_path, class: "admin-button admin-button--secondary border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
  <%= button_to admin_sms_path(phone: @phone),
      method: :delete,
      class: "delete-button admin-button admin-button--danger bg-danger text-surface hover:bg-[#743730] dark:bg-danger-dark dark:text-page-dark dark:hover:bg-danger-border-dark",
      data: { turbo_confirm: "Are you sure you want to delete this entire conversation? This action cannot be undone." } do %>
    Delete Conversation
  <% end %>
<% end %>

<% if @reservations&.any? %>
  <div class="flex flex-col gap-4 mb-5">
    <% @reservations.each do |reservation| %>
      <div class="admin-notice border border-line border-l-[3px] border-l-sage bg-sage-soft text-ink dark:border-line-dark dark:border-l-sage-dark dark:bg-sage-soft-dark dark:text-ink-dark">
        <div>
          <p class="admin-notice-title">
            <%= link_to reservation.name.presence || reservation.street, admin_reservation_path(reservation), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
          </p>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">
            <%= reservation.street %> · <%= reservation.status.titleize %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= render partial: "admin/sms/thread", locals: { phone: @phone, smses: @smses, expanded: true, show_page: true } %>
