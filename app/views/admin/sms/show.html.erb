<%= turbo_stream_from "sms_thread_#{@phone.gsub(/[^0-9]/, '')}" %>

<%= render "admin/shared/page_header",
           title: @phone,
           description: "SMS conversation" do %>
  <%= link_to "Back to inbox", admin_sms_path, class: "admin-button admin-button--secondary" %>
  <%= button_to admin_sms_path(phone: @phone),
      method: :delete,
      class: "delete-button admin-button admin-button--danger",
      data: { turbo_confirm: "Are you sure you want to delete this entire conversation? This action cannot be undone." } do %>
    Delete Conversation
  <% end %>
<% end %>

<% if @reservations&.any? %>
  <div class="admin-stack admin-stack--tight admin-stack--spaced">
    <% @reservations.each do |reservation| %>
      <div class="admin-notice">
        <div>
          <p class="admin-notice-title"><%= link_to reservation.summary, admin_reservation_path(reservation.id), class: "admin-link" %></p>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= render partial: "admin/sms/thread", locals: { phone: @phone, smses: @smses, expanded: true, show_page: true } %>
