<%= form_with(model: [ :admin, thank ], class: "flex flex-col gap-6") do |form| %>
  <%= render "shared/form_errors", object: thank %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Supporter thank you</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">The image and message shown on the public thank-you page.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :image_upload, "Image", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.file_field :image_upload,
              accept: Thank::ALLOWED_IMAGE_TYPES.join(","),
              class: admin_input_class %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">PNG, JPEG, WebP, or GIF up to 5 MB.</p>

          <% if thank.persisted? && thank.image.present? %>
            <div class="admin-image-preview admin-image-preview--settings border-line bg-stone dark:border-line-dark dark:bg-stone-dark">
              <%= image_tag image_thank_path(thank, v: thank.updated_at.to_i), alt: "Current supporter image" %>
            </div>
            <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave this blank to keep the current image.</p>
          <% end %>
        </div>

        <div class="admin-field">
          <%= form.label :content, "Content (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_area :content, rows: 6, class: admin_textarea_class, placeholder: "Thanks to our friends at..." %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Optional. Shown beneath the image on the public page.</p>
        </div>

        <div class="admin-field">
          <%= form.label :url, "URL (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.url_field :url, class: admin_input_class, placeholder: "https://example.com" %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Optional. Shown as a link on the public page and opens in a new tab.</p>
        </div>

        <div class="admin-field">
          <%= form.label :url_text, "URL Text (optional)", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.text_field :url_text, class: admin_input_class, placeholder: "Visit our supporter" %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Optional. Displayed as the link text instead of the URL. If blank, the URL is shown.</p>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_thanks_path, class: admin_button_class(variant: :secondary) %>
      <%= form.submit class: admin_button_class %>
    </div>
  </section>
<% end %>
