<%= render "admin/shared/page_header",
           title: "Thanks",
           description: "Manage the supporters shown on the public thank-you page." do %>
  <%= link_to "Add thank", new_admin_thank_path, class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <div>
          <h2 class="admin-panel-title text-ink dark:text-ink-dark">Supporters</h2>
          <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Each entry appears with its image and message on the public page at <code>/thanks</code>.</p>
        </div>
        <%= link_to "View public page", thanks_path, target: "_blank", rel: "noopener", class: "admin-button admin-button--secondary admin-button--small border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
      </div>

      <% if @thanks.any? %>
        <div class="admin-table-wrap">
          <table class="admin-table text-ink dark:text-ink-dark">
            <thead>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Image</th>
                <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Content</th>
                <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Updated</th>
                <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @thanks.each do |thank| %>
                <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                  <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                    <div class="flex h-16 w-24 items-center justify-center rounded border border-line bg-stone p-1 dark:border-line-dark dark:bg-stone-dark">
                      <%= image_tag image_thank_path(thank, v: thank.updated_at.to_i), alt: "Supporter logo", loading: "lazy", class: "max-h-full max-w-full object-contain" %>
                    </div>
                  </td>
                  <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= truncate(thank.content, length: 140) %></td>
                  <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= thank.updated_at.strftime("%b %-d, %Y") %></td>
                  <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                    <div class="admin-table-actions">
                      <%= link_to "Edit", edit_admin_thank_path(thank), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                      <%= button_to "Delete", admin_thank_path(thank),
                          method: :delete,
                          class: "admin-link admin-link--danger text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark",
                          form: { data: { turbo_confirm: "Are you sure you want to delete this thank?" } } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="admin-panel-body">
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">No thanks have been added yet.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
