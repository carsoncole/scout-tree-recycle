<%= form_with(model: [:admin, user], class: "flex flex-col gap-6") do |form| %>
  <%= render "shared/form_errors", object: user %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">User information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Enter the user's login and role details.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :email, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.email_field :email, class: admin_input_class %>
        </div>

        <% if user.persisted? %>
          <div class="admin-field-grid admin-field-grid--two">
            <div class="admin-field">
              <%= form.label :password, "New password", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= form.password_field :password, class: admin_input_class %>
            </div>
            <div class="admin-field">
              <%= form.label :password_confirmation, "Confirm new password", class: "admin-label text-ink dark:text-ink-dark" %>
              <%= form.password_field :password_confirmation, class: admin_input_class %>
            </div>
          </div>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">Leave both password fields blank to keep the current password.</p>
        <% else %>
          <p class="admin-hint text-ink-soft dark:text-ink-soft-dark">The user will receive an email with a link to create their password.</p>
        <% end %>

        <div class="admin-field">
          <%= form.label :role, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= form.select :role, [ [ "Admin", "admin" ], [ "User", "user" ] ], {}, class: admin_select_class %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_users_path, class: admin_button_class(variant: :secondary) %>
      <%= form.submit class: admin_button_class %>
    </div>
  </section>
<% end %>
