<%= form_with(model: [:admin, user], class: "admin-stack") do |form| %>
  <%= render "shared/form_errors", object: user %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">User information</h2>
        <p class="admin-panel-description">Enter the user's login and role details.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= form.label :email, class: "admin-label" %>
          <%= form.email_field :email, class: "admin-input" %>
        </div>

        <div class="admin-field-grid admin-field-grid--two">
          <div class="admin-field">
            <%= form.label :password, class: "admin-label" %>
            <%= form.password_field :password, class: "admin-input" %>
          </div>
          <div class="admin-field">
            <%= form.label :password_confirmation, class: "admin-label" %>
            <%= form.password_field :password_confirmation, class: "admin-input" %>
          </div>
        </div>

        <div class="admin-field">
          <%= form.label :role, class: "admin-label" %>
          <%= form.select :role, [ [ "Admin", "admin" ], [ "User", "user" ] ], {}, class: "admin-select" %>
        </div>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_users_path, class: "admin-button admin-button--secondary" %>
      <%= form.submit class: "admin-button" %>
    </div>
  </section>
<% end %>
