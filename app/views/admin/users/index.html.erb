<%= render "admin/shared/page_header",
           title: "Users",
           description: "Manage system users and their permissions." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="admin-stack">
  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Role privileges</h2>
        <p class="admin-panel-description">What each role can access in the admin area.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-grid admin-grid--two">
        <div>
          <h3 class="admin-section-title">User role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Reservations: all access",
              "Routes: all access",
              "Zones: all access",
              "Marketing: all access",
              "SMS: all access",
              "Donations: all access",
              "System logs: all access"
            ].each do |privilege| %>
              <div class="admin-detail">
                <dt class="admin-detail-label">Allowed</dt>
                <dd class="admin-detail-value"><%= privilege %></dd>
              </div>
            <% end %>
            <% [ "Users: view only", "Settings: view only" ].each do |privilege| %>
              <div class="admin-detail">
                <dt class="admin-detail-label">Limited</dt>
                <dd class="admin-detail-value"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <div>
          <h3 class="admin-section-title">Admin role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Full access to all system features and settings",
              "Can manage user accounts and roles",
              "Can modify system settings and configurations"
            ].each do |privilege| %>
              <div class="admin-detail">
                <dt class="admin-detail-label">Full access</dt>
                <dd class="admin-detail-value"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">User list</h2>
        <p class="admin-panel-description">A list of all users in the system.</p>
      </div>
      <%= link_to "Add user", new_admin_user_path, class: "admin-button" %>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">Role</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.email %></td>
              <td>
                <span class="admin-badge <%= user.role == "admin" ? "admin-badge--info" : "admin-badge--neutral" %>">
                  <%= user.role.titleize %>
                </span>
              </td>
              <td>
                <div class="admin-table-actions">
                  <%= link_to "Edit", edit_admin_user_path(user), class: "admin-link" %>
                  <%= button_to "Delete", admin_user_path(user),
                      method: :delete,
                      class: "admin-link admin-link--danger",
                      form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

</div>
