<%= content_for :title, "Users" %>
<%= render "admin/shared/page_header",
           title: "Users",
           description: "Manage system users and their permissions." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Role privileges</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">An overview of the access and permissions assigned to each role.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <h3 class="admin-section-title text-ink dark:text-ink-dark">User role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Operations: reservations, pickups, donations, and SMS (full access)",
              "Content: marketing, templates, images, contacts, and thank-you content (full access)",
              "Routing setup: routes, zones, drivers, and route points (full access)",
              "System: logs (view/delete), configuration (view), and jobs dashboard (full access)",
              "Data: view only (cannot import, export, schedule, or email reservation data)"
            ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Allowed</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
            <% [
              "Users: view list and role privileges only (cannot create, edit, or delete users)",
              "Settings & operations: can view settings/operations sections, but cannot update settings, toggle flags, send test email, change retention, or run post-event cleanup (migrate reservations)"
            ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Limited</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <div>
          <h3 class="admin-section-title text-ink dark:text-ink-dark">Admin role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Full access to all system features and settings",
              "Can manage user accounts and roles",
              "Can perform all data actions, modify settings (including retention/operations), and run protected operations"
            ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Full access</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>

        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">User list</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">A list of all users in the system.</p>
      </div>
      <%= link_to "Add user", new_admin_user_path, class: admin_button_class %>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="<%= admin_th_class %>">Email</th>
            <th scope="col" class="<%= admin_th_class %>">Role</th>
            <th scope="col" class="<%= admin_th_class %>">Last login</th>
            <th scope="col" class="<%= admin_th_class %>">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="<%= admin_td_class %>"><%= user.email %></td>
              <td class="<%= admin_td_class %>">
                <span class="<%= admin_badge_class(user.role == "admin" ? "info" : "neutral") %>">
                  <%= user.role.titleize %>
                </span>
              </td>
              <td class="<%= admin_td_class %>">
                <% if user.last_login_at.present? %>
                  <%= l(user.last_login_at.in_time_zone, format: :long) %>
                <% else %>
                  <span class="text-muted dark:text-muted-dark">Never</span>
                <% end %>
              </td>
              <td class="<%= admin_td_class %>">
                <div class="admin-table-actions">
                  <%= link_to "Edit", edit_admin_user_path(user), class: admin_link_class %>
                  <%= button_to "Delete", admin_user_path(user),
                      method: :delete,
                      class: admin_link_class(variant: :danger),
                      form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

</div>
