<%= render "admin/shared/page_header",
           title: "Users",
           description: "Manage system users and their permissions." %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Role privileges</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">What each role can access in the admin area.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="grid gap-5 md:grid-cols-2">
        <div>
          <h3 class="admin-section-title text-ink dark:text-ink-dark">User role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Reservations: all access",
              "Routes: all access",
              "Zones: all access",
              "Marketing: all access",
              "SMS: all access",
              "Donations: all access",
              "System logs: all access"
            ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Allowed</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
            <% [ "Users: view only", "Settings: view only" ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Limited</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <div>
          <h3 class="admin-section-title text-ink dark:text-ink-dark">Admin role</h3>
          <dl class="admin-detail-list admin-detail-list--spaced">
            <% [
              "Full access to all system features and settings",
              "Can manage user accounts and roles",
              "Can modify system settings and configurations"
            ].each do |privilege| %>
              <div class="admin-detail border-line dark:border-line-dark">
                <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Full access</dt>
                <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= privilege %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">User list</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">A list of all users in the system.</p>
      </div>
      <%= link_to "Add user", new_admin_user_path, class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Email</th>
            <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Role</th>
            <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= user.email %></td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                <span class="admin-badge <%= user.role == "admin" ? "admin-badge--info bg-info-bg text-info dark:bg-info-bg-dark dark:text-info-dark" : "admin-badge--neutral bg-stone text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark" %>">
                  <%= user.role.titleize %>
                </span>
              </td>
              <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                <div class="admin-table-actions">
                  <%= link_to "Edit", edit_admin_user_path(user), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                  <%= button_to "Delete", admin_user_path(user),
                      method: :delete,
                      class: "admin-link admin-link--danger text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark text-danger hover:text-[#743730] dark:text-danger-dark dark:hover:text-danger-border-dark",
                      form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

</div>
