<%= form_with(model: [:admin, zone], class: "flex flex-col gap-6") do |f| %>
  <%= render "shared/form_errors", object: zone %>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Name the zone and attach any unzoned routes.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.label :name, class: "admin-label text-ink dark:text-ink-dark" %>
          <%= f.text_field :name, class: admin_input_class %>
        </div>

        <fieldset class="admin-field">
          <legend class="admin-label text-ink dark:text-ink-dark">Routes</legend>
          <div class="flex flex-col gap-4">
            <%= f.collection_check_boxes :route_ids, Route.unzoned, :id, :name do |b| %>
              <label class="admin-check-row text-ink dark:text-ink-dark">
                <%= b.check_box class: "admin-checkbox accent-sage dark:accent-sage-dark" %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="admin-panel-footer border-line dark:border-line-dark">
      <%= link_to "Cancel", admin_zones_path, class: admin_button_class(variant: :secondary) %>
      <%= f.submit class: admin_button_class %>
    </div>
  </section>
<% end %>
