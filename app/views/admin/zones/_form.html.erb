<%= form_with(model: [:admin, zone], class: "admin-stack") do |f| %>
  <%= render "shared/form_errors", object: zone %>

  <section class="admin-panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Zone information</h2>
        <p class="admin-panel-description">Name the zone and attach any unzoned routes.</p>
      </div>
    </div>

    <div class="admin-panel-body">
      <div class="admin-form">
        <div class="admin-field">
          <%= f.label :name, class: "admin-label" %>
          <%= f.text_field :name, class: "admin-input" %>
        </div>

        <fieldset class="admin-field">
          <legend class="admin-label">Routes</legend>
          <div class="admin-stack admin-stack--tight">
            <%= f.collection_check_boxes :route_ids, Route.unzoned, :id, :name do |b| %>
              <label class="admin-check-row">
                <%= b.check_box class: "admin-checkbox" %>
                <span><%= b.text %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      </div>
    </div>

    <div class="admin-panel-footer">
      <%= link_to "Cancel", admin_zones_path, class: "admin-button admin-button--secondary" %>
      <%= f.submit class: "admin-button" %>
    </div>
  </section>
<% end %>
