<%= content_for :title, "Zones" %>
<%= render "admin/shared/page_header",
           title: "Zones",
           description: "Group pickup routes into geographic zones." do %>
  <%= link_to "Drivers", admin_drivers_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "Routes", admin_routes_path, class: admin_button_class(variant: :secondary) %>
  <%= link_to "New Zone", new_admin_zone_path, class: admin_button_class %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-table-wrap">
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Name</th>
              <th scope="col" class="<%= admin_th_class %>">Address</th>
              <th scope="col" class="<%= admin_th_class %>">Routes</th>
              <th scope="col" class="<%= admin_th_class %>">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @zones.each do |zone| %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= zone.name %></td>
                <td class="<%= admin_td_class %>"><%= [ zone.street, zone.city, zone.state, zone.country ].compact.join(", ") %></td>
                <td class="<%= admin_td_class %>">
                  <% if zone.routes.any? %>
                    <div class="admin-table-actions">
                      <% zone.routes.each do |route| %>
                        <%= link_to route.name, admin_route_path(route), class: admin_badge_class(:info) %>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No routes assigned</span>
                  <% end %>
                </td>
                <td class="<%= admin_td_class %>">
                  <div class="admin-table-actions">
                    <%= link_to "View", admin_zone_path(zone), class: admin_link_class %>
                    <%= link_to "Edit", edit_admin_zone_path(zone), class: admin_link_class %>
                    <%= button_to "Delete", admin_zone_path(zone),
                        method: :delete,
                        data: {
                          turbo_confirm: "Are you sure you want to delete this zone? This action cannot be undone.",
                          turbo_method: :delete
                        },
                        class: admin_link_class(variant: :danger) %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @zones.empty? %>
        <%= render "admin/shared/empty_state", message: "No zones have been added yet." %>
      <% end %>
    </section>
  </div>
</div>
