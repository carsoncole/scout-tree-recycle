<%= content_for :title, "Zone: #{@zone.name}" %>
<%= render "admin/shared/page_header",
           title: "Zone: #{@zone.name}" do %>
  <%= link_to "Edit", edit_admin_zone_path(@zone), class: admin_button_class %>
  <%= link_to "Back to Zones", admin_zones_path, class: admin_button_class(variant: :secondary) %>
<% end %>

<div class="admin-settings-layout">
  <%= render "admin/settings/sidebar" %>

  <div class="flex flex-col gap-6">
    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone information</h2>
      </div>
      <div class="admin-panel-body">
        <dl class="admin-detail-list">
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Name</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @zone.name %></dd>
          </div>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Address</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= [ @zone.street, @zone.city, @zone.state, @zone.country ].compact_blank.join(", ").presence || "—" %></dd>
          </div>
          <div class="admin-detail border-line dark:border-line-dark">
            <dt class="admin-detail-label text-ink-soft dark:text-ink-soft-dark">Routes</dt>
            <dd class="admin-detail-value text-ink dark:text-ink-dark"><%= @routes.size %></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone map</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Bounded areas for all routes in this zone and plotted reservations.</p>
      </div>
      <div class="admin-panel-body">
        <% route_polygons = @routes.flat_map { |route| route_boundary_polygon(route) } %>
        <% reservation_markers = reservation_map_markers(@reservations) %>
        <% if route_polygons.any? || reservation_markers.any? %>
          <%= render "shared/map",
                polygons: route_polygons,
                markers: reservation_markers,
                height_class: "h-96",
                empty_message: "No map data available for this zone." %>
          <% routes_without_boundary = @routes.select { |route| route.points.length <= 3 } %>
          <% if routes_without_boundary.any? %>
            <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark">
              Routes without a bounded area (&gt; 3 ordered points): <%= routes_without_boundary.map(&:name).join(", ") %>.
            </p>
          <% end %>
        <% else %>
          <%= render "admin/shared/empty_state", message: "No route boundaries or reservations with coordinates are available for this zone." %>
        <% end %>
      </div>
    </section>

    <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
      <div class="admin-panel-header border-line dark:border-line-dark">
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Routes</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Routes associated with this zone.</p>
      </div>
      <div class="admin-panel-body">
        <% if @routes.any? %>
          <div class="admin-table-wrap">
            <table class="admin-table text-ink dark:text-ink-dark">
              <thead>
                <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                  <th scope="col" class="<%= admin_th_class %>">Name</th>
                  <th scope="col" class="<%= admin_th_class %>">Reservations</th>
                  <th scope="col" class="<%= admin_th_class %>">Boundary points</th>
                  <th scope="col" class="<%= admin_th_class %>">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @routes.each do |route| %>
                  <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                    <td class="<%= admin_td_class %>"><%= link_to route.name, admin_route_path(route), class: admin_link_class %></td>
                    <td class="<%= admin_td_class %>"><%= route.reservations_count %></td>
                    <td class="<%= admin_td_class %>"><%= route.points.size %></td>
                    <td class="<%= admin_td_class %>">
                      <div class="admin-table-actions">
                        <%= link_to "View", admin_route_path(route), class: admin_link_class %>
                        <%= link_to "Edit", edit_admin_route_path(route), class: admin_link_class %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <%= render "admin/shared/empty_state", message: "No routes are associated with this zone." %>
        <% end %>
      </div>
    </section>
  </div>
</div>
