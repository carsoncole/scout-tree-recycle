<% content_for :title, "Unsubscribe | #{setting&.home_page_header || "Tree Recycle"}" %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Mailing list",
               title: "Unsubscribe from Tree Recycling Updates",
               description: "We’re sorry to see you go. By proceeding, we will remove your email from any further messages about our tree recycling event." %>

    <div class="site-section">
      <div class="site-prose">
        <p>Are you sure you want to unsubscribe?</p>
      </div>

      <%= button_to "Yes, Unsubscribe Me",
                    contact_path(@contact),
                    method: :delete,
                    class: "site-button site-button--secondary site-button--full",
                    data: { turbo_method: :delete } %>
    </div>
  </div>
</section>
