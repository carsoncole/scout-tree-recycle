<div class="">
  <div class="col-lg-6">
    <section class="mb-7">
      <h3 class="font-bold text-lg">Donate online</h3>
      <p>Suggested donation is $25, but you can change this on the donation page.</p>
      <%= form_tag [:reservation, :donations], local: true, data: { turbo: false } do %>
        <div class="action online">
          <%= submit_tag 'Donate online', class: 'btn btn-primary btn-lg', id: 'button-donate-online' %>
        </div>
      <% end %>
    </section>
  </div>

  <div class="col-lg-6">
    <section class="mb-7">
      <h3 class="font-bold text-lg">Donate at pick-up</h3>
      <p>Place your donation in an envelope and attach it to your tree before 8am on Jan 2023. Make checks payable to BSA Troop 1564 & 1804.</p>
      <%= form_tag reservation_cash_or_check_path(reservation_id: @reservation.id), local: true, data: { turbo: false } do %>
        <div class="action pickup">
          <%= submit_tag "Donate at pick-up", class: 'btn btn-primary btn-lg', id: 'button-donate-at-pickup' %>
        </div>
      <% end %>
    </section>
  </div>
</div>

<section class="mb-7">
  <div class="row">
    <div class="col-lg-12 thinking-about-it">
      <%= form_tag reservation_no_donation_path(reservation_id: @reservation.id), local: true, data: { turbo: false } do %>
        <div class="action no-donation">
          <%= submit_tag "No donation", class: 'btn btn-primary btn', id: 'button-donate-thinking' %>
        </div>
      <% end %>
    </div>
  </div>
</section> 