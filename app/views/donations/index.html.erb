<% content_for :title, "Donations | #{setting&.home_page_header || "Tree Recycle"}" %>
<% content_for :description, "Support the tree recycling fundraiser." %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Tree pickup fundraiser",
               title: "Donations",
               description: "Support our mission." %>

    <div class="site-prose text-ink-soft dark:text-ink-soft-dark">
      <p>
        Thank you for your interest in supporting <%= setting.organization_name %>.
        Your generosity helps us continue our work of environmental stewardship
        and community service.
      </p>

      <div class="site-callout border-line dark:border-line-dark">
        <h2 class="text-ink dark:text-ink-dark">How to Donate</h2>
        <p>
          If you would like to make a donation, you can leave cash or a check in a
          ziplock bag with your tree on the day of pickup. Our volunteers will
          collect it along with your tree.
        </p>
        <p class="mb-0">
          Your support makes a real difference in our community and helps us
          continue this annual fundraiser.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%= link_to "Confirm Your Tree Pickup Reservation", reservation_confirmation_path(@reservation), class: "site-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
    </div>
  </div>
</section>
