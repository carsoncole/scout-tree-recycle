<% content_for :title, "Donations | #{default_page_name}" %>
<% content_for :description, "Support the tree recycling fundraiser." %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Tree pickup fundraiser",
               title: "Donations",
               description: "Support our mission." %>

    <div class="site-prose text-ink-soft dark:text-ink-soft-dark">
      <%= basic_markdown setting.donations_page_content_text %>

      <div class="site-callout border-line dark:border-line-dark">
        <h2 class="text-ink dark:text-ink-dark">How to Donate</h2>
        <%= basic_markdown setting.donations_page_how_to_donate_text, class: "last:mb-0" %>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <%# POSTs to no_donation, which completes the reservation (donation_type + routing) before redirecting to the read-only confirmation page. %>
      <%= button_to "Confirm Your Tree Pickup Reservation",
                    reservation_no_donation_path(reservation_id: @reservation.public_token),
                    class: "site-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
    </div>
  </div>
</section>
