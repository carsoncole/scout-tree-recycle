<% suggested_donation = number_to_currency(setting.suggested_donation_amount, precision: 0) %>
<% content_for :title, "Support #{setting.organization_name} | #{setting&.home_page_header || "Tree Recycle"}" %>
<% content_for :description, "Choose how you would like to support the tree pickup fundraiser." %>

<section class="site-page">
  <div class="site-container site-container--medium">
    <%= render "shared/page_header",
               eyebrow: "One last step",
               title: "Support #{setting.organization_name}",
               description: "Complete your reservation by choosing a donation option." %>

    <div class="site-prose text-ink-soft dark:text-ink-soft-dark">
      <p>
        Our tree pickup service is free, but it's also our biggest fundraiser of the year.
        Every donation goes straight to <%= setting.organization_name %> and helps Scouts take part in:
      </p>
      <ul>
        <li>Summer camps and outdoor adventures</li>
        <li>Leadership and team-building activities</li>
        <li>Community service projects</li>
      </ul>
      <p class="mb-0">
        A donation of <strong class="font-semibold text-ink dark:text-ink-dark"><%= suggested_donation %></strong>
        or whatever you can give makes a real difference.
      </p>
    </div>

    <div class="donation-options">
      <div class="site-choice-grid site-choice-grid--two site-choice-grid--cards">
        <section class="site-choice site-choice--card rounded-2xl border border-sage bg-sage-soft/40 dark:border-sage-dark dark:bg-sage-soft-dark/40" aria-labelledby="donate-online">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="donate-online" class="text-ink dark:text-ink-dark">Donate Online</h2>
            <span class="inline-flex items-center rounded-full bg-sage px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] text-surface dark:bg-sage-dark dark:text-page-dark">Suggested <%= suggested_donation %></span>
          </div>
          <p class="text-ink-soft dark:text-ink-soft-dark">Quick, secure, and convenient.</p>
          <%= form_with url: reservation_donations_path(@reservation),
                        method: :post,
                        data: { turbo: false },
                        class: "site-form" do |form| %>
            <%= form.submit "Donate Online", class: "site-button site-button--full bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
          <% end %>
        </section>

        <section class="site-choice site-choice--card rounded-2xl border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" aria-labelledby="donate-pickup">
          <h2 id="donate-pickup" class="text-ink dark:text-ink-dark">Donate at Pickup</h2>
          <p class="text-ink-soft dark:text-ink-soft-dark">Leave cash or a check with your tree.</p>
          <%= form_with url: reservation_cash_or_check_path(reservation_id: @reservation.id),
                        method: :post,
                        data: { turbo: false },
                        class: "site-form" do |form| %>
            <%= form.submit "Donate at Pickup", class: "site-button site-button--secondary site-button--full border border-line-strong bg-surface text-ink hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:text-ink-dark dark:hover:bg-stone-dark" %>
          <% end %>
        </section>
      </div>

      <section class="site-choice site-choice--quiet border-t border-line text-center dark:border-line-dark" aria-labelledby="no-donation">
        <h2 id="no-donation" class="text-ink dark:text-ink-dark">Continue without a donation</h2>
        <p class="text-ink-soft dark:text-ink-soft-dark">You can still reserve a tree pickup. Donations are always optional.</p>
        <%= form_with url: reservation_no_donation_path(reservation_id: @reservation.id),
                      method: :post,
                      data: { turbo: false },
                      class: "site-form" do |form| %>
          <%= form.submit "Continue without donation", class: "site-button site-button--quiet text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark" %>
        <% end %>
      </section>
    </div>
  </div>
</section>
