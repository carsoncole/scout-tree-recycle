<% content_for :title, "Support #{setting.organization_name} | #{setting&.home_page_header || "Tree Recycle"}" %>
<% content_for :description, "Choose how you would like to support the tree pickup fundraiser." %>

<section class="site-page">
  <div class="site-container site-container--medium">
    <%= render "shared/page_header",
               eyebrow: "One last step",
               title: "Support #{setting.organization_name}",
               description: "Complete your reservation by choosing a donation option." %>

    <div class="site-prose">
      <p>
        Our tree pickup service is free, but your donation makes a real difference.
        Your support helps <%= setting.organization_name %> take part in:
      </p>
      <ul>
        <li>Summer camps and outdoor adventures</li>
        <li>Leadership and team-building activities</li>
        <li>Community service projects</li>
      </ul>
    </div>

    <div class="donation-options">
      <div class="site-choice-grid site-choice-grid--two">
        <section class="site-choice" aria-labelledby="donate-online">
          <h2 id="donate-online">Donate Online</h2>
          <p>Quick, secure, and convenient.</p>
          <%= form_with url: reservation_donations_path(@reservation),
                        method: :post,
                        data: { turbo: false },
                        class: "site-form" do |form| %>
            <%= form.submit "Donate Online", class: "site-button site-button--full" %>
          <% end %>
        </section>

        <section class="site-choice" aria-labelledby="donate-pickup">
          <h2 id="donate-pickup">Donate at Pickup</h2>
          <p>Leave cash or a check with your tree.</p>
          <%= form_with url: reservation_cash_or_check_path(reservation_id: @reservation.id),
                        method: :post,
                        data: { turbo: false },
                        class: "site-form" do |form| %>
            <%= form.submit "Donate at Pickup", class: "site-button site-button--secondary site-button--full" %>
          <% end %>
        </section>
      </div>

      <section class="site-choice" aria-labelledby="no-donation">
        <h2 id="no-donation">Continue without a donation</h2>
        <p>You can still reserve a tree pickup. Donations are always optional.</p>
        <%= form_with url: reservation_no_donation_path(reservation_id: @reservation.id),
                      method: :post,
                      data: { turbo: false },
                      class: "site-form" do |form| %>
          <%= form.submit "Continue without donation", class: "site-button site-button--quiet" %>
        <% end %>
      </section>
    </div>
  </div>
</section>
