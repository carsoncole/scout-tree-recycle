<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "#{Setting.instance&.home_page_header.presence || "Tree Recycle"} Admin" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f6f3ea">
    <meta name="theme-color" content="#171a14" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body bg-page text-ink dark:bg-page-dark dark:text-ink-dark">
    <a class="site-skip-link bg-ink text-surface dark:bg-ink-dark dark:text-page-dark" href="#admin-main">Skip to content</a>

    <% if Setting.exists? %>
      <% unviewed_sms_count = Sms.incoming.unviewed.count %>
      <header class="admin-header border-b border-line bg-page dark:border-line-dark dark:bg-page-dark">
        <div class="admin-header-inner">
          <div class="admin-brand">
            <%= link_to (Setting.instance&.organization_name.presence || Setting.instance&.home_page_header.presence || "Tree Recycle"), admin_root_path, class: "admin-brand-link text-ink hover:text-sage-deep dark:text-ink-dark dark:hover:text-sage-deep-dark" %>
            <span class="admin-brand-meta text-ink-soft dark:text-ink-soft-dark">Admin</span>
          </div>

          <nav class="admin-nav" aria-label="Admin">
            <div class="admin-nav-group">
              <span class="admin-nav-group-label text-muted dark:text-muted-dark">Operations</span>
              <%= link_to "Reservations", admin_reservations_path,
                          class: admin_nav_class(controller_name == "reservations") %>
              <%= link_to "Pickups", admin_pickups_path,
                          class: admin_nav_class(controller_name == "pickups") %>
              <%= link_to "Donations", admin_donations_path,
                          class: admin_nav_class(controller_name == "donations") %>
              <%= link_to admin_sms_path, class: admin_nav_class(controller_name == "sms") do %>
                SMS
                <% if unviewed_sms_count.positive? %>
                  <span class="admin-nav-badge bg-ink text-surface dark:bg-ink-dark dark:text-page-dark"><%= unviewed_sms_count %></span>
                <% end %>
              <% end %>
            </div>

            <span class="admin-nav-divider bg-line dark:bg-line-dark" aria-hidden="true"></span>

            <div class="admin-nav-group">
              <span class="admin-nav-group-label text-muted dark:text-muted-dark">Content</span>
              <%= link_to "Marketing", admin_marketing_index_path,
                          class: admin_nav_class(%w[marketing marketing_email_templates marketing_images reservation_email_templates contacts].include?(controller_name)) %>
            </div>

            <span class="admin-nav-divider bg-line dark:bg-line-dark" aria-hidden="true"></span>

            <div class="admin-nav-group">
              <span class="admin-nav-group-label text-muted dark:text-muted-dark">System</span>
              <%= link_to "Settings", admin_settings_path,
                          class: admin_nav_class(%w[settings drivers routes zones users thanks operations].include?(controller_name)) %>
              <%= link_to "Logs", admin_logs_path,
                          class: admin_nav_class(controller_name == "logs") %>
              <%= link_to "Data", admin_data_path,
                          class: admin_nav_class(controller_name == "data") %>
              <%= link_to "Jobs", admin_mission_control_jobs_path,
                          class: admin_nav_class(false) %>
            </div>

            <span class="admin-nav-divider bg-line dark:bg-line-dark" aria-hidden="true"></span>

            <%= link_to pickups_root_path, target: "_blank", rel: "noopener",
                        class: "#{admin_nav_class(false)} gap-1.5" do %>
              Pickups Portal
              <%= external_link_icon %>
            <% end %>

            <%= link_to root_path, target: "_blank", rel: "noopener",
                        class: "#{admin_nav_class(false)} gap-1.5" do %>
              Website
              <%= external_link_icon %>
            <% end %>
          </nav>

          <div class="admin-account">
            <% if Current.user %>
              <details class="admin-user-menu">
                <summary class="admin-user-menu__summary text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">
                  <span class="admin-user-menu__email"><%= Current.user.email %></span>
                  <svg class="admin-user-menu__chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <div class="admin-user-menu__panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
                  <%= link_to "Log out", admin_session_path, data: { turbo_method: :delete }, class: "admin-user-menu__item text-ink-soft hover:bg-stone hover:text-ink dark:text-ink-soft-dark dark:hover:bg-stone-dark dark:hover:text-ink-dark" %>
                </div>
              </details>
            <% else %>
              <%= link_to "Log in", new_admin_session_path, class: "admin-account-link text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark" %>
            <% end %>
          </div>
        </div>
      </header>
    <% end %>

    <main id="admin-main" class="admin-shell">
      <div class="admin-container">
        <div class="admin-flash" id="flash">
          <%= render "shared/flash" %>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
