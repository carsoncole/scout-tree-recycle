<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "#{Setting.instance&.home_page_header.presence || "Tree Recycle"} Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f4f3ed">
    <meta name="theme-color" content="#171915" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <a class="site-skip-link" href="#admin-main">Skip to content</a>

    <% if Setting.exists? %>
      <% unviewed_sms_count = Sms.incoming.unviewed.count %>
      <header class="admin-header">
        <div class="admin-header-inner">
          <div class="admin-brand">
            <%= link_to (Setting.instance&.organization_name.presence || Setting.instance&.home_page_header.presence || "Tree Recycle"), admin_root_path, class: "admin-brand-link" %>
            <span class="admin-brand-meta">Admin</span>
          </div>

          <nav class="admin-nav" aria-label="Admin">
            <%= link_to "Reservations", admin_reservations_path,
                        class: admin_nav_class(controller_name == "reservations") %>
            <%= link_to "Donations", admin_donations_path,
                        class: admin_nav_class(controller_name == "donations") %>
            <%= link_to "Marketing", admin_marketing_index_path,
                        class: admin_nav_class(%w[marketing marketing_email_templates marketing_images].include?(controller_name)) %>
            <%= link_to "Routes", admin_routes_path,
                        class: admin_nav_class(%w[routes zones].include?(controller_name)) %>
            <%= link_to admin_sms_path, class: admin_nav_class(controller_name == "sms") do %>
              SMS
              <% if unviewed_sms_count.positive? %>
                <span class="admin-nav-badge"><%= unviewed_sms_count %></span>
              <% end %>
            <% end %>
            <%= link_to "Settings", admin_settings_path,
                        class: admin_nav_class(controller_name == "settings") %>
            <%= link_to "Pickups Portal", pickups_root_path, target: "_blank", rel: "noopener",
                        class: "admin-nav-link" %>
          </nav>

          <div class="admin-account">
            <% if Current.user %>
              <span class="admin-account-user"><%= Current.user.email %></span>
              <%= link_to "Log out", admin_session_path, data: { turbo_method: :delete }, class: "admin-account-link" %>
            <% else %>
              <%= link_to "Log in", new_admin_session_path, class: "admin-account-link" %>
            <% end %>
            <%= link_to "View site", root_path, target: "_blank", rel: "noopener", class: "admin-account-link" %>
          </div>
        </div>
      </header>
    <% end %>

    <main id="admin-main" class="admin-shell">
      <div class="admin-container">
        <div class="admin-flash" id="flash">
          <%= render "shared/flash" %>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
