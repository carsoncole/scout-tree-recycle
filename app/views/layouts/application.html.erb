<!DOCTYPE html>
<html lang="en">
  <head>
    <% page_title = content_for(:title) || default_page_name %>
    <% page_description = content_for?(:description) ? yield(:description) : setting&.about_event_description_text %>
    <% page_image = image_url(setting&.home_page_image_name || Setting::DEFAULT_HOME_PAGE_IMAGE) %>
    <% page_url = request.base_url + request.path %>
    <% site_name = setting&.organization_name.presence || default_page_name %>
    <title><%= page_title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= page_url %>">
    <meta property="og:image" content="<%= page_image %>">
    <meta property="og:site_name" content="<%= site_name %>">
    <meta name="theme-color" content="#4c6a57">
    <meta name="theme-color" content="#171a14" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-body bg-page text-ink dark:bg-page-dark dark:text-ink-dark">
    <a class="site-skip-link bg-ink text-surface dark:bg-ink-dark dark:text-page-dark" href="#main">Skip to content</a>

    <%= render "shared/header" %>

    <div class="site-flash-region">
      <%= render "shared/flash" %>
    </div>

    <main id="main" class="site-main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
