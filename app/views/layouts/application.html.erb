<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || Setting.instance&.home_page_header.presence || "Tree Recycle" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : setting&.about_event_description_text %>">
    <meta name="theme-color" content="#4c6a57">
    <meta name="theme-color" content="#171a14" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site-body bg-page text-ink dark:bg-page-dark dark:text-ink-dark">
    <a class="site-skip-link bg-ink text-surface dark:bg-ink-dark dark:text-page-dark" href="#main">Skip to content</a>

    <%= render "shared/header" %>

    <div class="site-flash-region">
      <%= render "shared/flash" %>
    </div>

    <main id="main" class="site-main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
