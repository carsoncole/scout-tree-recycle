<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Down for Maintenance | #{default_page_name}" %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "#{default_page_name} is temporarily down for maintenance." %>">
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="#4c6a57">
    <meta name="theme-color" content="#171a14" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="site-body flex min-h-screen flex-col bg-page text-ink dark:bg-page-dark dark:text-ink-dark">
    <a class="site-skip-link bg-ink text-surface dark:bg-ink-dark dark:text-page-dark" href="#main">Skip to content</a>

    <main id="main" class="flex flex-1 items-center">
      <%= yield %>
    </main>
  </body>
</html>
