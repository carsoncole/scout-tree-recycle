<!DOCTYPE html>
<html class="h-full bg-gray-50 dark:bg-gray-900">
  <head>
    <title>Tree Pickups</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div class="min-h-full">
      <!-- Fixed header -->
      <nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 fixed w-full top-0 z-50 print:hidden">
        <div class="px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 justify-between">
            <div class="flex">
              <div class="flex flex-shrink-0 items-center">
                <h1 class="text-xl font-bold text-gray-900 dark:text-white">Tree Pickups</h1>
              </div>
            </div>
            <div class="flex items-center">
              <%= link_to "Back to Site", root_path, class: "text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300" %>
            </div>
          </div>
        </div>
        <!-- Flash messages inside fixed header -->
        <%= render "shared/flash" %>
      </nav>

      <!-- Main content -->
      <main class="bg-gray-50 dark:bg-gray-900 min-h-screen pt-18 print:pt-0 print:bg-white">
        <div class="py-6 px-4 sm:px-6 lg:px-8 print:p-0">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html> 