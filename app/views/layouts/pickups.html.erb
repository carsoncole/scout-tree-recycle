<!DOCTYPE html>
<html class="h-full bg-gray-50 dark:bg-gray-900">
  <head>
    <title>Tree Pickups</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <div class="min-h-full">
      <!-- Fixed header -->
      <nav class="bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 fixed w-full top-0 z-50 print:hidden">
        <div class="px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 justify-between">
            <div class="flex">
              <div class="flex flex-shrink-0 items-center">
                <%= link_to "Tree Pickups", pickups_root_path, class: "text-xl font-bold text-gray-900 dark:text-white" %>
              </div>
              <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                <%= link_to pickups_drivers_path, class: "inline-flex items-center border-b-2 #{current_page?(pickups_driver_pickup_lists_path) ? 'border-blue-500 text-gray-900 dark:text-white' : 'border-transparent text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-300'} px-1 pt-1 text-sm font-medium" do %>
                  <svg class="h-5 w-5 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                  </svg>
                  Drivers
                <% end %>
                <%= link_to "/pickups/driver_pickup_lists.pdf", target: "_blank", class: "inline-flex items-center border-b-2 #{current_page?('/pickups/drivers/driver_pickup_lists.pdf') ? 'border-blue-500 text-gray-900 dark:text-white' : 'border-transparent text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-700 dark:hover:text-gray-300'} px-1 pt-1 text-sm font-medium" do %>
                  <svg class="h-5 w-5 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                  PDF Report
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <!-- Flash messages inside fixed header -->
        <%= render "shared/flash" %>
      </nav>

      <!-- Main content -->
      <main class="bg-gray-50 dark:bg-gray-900 min-h-screen pt-18 print:pt-0 print:bg-white">
        <div class="py-6 px-4 sm:px-6 lg:px-8 print:p-0">
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html> 