<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Tree Pickups</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f4f3ed">
    <meta name="theme-color" content="#171915" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body">
    <a class="site-skip-link" href="#pickups-main">Skip to content</a>

    <header class="admin-header admin-no-print print:hidden">
      <div class="admin-header-inner">
        <nav class="admin-nav admin-nav--pickups" aria-label="Pickups">
          <%= link_to pickups_root_path, class: "admin-brand" do %>
            <span class="admin-brand-link">Tree Pickups</span>
            <span class="admin-brand-meta">Driver portal</span>
          <% end %>

          <%= link_to "Drivers", pickups_root_path,
                      class: admin_nav_class(current_page?(pickups_root_path) || current_page?(pickups_drivers_path)) %>
          <%= link_to "Instructions", pickups_pickup_instructions_path,
                      class: admin_nav_class(current_page?(pickups_pickup_instructions_path) || current_page?(pickups_instructions_path)) %>
          <%= link_to "PDF report", pickups_driver_pickup_lists_path(format: :pdf), target: "_blank", rel: "noopener",
                      class: "admin-nav-link" %>
        </nav>
      </div>
    </header>

    <main id="pickups-main" class="admin-shell">
      <div class="admin-container">
        <div class="admin-flash print:hidden" id="flash">
          <%= render "shared/flash" %>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
