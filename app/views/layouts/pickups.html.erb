<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Tree Pickups</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f4f3ed">
    <meta name="theme-color" content="#171915" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin-body bg-page text-ink dark:bg-page-dark dark:text-ink-dark">
    <a class="site-skip-link bg-ink text-surface dark:bg-ink-dark dark:text-page-dark" href="#pickups-main">Skip to content</a>

    <header class="admin-header print:hidden border-b border-line bg-page dark:border-line-dark dark:bg-page-dark">
      <div class="admin-header-inner admin-header-inner--pickups">
        <nav class="admin-nav admin-nav--pickups" aria-label="Pickups">
          <%= link_to pickups_root_path, class: "admin-brand" do %>
            <span class="admin-brand-link text-ink hover:text-sage-deep dark:text-ink-dark dark:hover:text-sage-deep-dark">Tree Pickups</span>
          <% end %>

          <%= link_to "Overview", pickups_root_path,
                      class: admin_nav_class(controller_name == "drivers" && action_name == "home") %>
          <%= link_to "Routes", pickups_routes_path,
                      class: admin_nav_class(controller_name == "routes") %>
          <%= link_to "Drivers", pickups_drivers_path,
                      class: admin_nav_class(controller_name == "drivers" && action_name != "home") %>
          <%= link_to "Zones", pickups_zones_path,
                      class: admin_nav_class(controller_name == "zones") %>
        </nav>
      </div>
    </header>

    <main id="pickups-main" class="admin-shell admin-shell--pickups">
      <div class="admin-container admin-container--pickups">
        <div class="admin-flash print:hidden" id="flash">
          <%= render "shared/flash" %>
        </div>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
