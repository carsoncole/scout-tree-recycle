<h1 style="<%= admin_heading_style %>">New Log Entry</h1>

<!-- Log Details Box -->
<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f9fafb; border-radius: 6px; margin-bottom: 30px;">
  <tr>
    <td style="padding: 20px;">
      <h2 style="font-family: Arial, Helvetica, sans-serif; font-size: 18px; font-weight: bold; color: #1f2937; margin: 0 0 15px 0;">
        Log Details
      </h2>
      <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #6b7280;">Severity:</span>
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1f2937; font-weight: 500; float: right;">
              <%= @log.severity&.titleize %>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #6b7280;">Message:</span>
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1f2937; font-weight: 500; float: right;">
              <%= @log.message %>
            </span>
          </td>
        </tr>
        <% if @log.error_type.present? %>
          <tr>
            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
              <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #6b7280;">Error Type:</span>
              <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1f2937; font-weight: 500; float: right;">
                <%= @log.error_type %>
              </span>
            </td>
          </tr>
        <% end %>
        <% if @context_json.present? %>
          <tr>
            <td style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
              <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #6b7280;">Context:</span>
              <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1f2937; font-weight: 500; float: right;">
                <pre style="margin: 0; white-space: pre-wrap;"><%= @context_json %></pre>
              </span>
            </td>
          </tr>
        <% end %>
        <tr>
          <td style="padding: 8px 0;">
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #6b7280;">Environment:</span>
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #1f2937; font-weight: 500; float: right;">
              <%= @log.environment %>
            </span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p style="<%= admin_muted_style %>">
  This email was sent to <%= @user.email %>. If you have any questions, please contact the system administrator.
</p>
