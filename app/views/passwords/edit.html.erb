<% content_for :title, "Reset Your Password | #{setting&.home_page_header || "Tree Recycle"}" %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Account access",
               title: "Reset your password",
               description: "Choose a new password for your account." %>

    <div class="site-form-panel">
      <%= form_with url: password_path(params[:token]), method: :put, class: "site-form" do |form| %>
        <div class="site-field">
          <%= form.label :password, "New password", class: "site-label" %>
          <%= form.password_field :password,
                                  required: true,
                                  autocomplete: "new-password",
                                  maxlength: 72,
                                  class: "site-input" %>
        </div>

        <div class="site-field">
          <%= form.label :password_confirmation, "Confirm new password", class: "site-label" %>
          <%= form.password_field :password_confirmation,
                                  required: true,
                                  autocomplete: "new-password",
                                  maxlength: 72,
                                  class: "site-input" %>
        </div>

        <%= form.submit "Update password", class: "site-button site-button--full" %>
      <% end %>
    </div>
  </div>
</section>
