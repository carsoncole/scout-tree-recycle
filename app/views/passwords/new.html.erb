<% content_for :title, "Reset Your Password | #{default_page_name}" %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Account access",
               title: "Forgot your password?",
               description: "Enter your email address and we’ll send you reset instructions." %>

    <div class="site-form-panel">
      <%= form_with url: passwords_path, class: "site-form" do |form| %>
        <div class="flex flex-col gap-[0.45rem]">
          <%= form.label :email, "Email address", class: "site-label text-ink dark:text-ink-dark" %>
          <%= form.email_field :email,
                               required: true,
                               autofocus: true,
                               autocomplete: "username",
                               value: params[:email],
                               class: "site-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
        </div>

        <%= form.submit "Send reset instructions", class: "site-button site-button--full bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      <% end %>
    </div>

    <div class="site-section border-line dark:border-line-dark">
      <%= link_to "Back to sign in", new_admin_session_path, class: "site-back-link text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark" %>
    </div>
  </div>
</section>
