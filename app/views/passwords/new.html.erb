<% content_for :title, "Reset Your Password | #{setting&.home_page_header || "Tree Recycle"}" %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= render "shared/page_header",
               eyebrow: "Account access",
               title: "Forgot your password?",
               description: "Enter your email address and we’ll send you reset instructions." %>

    <div class="site-form-panel">
      <%= form_with url: passwords_path, class: "site-form" do |form| %>
        <div class="site-field">
          <%= form.label :email, "Email address", class: "site-label" %>
          <%= form.email_field :email,
                               required: true,
                               autofocus: true,
                               autocomplete: "username",
                               value: params[:email],
                               class: "site-input" %>
        </div>

        <%= form.submit "Send reset instructions", class: "site-button site-button--full" %>
      <% end %>
    </div>

    <div class="site-section">
      <%= link_to "Back to sign in", new_admin_session_path, class: "site-back-link" %>
    </div>
  </div>
</section>
