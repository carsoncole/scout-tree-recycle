<div class="admin-container--small admin-container--flush">
  <div class="admin-page-header admin-page-header--stacked">
    <p class="admin-eyebrow text-sage-deep dark:text-sage-deep-dark">Driver portal</p>
    <h1 class="admin-page-title text-ink dark:text-ink-dark">Driver Access Required</h1>
    <p class="mt-[0.45rem] mb-0 max-w-[44rem] text-[0.96rem] leading-[1.55] text-ink-soft dark:text-ink-soft-dark">Enter your driver password to view pickup information.</p>
  </div>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-body">
      <%= form_tag pickups_root_path, method: :get, class: "admin-form" do %>
        <div class="admin-field">
          <%= label_tag :driver_secret_key, "Password", class: "admin-label text-ink dark:text-ink-dark" %>
          <%= text_field_tag :driver_secret_key, nil, class: "admin-input border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark", autocomplete: "off" %>
        </div>

        <%= submit_tag "Access Pickups", class: "admin-button admin-button--full bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
      <% end %>
    </div>
  </section>
</div>
