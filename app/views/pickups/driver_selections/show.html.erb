<%= render "admin/shared/page_header",
      title: "Select Driver",
      description: "Choose your name to list your routes first. Your choice stays on this device until you change it." %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-panel-body">
    <% if @drivers.any? %>
      <%= form_with url: pickups_driver_selection_path, method: :patch, class: "flex flex-col gap-5" do %>
        <fieldset class="flex flex-col gap-2">
          <legend class="mb-1 text-sm font-semibold text-ink dark:text-ink-dark">Drivers</legend>
          <% @drivers.each do |driver| %>
            <label class="flex cursor-pointer items-center gap-3 rounded-md border border-line-strong bg-surface px-4 py-3 hover:bg-stone dark:border-line-strong-dark dark:bg-surface-dark dark:hover:bg-stone-dark">
              <%= radio_button_tag :driver_id, driver.id, driver.id == @selected_driver_id,
                    class: "size-4 accent-sage dark:accent-sage-dark" %>
              <span class="text-ink dark:text-ink-dark"><%= driver.name %></span>
            </label>
          <% end %>
        </fieldset>

        <%= submit_tag "Save Driver", class: admin_button_class(variant: "primary") %>
      <% end %>
    <% else %>
      <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No drivers have been added yet.</p>
    <% end %>
  </div>
</section>

<div class="mt-6">
  <%= button_to "Continue Without a Driver",
        pickups_driver_selection_path,
        method: :patch,
        params: { driver_id: "" },
        class: admin_button_class(variant: "secondary") %>
</div>
