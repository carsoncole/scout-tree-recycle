<% @drivers.each do |driver| %>
  <div class="admin-pickup-sheet">
    <div class="admin-pickup-header">
      <div>
        <h1 class="admin-pickup-driver"><%= driver.name %></h1>
        <p class="admin-table-note">Pickup list</p>
      </div>
      <p class="admin-table-note"><%= Date.current.strftime("%B %d, %Y") %></p>
    </div>

    <% if driver.routes.any? %>
      <% driver.routes.each do |route| %>
        <div class="admin-pickup-route">
          <div class="admin-pickup-route-header">
            <h2 class="admin-pickup-route-title">
              <%= route.name %> · <%= route.zone.name %>
            </h2>
            <span class="admin-badge admin-badge--info">
              <%= pluralize(route.reservations.pickup.count, "pickup") %>
            </span>
          </div>

          <% if route.reservations.pickup.any? %>
            <ul class="admin-pickup-list">
              <% route.reservations.pickup.each do |reservation| %>
                <li class="admin-pickup-item">
                  <input type="checkbox"
                         class="admin-pickup-check"
                         id="reservation_<%= reservation.id %>">
                  <label for="reservation_<%= reservation.id %>">
                    <p class="admin-pickup-address">
                      <%= reservation.street %>, <%= reservation.city %>
                    </p>
                    <% if reservation.pickup_notes.present? %>
                      <p class="admin-pickup-note">Notes: <%= reservation.pickup_notes %></p>
                    <% end %>
                  </label>
                  <span class="<%= admin_reservation_status_badge(reservation.status) %>">
                    <%= reservation.status.titleize %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="admin-pickup-note">No pickups for this route.</p>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <p class="admin-pickup-note">No routes assigned.</p>
    <% end %>

    <div class="admin-pickup-signature">
      <p>Driver signature: _______________________</p>
      <p>Date: _______________________</p>
    </div>
  </div>

  <% unless driver == @drivers.last %>
    <div class="admin-page-break"></div>
  <% end %>
<% end %>
