<%= render "admin/shared/page_header", title: "Pickups" %>

<%= render "pickups/shared/legend" %>

<div class="mt-6 flex flex-col gap-6">
  <%= render "pickups/drivers/all_zones_overview",
        routes: @all_routes,
        reservations: @all_reservations,
        status_counts: @status_counts,
        coordinate_less_counts: @coordinate_less_counts %>

  <% @zones.each do |zone| %>
    <%= render "pickups/drivers/zone_overview",
          zone: zone,
          routes: zone.routes,
          reservations: @reservations_by_zone_id[zone.id] || [],
          status_counts: @status_counts,
          coordinate_less_counts: @coordinate_less_counts %>
  <% end %>

  <% if @unzoned_routes.any? %>
    <%= render "pickups/drivers/zone_overview",
          zone: nil,
          routes: @unzoned_routes,
          reservations: @unzoned_reservations,
          status_counts: @status_counts,
          coordinate_less_counts: @coordinate_less_counts %>
  <% end %>

  <% if @zones.empty? && @unzoned_routes.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No zones or routes have been created yet.</p>
  <% end %>
</div>
