<%= render "admin/shared/page_header",
           title: "Pickups",
           description: "Overall pickup status by zone: counts, routes, and plotted reservations." %>

<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.88rem] text-ink-soft dark:text-ink-soft-dark">
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-green-600"></span>Pending</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-gray-500"></span>Picked</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-red-600"></span>Missing</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-blue-500/70"></span>Route area</span>
</div>

<div class="mt-6 flex flex-col gap-6">
  <%= render "pickups/drivers/all_zones_overview",
        routes: @all_routes,
        reservations: @all_reservations,
        status_counts: @status_counts,
        coordinate_less_counts: @coordinate_less_counts %>

  <% @zones.each do |zone| %>
    <%= render "pickups/drivers/zone_overview",
          zone: zone,
          routes: zone.routes,
          reservations: @reservations_by_zone_id[zone.id] || [],
          status_counts: @status_counts,
          coordinate_less_counts: @coordinate_less_counts %>
  <% end %>

  <% if @unzoned_routes.any? %>
    <%= render "pickups/drivers/zone_overview",
          zone: nil,
          routes: @unzoned_routes,
          reservations: @unzoned_reservations,
          status_counts: @status_counts,
          coordinate_less_counts: @coordinate_less_counts %>
  <% end %>

  <% if @zones.empty? && @unzoned_routes.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No zones or routes have been created yet.</p>
  <% end %>
</div>
