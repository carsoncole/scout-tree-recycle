<%= render "admin/shared/page_header",
           title: "Pickups",
           description: "Routes grouped by zone with reservation status counts." %>

<section class="admin-panel">
  <header class="admin-panel-header">
    <div>
      <h2 class="admin-panel-title">Routes by zone</h2>
      <p class="admin-panel-description">Reservation counts for routes with trees pending pickup, picked up, or missing.</p>
    </div>
  </header>

  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Zone / Route</th>
          <th scope="col">Pending pickup</th>
          <th scope="col">Picked up</th>
          <th scope="col">Missing</th>
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @zones.each do |zone| %>
          <% zone_pending = zone.routes.sum { |route| @reservation_counts.fetch([route.id, "pending_pickup"], 0) } %>
          <% zone_picked_up = zone.routes.sum { |route| @reservation_counts.fetch([route.id, "picked_up"], 0) } %>
          <% zone_missing = zone.routes.sum { |route| @reservation_counts.fetch([route.id, "missing"], 0) } %>
          <tr>
            <th scope="row"><%= zone.name %></th>
            <td><%= zone_pending %></td>
            <td><%= zone_picked_up %></td>
            <td><%= zone_missing %></td>
            <td><%= zone_pending + zone_picked_up + zone_missing %></td>
          </tr>
          <% zone.routes.ordered.each do |route| %>
            <% pending = @reservation_counts.fetch([route.id, "pending_pickup"], 0) %>
            <% picked_up = @reservation_counts.fetch([route.id, "picked_up"], 0) %>
            <% missing = @reservation_counts.fetch([route.id, "missing"], 0) %>
            <tr>
              <td><%= link_to route.name, pickups_route_path(route), class: "admin-link" %></td>
              <td><%= pending %></td>
              <td><%= picked_up %></td>
              <td><%= missing %></td>
              <td><%= pending + picked_up + missing %></td>
            </tr>
          <% end %>
        <% end %>

        <% if @unzoned_routes.any? %>
          <% unzoned_pending = @unzoned_routes.sum { |route| @reservation_counts.fetch([route.id, "pending_pickup"], 0) } %>
          <% unzoned_picked_up = @unzoned_routes.sum { |route| @reservation_counts.fetch([route.id, "picked_up"], 0) } %>
          <% unzoned_missing = @unzoned_routes.sum { |route| @reservation_counts.fetch([route.id, "missing"], 0) } %>
          <tr>
            <th scope="row">No Zone</th>
            <td><%= unzoned_pending %></td>
            <td><%= unzoned_picked_up %></td>
            <td><%= unzoned_missing %></td>
            <td><%= unzoned_pending + unzoned_picked_up + unzoned_missing %></td>
          </tr>
          <% @unzoned_routes.each do |route| %>
            <% pending = @reservation_counts.fetch([route.id, "pending_pickup"], 0) %>
            <% picked_up = @reservation_counts.fetch([route.id, "picked_up"], 0) %>
            <% missing = @reservation_counts.fetch([route.id, "missing"], 0) %>
            <tr>
              <td><%= link_to route.name, pickups_route_path(route), class: "admin-link" %></td>
              <td><%= pending %></td>
              <td><%= picked_up %></td>
              <td><%= missing %></td>
              <td><%= pending + picked_up + missing %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @zones.empty? && @unzoned_routes.empty? %>
    <p class="admin-empty">No routes have been created yet.</p>
  <% end %>
</section>
