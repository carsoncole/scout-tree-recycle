<%= render "admin/shared/page_header", title: "Drivers" do %>
  <%= link_to driver_selection_label, pickups_driver_selection_path, class: admin_button_class(variant: "secondary") %>
<% end %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="<%= admin_th_class %>">Name</th>
          <th scope="col" class="<%= admin_th_class %>">Phone</th>
          <th scope="col" class="<%= admin_th_class %>">Routes</th>
        </tr>
      </thead>
      <tbody>
        <% @drivers.each do |driver| %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>">
              <div class="flex flex-wrap items-center gap-2">
                <span><%= driver.name %></span>
                <% if driver.zone_leader? %>
                  <span class="<%= admin_badge_class(:warning) %>">Zone leader: <%= driver.zone_leader_zone.name %></span>
                <% end %>
              </div>
            </td>
            <td class="<%= admin_td_class %>">
              <% if driver.mobile.present? %>
                <%= link_to "sms:#{driver.mobile}", class: "#{admin_link_class} inline-flex items-center gap-1.5" do %>
                  <%= message_icon %><span><%= driver.national_mobile %></span>
                <% end %>
              <% end %>
            </td>
            <td class="<%= admin_td_class %>">
              <% if driver.routes.any? %>
                <div class="admin-table-actions">
                  <% driver.routes.each do |route| %>
                    <%= link_to route.name, pickups_route_path(route), class: admin_badge_class("info") %>
                  <% end %>
                </div>
              <% else %>
                <span class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No routes assigned</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @drivers.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No drivers have been assigned yet.</p>
  <% end %>
</section>
