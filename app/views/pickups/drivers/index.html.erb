<%= render "admin/shared/page_header",
           title: "Drivers",
           description: "View driver assignments and pickup counts." %>

<section class="admin-panel">
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Phone</th>
          <th scope="col">Routes</th>
          <th scope="col">Total pickups</th>
        </tr>
      </thead>
      <tbody>
        <% @drivers.each do |driver| %>
          <tr>
            <td><%= driver.name %></td>
            <td><%= Phonelib.parse(driver.mobile).national if driver.mobile.present? %></td>
            <td>
              <% if driver.routes.any? %>
                <div class="admin-table-actions">
                  <% driver.routes.each do |route| %>
                    <span class="admin-badge admin-badge--info"><%= route.name %></span>
                  <% end %>
                </div>
              <% else %>
                <span class="admin-table-note">No routes assigned</span>
              <% end %>
            </td>
            <td><%= driver.routes.sum { |route| route.reservations.pickup.count } %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @drivers.empty? %>
    <p class="admin-empty">No drivers have been assigned yet.</p>
  <% end %>
</section>
