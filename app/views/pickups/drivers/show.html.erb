<div class="w-full print:bg-white">
  <div class="min-h-screen print:min-h-0">
    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8 print:py-2 print:px-0">
      <!-- Header - Hidden in print -->
      <div class="text-center mb-12 print:hidden">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900 mb-6">
          <svg class="w-8 h-8 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          <%= @driver.name %>
        </h1>
      </div>

      <!-- Print Header -->
      <div class="hidden print:block print:mb-2">
        <h1 class="text-xl font-bold text-gray-900"><%= @driver.name %> - Pickup List</h1>
        <p class="text-sm text-gray-600">Date: <%= Date.current.strftime("%B %d, %Y") %></p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm print:bg-white print:shadow-none">
        <div class="p-6 print:p-0">
          <% if @routes.any? %>
            <div class="space-y-8 print:space-y-2">
              <% @routes.each do |route| %>
                <div class="border-b border-gray-200 dark:border-gray-700 pb-8 last:border-b-0 last:pb-0 print:border-b print:pb-2">
                  <div class="flex items-center justify-between mb-2 print:mb-1">
                    <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-white print:text-base print:text-gray-900">
                      <%= route.name %> - <%= route.zone.name %>
                    </h3>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 print:bg-transparent print:text-gray-900 print:px-0">
                      <%= pluralize(route.reservations.pickup.count, 'pickup') %>
                    </span>
                  </div>

                  <% if route.reservations.pickup.any? %>
                    <div class="mt-2 print:mt-1">
                      <ul role="list" class="divide-y divide-gray-200 dark:divide-gray-700 print:divide-gray-300">
                        <% route.reservations.pickup.each do |reservation| %>
                          <li class="py-2 print:py-1">
                            <div class="flex items-start justify-between">
                              <div class="flex-1 min-w-0">
                                <div class="flex items-center">
                                  <input type="checkbox" 
                                         class="h-6 w-6 text-blue-600 focus:ring-blue-500 border-gray-300 rounded print:border-gray-400 print:h-8 print:w-8"
                                         id="reservation_<%= reservation.id %>">
                                  <label for="reservation_<%= reservation.id %>" class="ml-3">
                                    <p class="text-sm font-medium text-gray-900 dark:text-white print:text-gray-900">
                                      <%= reservation.street %>, <%= reservation.city %>
                                    </p>
                                    <% if reservation.pickup_notes.present? %>
                                      <p class="text-sm text-gray-500 dark:text-gray-400 print:text-gray-600 mt-0.5">
                                        Notes: <%= reservation.pickup_notes %>
                                      </p>
                                    <% end %>
                                  </label>
                                </div>
                              </div>
                              <div class="ml-4 flex-shrink-0">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= reservation.status == 'completed' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200' %> print:bg-transparent print:text-gray-900 print:px-0">
                                  <%= reservation.status.titleize %>
                                </span>
                              </div>
                            </div>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  <% else %>
                    <p class="text-sm text-gray-500 dark:text-gray-400 print:text-gray-600">No pickups for this route</p>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 dark:text-gray-400 print:text-gray-600">No routes assigned</p>
          <% end %>
        </div>
      </div>

      <!-- Print Footer -->
      <div class="hidden print:block print:mt-4 print:pt-2 print:border-t print:border-gray-300">
        <div class="flex justify-between text-sm text-gray-600">
          <div>
            <p>Driver Signature: _______________________</p>
          </div>
          <div>
            <p>Date: _______________________</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @media print {
    @page {
      margin: 0.25in;
    }
    body {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      background: white !important;
    }
    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
  }
</style> 