<%# locals: (location:) %>
<%# Location details for the route map dialog (also shown standalone on the
    location show page). Coordinates are replaced by a directions link so
    drivers can open the location in their device's maps app. %>
<div class="flex flex-col gap-5">
  <div>
    <p class="admin-label text-ink dark:text-ink-dark">Location</p>
    <p class="admin-detail-value text-ink dark:text-ink-dark"><%= location.name %></p>
  </div>

  <% if location.location_type.present? %>
    <div>
      <p class="admin-label text-ink dark:text-ink-dark">Type</p>
      <p class="admin-detail-value text-ink dark:text-ink-dark"><%= location.location_type %></p>
    </div>
  <% end %>

  <div>
    <p class="admin-label text-ink dark:text-ink-dark">Directions</p>
    <p class="admin-detail-value">
      <%= link_to location_directions_url(location),
                  target: "_blank",
                  rel: "noopener",
                  aria: { label: "Get directions to #{location.name}" },
                  class: "inline-flex items-center gap-1.5 text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" do %><%= map_pin_icon %><span>Get directions</span><% end %>
    </p>
  </div>
</div>
