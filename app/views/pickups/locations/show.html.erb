<%# Location details. Loaded into the route map dialog's Turbo Frame when a
   driver taps a location marker; also directly visitable with a back link. %>
<%= render "admin/shared/page_header",
           title: "Location details",
           description: [ @location.location_type.presence, "Map location" ].compact_blank.join(" · ") do %>
  <%= link_to "Back to routes", pickups_routes_path, class: admin_button_class(variant: "secondary") %>
<% end %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-panel-body">
    <%= turbo_frame_tag "route_detail_dialog", data: { pickups_route_target: "frame" } do %>
      <%= render "pickups/locations/panel", location: @location %>
    <% end %>
  </div>
</section>
