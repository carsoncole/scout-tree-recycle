<%# Pickup details. Loaded into the route map dialog's Turbo Frame when a
   driver taps a marker; also directly visitable with a back link. %>
<%= render "admin/shared/page_header",
           title: "Pickup details",
           description: [ @reservation.name.presence, @reservation.street ].compact_blank.join(" · ") do %>
  <%= link_to "Back to route", pickups_route_path(@route), class: "admin-button #{admin_button_class(variant: "secondary")}" %>
<% end %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-panel-body">
    <%= turbo_frame_tag "pickup_reservation_dialog", data: { pickups_route_target: "frame" } do %>
      <%= render "pickups/reservations/panel", route: @route, reservation: @reservation %>
    <% end %>
  </div>
</section>
