<%= turbo_stream.replace dom_id(@reservation, :panel) do %>
  <%= render "shared/pickup_details",
             reservation: @reservation,
             update_url: pickups_route_reservation_path(@route, @reservation),
             activity_logs: @activity_logs,
             notice: flash.now[:notice] %>
<% end %>
<%= turbo_stream.replace "route_status_badge" do %>
  <%= render "pickups/routes/status_badge", pending_count: @route.pending_pickup_count, id: "route_status_badge" %>
<% end %>
<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
