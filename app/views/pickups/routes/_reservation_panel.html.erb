<%# locals: (route:, reservation:, error: nil) %>
<% color = case reservation.status.to_s
   when "pending_pickup" then "#16a34a"
   when "missing" then "#dc2626"
   when "picked_up" then "#6b7280"
   else "#2563eb"
   end %>
<div id="<%= dom_id(reservation, :panel) %>"
     class="flex flex-col gap-6"
     data-controller="pickups-route-panel"
     data-pickups-route-panel-reservation-id-value="<%= reservation.id %>"
     data-pickups-route-panel-status-value="<%= reservation.status %>"
     data-pickups-route-panel-color-value="<%= color %>">
  <div>
    <p class="admin-label text-ink dark:text-ink-dark">Address</p>
    <p class="admin-detail-value text-ink dark:text-ink-dark"><%= [reservation.street, reservation.unit.presence, reservation.city, reservation.state, reservation.zip.presence].compact_blank.join(", ") %></p>
  </div>

  <div>
    <p class="admin-label text-ink dark:text-ink-dark">Notes</p>
    <% if reservation.pickup_notes.present? %>
      <p class="admin-detail-value whitespace-pre-wrap text-ink dark:text-ink-dark"><%= reservation.pickup_notes %></p>
    <% else %>
      <p class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No special instructions.</p>
    <% end %>
  </div>

  <div>
    <p class="admin-label text-ink dark:text-ink-dark">Current status</p>
    <p><span class="<%= admin_reservation_status_badge(reservation.status) %>" data-pickups-route-target="statusBadge"><%= reservation.status.to_s.titleize %></span></p>
  </div>

  <% if error.present? %>
    <p class="text-red-600 dark:text-red-400 text-sm"><%= error %></p>
  <% end %>

  <%= form_with model: reservation,
                url: pickups_route_reservation_path(route, reservation),
                method: :patch,
                data: { turbo: true } do |f| %>
    <div class="admin-field">
      <%= f.label :status, "Update status", class: "admin-label text-ink dark:text-ink-dark" %>
      <%= f.select :status,
                   [["Pending Pickup", "pending_pickup"], ["Picked Up", "picked_up"], ["Missing", "missing"]],
                   {},
                   class: "admin-select border border-line-strong bg-surface text-ink placeholder-muted hover:border-ink-soft focus:border-sage focus:bg-[#fffdf8] disabled:bg-stone disabled:text-muted dark:border-line-strong-dark dark:bg-stone-dark dark:text-ink-dark dark:placeholder-muted-dark dark:hover:border-ink-soft-dark dark:focus:border-sage-dark dark:focus:bg-input-focus-dark dark:disabled:bg-stone-dark dark:disabled:text-muted-dark" %>
    </div>
    <div class="mt-3">
      <%= f.submit "Update status", class: "admin-button bg-sage text-surface hover:bg-sage-deep dark:bg-sage-dark dark:text-page-dark dark:hover:bg-sage-deep-dark" %>
    </div>
  <% end %>
</div>
