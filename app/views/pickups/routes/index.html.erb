<%= render "admin/shared/page_header", title: "Routes" %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap pickups-routes-table">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="<%= admin_th_class %>">Route</th>
          <th scope="col" class="<%= admin_th_class %> pickups-col-secondary">Zone</th>
          <th scope="col" class="<%= admin_th_class %> text-right">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @routes.each do |route| %>
          <% driver_names = route.drivers.map(&:name).to_sentence %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <%= link_to route.name, pickups_route_path(route), class: admin_link_class %>
                <span class="text-[0.82rem] <%= driver_names.present? ? "text-ink-soft dark:text-ink-soft-dark" : "text-muted dark:text-muted-dark" %>">
                  <%= driver_names.presence || "No drivers assigned" %>
                </span>
              </div>
            </td>
            <td class="<%= admin_td_class %> pickups-col-secondary">
              <% zone_target = route.zone ? pickups_zone_path(route.zone) : pickups_zones_path(anchor: pickups_zone_anchor(route.zone)) %>
              <%= link_to route.zone&.name || "No Zone", zone_target, class: admin_link_class %>
            </td>
            <td class="<%= admin_td_class %> text-right"><%= render "pickups/routes/status_badge", pending_count: @pending_counts[route.id] || 0 %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @routes.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No routes have been created yet.</p>
  <% end %>
</section>
