<%= render "admin/shared/page_header",
           title: "Routes",
           description: "All pickup routes with their zone, drivers, and reservation totals." %>

<section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
  <div class="admin-table-wrap">
    <table class="admin-table text-ink dark:text-ink-dark">
      <thead>
        <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Route</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Zone</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Drivers</th>
          <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Reservations</th>
        </tr>
      </thead>
      <tbody>
        <% @routes.each do |route| %>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= link_to route.name, pickups_route_path(route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route.zone&.name || "No Zone" %></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= pluralize(route.drivers.size, "driver") %></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route.reservations_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @routes.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No routes have been created yet.</p>
  <% end %>
</section>
