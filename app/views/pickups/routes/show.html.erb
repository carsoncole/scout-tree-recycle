<%= render "admin/shared/page_header",
           title: "Route: #{@route.name}",
           description: [@route.zone&.name || "No Zone", "Tap a point to view and update pickup status."].join(" · ") do %>
  <%= link_to "Back to Pickups", pickups_root_path, class: "admin-button admin-button--secondary" %>
<% end %>

<% boundary_polygons = route_boundary_polygon(@route) %>
<% pickup_markers = pickups_route_map_markers(@route, @pickup_reservations) %>

<div class="grid gap-6 lg:grid-cols-3"
     data-controller="pickups-route"
     data-action="map:marker-selected@window->pickups-route#select">
  <section class="admin-panel lg:col-span-2">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Route map</h2>
        <p class="admin-panel-description">Green: pending pickup · Red: missing · Gray: picked up</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <% if boundary_polygons.any? || pickup_markers.any? %>
        <div data-pickups-route-target="mapWrap" data-action="pickups:marker-update@window->pickups-route#markerUpdated">
          <%= render "shared/map",
                polygons: boundary_polygons,
                markers: pickup_markers,
                height_class: "h-[70vh] min-h-[28rem]",
                interactive: true,
                empty_message: "No map data available for this route." %>
        </div>
        <% if @missing_coordinates_count.positive? %>
          <p class="admin-table-note mt-3"><%= pluralize(@missing_coordinates_count, "reservation") %> in this route do not have coordinates and are not shown on the map.</p>
        <% end %>
        <% if boundary_polygons.empty? && @route.points.any? %>
          <p class="admin-table-note mt-3">A bounded area requires more than 3 ordered points. Pickup markers are shown when available.</p>
        <% elsif boundary_polygons.empty? %>
          <p class="admin-table-note mt-3">No route boundary defined. Pickup markers are shown when available.</p>
        <% end %>
      <% else %>
        <p class="admin-empty">No route boundary or pickup locations with coordinates are available for this route.</p>
        <% if @missing_coordinates_count.positive? %>
          <p class="admin-table-note mt-3"><%= pluralize(@missing_coordinates_count, "reservation") %> in this route are missing coordinates.</p>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="admin-panel scroll-mt-24 lg:sticky lg:top-24 lg:self-start"
           id="pickup-detail-panel"
           data-pickups-route-target="panel">
    <div class="admin-panel-header">
      <div>
        <h2 class="admin-panel-title">Reservation details</h2>
        <p class="admin-panel-description">Select a point on the map to view its address, notes, and update status.</p>
      </div>
    </div>
    <div class="admin-panel-body">
      <div id="pickup_reservation_panel" data-pickups-route-target="content">
        <p class="admin-empty">No reservation selected.</p>
      </div>
    </div>
  </section>
</div>

<script type="application/json" id="pickups-route-markers"><%= raw json_escape(pickup_markers.to_json) %></script>
