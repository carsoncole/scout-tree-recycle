<%= render "admin/shared/page_header",
           title: "Route: #{@route.name}",
           description: [ @route.zone&.name || "No Zone", "Tap a green dot to view the stop and update its status." ].join(" · ") do %>
  <%= render "pickups/routes/status_badge", pending_count: @route.pending_pickup_count, id: "route_status_badge" %>
<% end %>

<% boundary_polygons = route_boundary_polygon(@route) %>
<% pickup_markers = pickups_route_map_markers(@route, @pickup_reservations) %>
<% location_markers = pickups_route_location_markers(@route) %>
<% markers = pickup_markers + location_markers %>

<div data-controller="pickup-details"
     data-action="map:marker-selected@window->pickup-details#select">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-body admin-panel-body--tight">
      <% if boundary_polygons.any? || markers.any? %>
        <div data-pickup-details-target="mapWrap" data-action="pickups:marker-update@window->pickup-details#markerUpdated">
          <%= render "shared/map",
                polygons: boundary_polygons,
                markers: markers,
                height_class: "h-[calc(100dvh-12rem)] min-h-[24rem] lg:h-[calc(100dvh-14rem)]",
                interactive: true,
                empty_message: "No map data available for this route." %>
        </div>
        <% if pickup_markers.empty? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark">No pending pickups on this route.</p>
        <% end %>
        <% if location_markers.any? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark">Squares show locations such as tree drop-off staging points. Tap one for details and directions.</p>
        <% end %>
        <% if @missing_coordinates_count.positive? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark"><%= pluralize(@missing_coordinates_count, "pending pickup") %> in this route do not have coordinates and are not shown on the map.</p>
        <% end %>
        <% if boundary_polygons.empty? && @route.points.any? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark">A bounded area requires more than 3 ordered points. Pickup markers are shown when available.</p>
        <% elsif boundary_polygons.empty? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark">No route boundary defined. Pickup markers are shown when available.</p>
        <% end %>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No route boundary or pending pickup locations with coordinates are available for this route.</p>
        <% if @missing_coordinates_count.positive? %>
          <p class="admin-table-note mt-3 px-1 text-ink-soft dark:text-ink-soft-dark"><%= pluralize(@missing_coordinates_count, "pending pickup") %> in this route are missing coordinates.</p>
        <% end %>
      <% end %>
    </div>
  </section>

  <%= render "shared/pickup_details_dialog" %>
</div>
