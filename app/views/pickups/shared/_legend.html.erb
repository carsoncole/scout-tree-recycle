<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.88rem] text-ink-soft dark:text-ink-soft-dark">
  <% pickup_status_swatches.each do |swatch| %>
    <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background-color: <%= swatch[:color] %>"></span><%= swatch[:label] %></span>
  <% end %>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background-color: <%= route_area_color %>; opacity: 0.7"></span>Route area</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-[2px]" style="background-color: <%= location_marker_color %>"></span>Location</span>
</div>
