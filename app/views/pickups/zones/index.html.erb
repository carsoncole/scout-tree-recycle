<%= render "admin/shared/page_header",
           title: "Zones",
           description: "Routes grouped by zone with pickup counts." %>

<div class="flex flex-col gap-6">
  <% @zones.each do |zone| %>
    <%= render "pickups/zones/zone", name: zone.name, routes: zone.routes, reservation_counts: @reservation_counts %>
  <% end %>

  <% if @unzoned_routes.any? %>
    <%= render "pickups/zones/zone", name: "No Zone", routes: @unzoned_routes, reservation_counts: @reservation_counts %>
  <% end %>

  <% if @zones.empty? && @unzoned_routes.empty? %>
    <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No zones have been created yet.</p>
  <% end %>
</div>
