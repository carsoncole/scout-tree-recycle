<%= render "admin/shared/page_header",
           title: "Zone: #{@zone.name}",
           description: "Zone information, routes, drivers, and plotted reservations." %>

<% totals = pickup_status_totals(@routes, @status_counts) %>

<%= render "pickups/shared/legend" %>

<div class="mt-6 flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Pickup status across every route in <%= @zone.name %>.</p>
      </div>
      <%= render "pickups/shared/status_counts", totals: totals %>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="<%= admin_th_class %>">Setting</th>
            <th scope="col" class="<%= admin_th_class %>">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>"><span class="font-medium">Name</span></td>
            <td class="<%= admin_td_class %>"><%= @zone.name %></td>
          </tr>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>"><span class="font-medium">Routes</span></td>
            <td class="<%= admin_td_class %>"><%= pluralize(@routes.size, "route") %></td>
          </tr>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="<%= admin_td_class %>"><span class="font-medium">Drivers</span></td>
            <td class="<%= admin_td_class %>"><%= pluralize(@drivers.size, "driver") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone map</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Route areas and plotted reservations in <%= @zone.name %>.</p>
      </div>
    </div>
    <div class="admin-panel-body admin-panel-body--tight">
      <% route_polygons = @routes.flat_map { |route| route_boundary_polygon(route) } %>
      <% markers = pickups_overview_map_markers(@reservations) %>
      <% if route_polygons.any? || markers.any? %>
        <%= render "shared/map",
              polygons: route_polygons,
              markers: markers,
              height_class: "h-80",
              empty_message: "No map data available for #{@zone.name}." %>
        <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark">Blue outlines are route areas. Dots show reservations by status.</p>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No route boundaries or pickup locations with coordinates are available for <%= @zone.name %>.</p>
      <% end %>
      <% missing_coordinates = @coordinate_less_counts.values.sum %>
      <% if missing_coordinates.positive? %>
        <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark"><%= pluralize(missing_coordinates, "reservation") %> in <%= @zone.name %> do not have coordinates and are not shown on the map.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Routes</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Routes assigned to <%= @zone.name %> with pickup counts.</p>
      </div>
    </div>
    <div class="admin-table-wrap">
      <% if @routes.any? %>
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Route</th>
              <th scope="col" class="<%= admin_th_class %>">Pending</th>
              <th scope="col" class="<%= admin_th_class %>">Picked</th>
              <th scope="col" class="<%= admin_th_class %>">Missing</th>
              <th scope="col" class="<%= admin_th_class %>">Total</th>
            </tr>
          </thead>
          <tbody>
            <% @routes.each do |route| %>
              <% route_totals = pickup_status_totals([route], @status_counts) %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= link_to route.name, pickups_route_path(route), class: admin_link_class %></td>
                <td class="<%= admin_td_class %>"><%= route_totals["pending_pickup"] %></td>
                <td class="<%= admin_td_class %>"><%= route_totals["picked_up"] %></td>
                <td class="<%= admin_td_class %>"><%= route_totals["missing"] %></td>
                <td class="<%= admin_td_class %>"><%= route_totals["total"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No routes are assigned to this zone.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Drivers</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Drivers assigned to routes in <%= @zone.name %>.</p>
      </div>
    </div>
    <div class="admin-table-wrap">
      <% if @drivers.any? %>
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="<%= admin_th_class %>">Driver</th>
              <th scope="col" class="<%= admin_th_class %>">Phone</th>
              <th scope="col" class="<%= admin_th_class %>">Routes</th>
              <th scope="col" class="<%= admin_th_class %>">Total pickups</th>
            </tr>
          </thead>
          <tbody>
            <% @drivers.each do |driver| %>
              <% driver_routes = @routes_by_driver[driver] %>
              <% driver_totals = pickup_status_totals(driver_routes, @status_counts) %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="<%= admin_td_class %>"><%= driver.name %></td>
                <td class="<%= admin_td_class %>"><%= driver.national_mobile %></td>
                <td class="<%= admin_td_class %>">
                  <div class="admin-table-actions">
                    <% driver_routes.each do |route| %>
                      <%= link_to route.name, pickups_route_path(route), class: admin_badge_class("info") %>
                    <% end %>
                  </div>
                </td>
                <td class="<%= admin_td_class %>"><%= driver_totals["total"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No drivers are assigned to routes in this zone.</p>
      <% end %>
    </div>
  </section>
</div>
