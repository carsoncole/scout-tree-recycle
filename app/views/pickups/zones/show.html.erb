<%= render "admin/shared/page_header",
           title: "Zone: #{@zone.name}",
           description: "Zone information, routes, drivers, and plotted reservations." %>

<% totals = pickup_status_totals(@routes, @status_counts) %>

<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.88rem] text-ink-soft dark:text-ink-soft-dark">
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-green-600"></span>Pending</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-gray-500"></span>Picked</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-red-600"></span>Missing</span>
  <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-blue-500/70"></span>Route area</span>
</div>

<div class="mt-6 flex flex-col gap-6">
  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone information</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Pickup status across every route in <%= @zone.name %>.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-[0.8rem]">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-stone px-2.5 py-1 font-medium text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">
          <span class="size-2 rounded-full bg-green-600"></span>Pending <%= totals["pending_pickup"] %>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-stone px-2.5 py-1 font-medium text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">
          <span class="size-2 rounded-full bg-gray-500"></span>Picked <%= totals["picked_up"] %>
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-stone px-2.5 py-1 font-medium text-ink-soft dark:bg-stone-dark dark:text-ink-soft-dark">
          <span class="size-2 rounded-full bg-red-600"></span>Missing <%= totals["missing"] %>
        </span>
        <span class="inline-flex items-center rounded-full bg-stone px-2.5 py-1 font-medium text-ink dark:bg-stone-dark dark:text-ink-dark">Total <%= totals["total"] %></span>
      </div>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table text-ink dark:text-ink-dark">
        <thead>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Setting</th>
            <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Value</th>
          </tr>
        </thead>
        <tbody>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><span class="font-medium">Name</span></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= @zone.name %></td>
          </tr>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><span class="font-medium">Routes</span></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= pluralize(@routes.size, "route") %></td>
          </tr>
          <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><span class="font-medium">Drivers</span></td>
            <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= pluralize(@drivers.size, "driver") %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Zone map</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Route areas and plotted reservations in <%= @zone.name %>.</p>
      </div>
    </div>
    <div class="admin-panel-body admin-panel-body--tight">
      <% route_polygons = @routes.flat_map { |route| route_boundary_polygon(route) } %>
      <% markers = pickups_overview_map_markers(@reservations) %>
      <% if route_polygons.any? || markers.any? %>
        <%= render "shared/map",
              polygons: route_polygons,
              markers: markers,
              height_class: "h-80",
              empty_message: "No map data available for #{@zone.name}." %>
        <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark">Blue outlines are route areas. Dots show reservations by status.</p>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No route boundaries or pickup locations with coordinates are available for <%= @zone.name %>.</p>
      <% end %>
      <% missing_coordinates = @coordinate_less_counts.values.sum %>
      <% if missing_coordinates.positive? %>
        <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark"><%= pluralize(missing_coordinates, "reservation") %> in <%= @zone.name %> do not have coordinates and are not shown on the map.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Routes</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Routes assigned to <%= @zone.name %> with pickup counts.</p>
      </div>
    </div>
    <div class="admin-table-wrap">
      <% if @routes.any? %>
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Route</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Pending</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Picked</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Missing</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Total</th>
            </tr>
          </thead>
          <tbody>
            <% @routes.each do |route| %>
              <% route_totals = pickup_status_totals([route], @status_counts) %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= link_to route.name, pickups_route_path(route), class: "admin-link text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route_totals["pending_pickup"] %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route_totals["picked_up"] %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route_totals["missing"] %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= route_totals["total"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No routes are assigned to this zone.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-panel border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
    <div class="admin-panel-header border-line dark:border-line-dark">
      <div>
        <h2 class="admin-panel-title text-ink dark:text-ink-dark">Drivers</h2>
        <p class="admin-panel-description text-ink-soft dark:text-ink-soft-dark">Drivers assigned to routes in <%= @zone.name %>.</p>
      </div>
    </div>
    <div class="admin-table-wrap">
      <% if @drivers.any? %>
        <table class="admin-table text-ink dark:text-ink-dark">
          <thead>
            <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Driver</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Phone</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Routes</th>
              <th scope="col" class="border-b border-line bg-stone text-ink-soft dark:border-line-dark dark:bg-stone-dark dark:text-ink-soft-dark">Total pickups</th>
            </tr>
          </thead>
          <tbody>
            <% @drivers.each do |driver| %>
              <% driver_routes = @routes_by_driver[driver] %>
              <% driver_totals = pickup_status_totals(driver_routes, @status_counts) %>
              <tr class="hover:bg-table-hover dark:hover:bg-table-hover-dark">
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= driver.name %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= Phonelib.parse(driver.mobile).national if driver.mobile.present? %></td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark">
                  <div class="admin-table-actions">
                    <% driver_routes.each do |route| %>
                      <%= link_to route.name, pickups_route_path(route), class: "admin-badge admin-badge--info bg-info-bg text-info dark:bg-info-bg-dark dark:text-info-dark" %>
                    <% end %>
                  </div>
                </td>
                <td class="border-b border-line text-ink dark:border-line-dark dark:text-ink-dark"><%= driver_totals["total"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="px-6 py-8 text-center text-[0.9rem] text-ink-soft dark:text-ink-soft-dark">No drivers are assigned to routes in this zone.</p>
      <% end %>
    </div>
  </section>
</div>
