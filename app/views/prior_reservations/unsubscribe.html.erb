<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center">
      <h2 class="mt-6 text-3xl font-extrabold text-gray-900 dark:text-white">
        Unsubscribe from Tree Recycling Updates
      </h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        We're sorry to see you go. By proceeding, we will remove your email from any further messages regarding our tree recycling event.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="bg-white dark:bg-gray-800 py-8 px-4 shadow sm:rounded-lg sm:px-10">
        <div class="space-y-6">
          <div class="text-center">
            <p class="text-sm text-gray-500 dark:text-gray-400">
              Are you sure you want to unsubscribe?
            </p>
          </div>

          <%= button_to "Yes, Unsubscribe Me", prior_reservation_path(@prior_reservation),
              method: :delete,
              class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500",
              data: {
                turbo_method: :delete
              } %>
        </div>
      </div>
    </div>
  </div>
</div>
