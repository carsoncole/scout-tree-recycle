<% contact_name = setting.contact_name.presence %>
<% contact_email = setting.contact_email.presence %>
<% contact_phone = setting.contact_phone.presence %>
<% contact_sms = setting.contact_sms.presence %>

<div class="site-home-form border border-line bg-surface dark:border-line-dark dark:bg-surface-dark" id="pickup-notice">
  <p class="m-0">
    <span class="inline-flex items-center rounded-full bg-sage-soft px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-sage-deep dark:bg-sage-soft-dark dark:text-sage-deep-dark">Pickups underway</span>
  </p>
  <h2 class="site-subtitle mt-3 mb-2 text-ink dark:text-ink-dark">We're no longer taking reservations</h2>
  <p class="m-0 max-w-[34rem] text-ink-soft dark:text-ink-soft-dark">
    We're currently picking up trees. Contact us if you have any issues with your reservation or tree pickup.
  </p>

  <% if contact_name || contact_email || contact_phone || contact_sms %>
    <div class="mt-5 border-t border-line pt-5 dark:border-line-dark">
      <%= render "public/contact_details" %>
    </div>
  <% end %>
</div>
