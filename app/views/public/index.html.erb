<% service_area = [ setting.default_city, setting.default_state ].compact_blank.join(", ") %>
<% home_title = if setting.is_pickup_notice_enabled?
     "Pickups Underway"
   elsif setting.is_reservations_open?
     "Make a Reservation"
   else
     "Reservations Closed"
   end %>
<% content_for :title, "#{home_title} | #{default_page_name}" %>
<% if setting.is_pickup_notice_enabled? %>
  <% content_for :description, "We're no longer taking reservations and are currently picking up trees. Contact us if you have any issues with your reservation or tree pickup." %>
<% else %>
  <% content_for :description, "Schedule a Christmas tree pickup for #{pickup_date}. Sign up by #{sign_up_deadline}." %>
<% end %>

<section class="site-hero site-home-hero" id="reserve">
  <div class="site-container site-container--wide">
    <div class="site-home-layout <%= "site-home-layout--closed" unless setting.accepting_reservations? %>">
      <div class="site-home-intro">
        <div class="site-home-art rounded-3xl bg-gradient-to-br from-sage-soft via-sage-soft/60 to-transparent dark:from-sage-soft-dark dark:via-sage-soft-dark/60">
          <%= image_tag setting.home_page_image_name, alt: "Recycle Your Tree", class: "site-home-image" %>
        </div>

        <div class="site-home-heading">
          <div>
            <p class="site-eyebrow text-sage-deep dark:text-sage-deep-dark">Holiday tree pickup</p>
            <h1 class="site-title text-ink dark:text-ink-dark"><%= setting.is_pickup_notice_enabled? ? "Pickups are underway" : "Make a Reservation" %></h1>
          </div>
        </div>
        <p class="site-lede text-ink-soft dark:text-ink-soft-dark">
          <% if setting.is_pickup_notice_enabled? %>
            Our volunteers are collecting trees on <strong class="font-semibold text-ink dark:text-ink-dark"><%= pickup_date %></strong>.
          <% else %>
            Schedule your tree pickup for <strong class="font-semibold text-ink dark:text-ink-dark"><%= pickup_date %></strong> and we'll take it off your hands.
          <% end %>
        </p>
        <% if service_area.present? %>
          <p class="site-home-service-area text-ink-soft dark:text-ink-soft-dark">Pickup in <%= service_area %>.</p>
        <% end %>

        <%= render "shared/pickup_panel" do %>
          <%= link_to "Learn more about the pickup", about_path,
                      class: "text-sm font-medium text-surface underline decoration-sage-soft/40 underline-offset-4 hover:decoration-sage-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface" %>
        <% end %>
      </div>

      <% if setting.accepting_reservations? %>
        <div class="site-home-form border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
          <h2 class="site-home-form-title text-ink dark:text-ink-dark">Reserve your pickup</h2>
          <p class="mt-0 mb-4 text-sm text-ink-soft dark:text-ink-soft-dark">It only takes a minute. We'll confirm the details by email.</p>
          <%= render "reservations/form" %>
        </div>
      <% elsif setting.is_pickup_notice_enabled? %>
        <%= render "public/pickup_notice" %>
      <% else %>
        <div class="site-home-form border border-line bg-surface dark:border-line-dark dark:bg-surface-dark">
          <p class="m-0">
            <span class="inline-flex items-center rounded-full bg-warning-badge px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-warning-badge-text dark:bg-warning-badge-dark dark:text-warning-badge-text-dark">Reservations closed</span>
          </p>
          <h2 class="site-subtitle mt-3 mb-2 text-ink dark:text-ink-dark">We're not taking reservations right now</h2>
          <p class="m-0 max-w-[34rem] text-ink-soft dark:text-ink-soft-dark"><%= setting.reservations_closed_message_text %></p>
          <p class="mt-5 border-t border-line pt-5 text-sm text-ink-soft dark:border-line-dark dark:text-ink-soft-dark">
            When reservations open, this is the page to reserve your tree.
            <%= link_to "Read about how the pickup works", about_path,
                        class: "font-medium text-sage-deep hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink dark:text-sage-deep-dark dark:hover:text-ink-dark dark:focus-visible:outline-ink-dark" %>
            in the meantime.
          </p>
        </div>
      <% end %>
    </div>

    <section class="site-section border-line dark:border-line-dark" aria-labelledby="pickup-steps">
      <h2 id="pickup-steps" class="site-subtitle text-ink dark:text-ink-dark">How pickup works</h2>
      <ol class="site-steps site-steps--three">
        <li class="site-step text-ink-soft border-line dark:text-ink-soft-dark dark:border-line-dark">
          <span aria-hidden="true" class="site-step-chip bg-sage-soft text-sage-deep dark:bg-sage-soft-dark dark:text-sage-deep-dark"></span>
          Reserve a pickup time for your tree.
        </li>
        <li class="site-step text-ink-soft border-line dark:text-ink-soft-dark dark:border-line-dark">
          <span aria-hidden="true" class="site-step-chip bg-sage-soft text-sage-deep dark:bg-sage-soft-dark dark:text-sage-deep-dark"></span>
          We confirm the details by email.
        </li>
        <li class="site-step text-ink-soft border-line dark:text-ink-soft-dark dark:border-line-dark">
          <span aria-hidden="true" class="site-step-chip bg-sage-soft text-sage-deep dark:bg-sage-soft-dark dark:text-sage-deep-dark"></span>
          Leave your tree where we can find it by <%= pickup_start_time %> on <%= pickup_day %>.
        </li>
      </ol>
    </section>
  </div>
</section>
