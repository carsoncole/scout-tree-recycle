<% content_for :title, "Make a Reservation | #{setting&.home_page_header || "Tree Recycle"}" %>
<% content_for :description, "Schedule a Christmas tree pickup for #{setting.event_pickup_start.strftime("%B %-d, %Y")}." %>

<section class="site-hero" id="reserve">
  <div class="site-container site-container--narrow">
    <%= image_tag "tree.png", alt: "Recycle Your Tree", class: "site-hero-image" %>

    <%= render "shared/page_header",
               eyebrow: "Holiday tree pickup",
               title: "Make a Reservation",
               description: "Schedule your tree pickup for #{setting.event_pickup_start.strftime("%B %-d, %Y")}." %>

    <% if setting.is_reservations_open %>
      <div class="site-form-panel">
        <%= render "reservations/form" %>
      </div>

      <section class="site-section" aria-labelledby="pickup-steps">
        <h2 id="pickup-steps" class="site-subtitle">How pickup works</h2>
        <ol class="site-steps site-steps--three">
          <li class="site-step">Reserve a pickup time for your tree.</li>
          <li class="site-step">We confirm the details by email.</li>
          <li class="site-step">Leave your tree where we can find it.</li>
        </ol>
      </section>
    <% else %>
      <div class="site-empty">
        <h2 class="site-subtitle">Reservations are closed</h2>
        <p><%= setting.reservations_closed_message %></p>
      </div>
    <% end %>
  </div>
</section>
