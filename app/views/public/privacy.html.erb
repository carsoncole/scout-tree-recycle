<% page_name = setting&.organization_name.presence || setting&.home_page_header.presence || "Tree Recycle" %>
<% content_for :title, "Privacy Policy | #{setting&.home_page_header || page_name}" %>
<% content_for :description, "How #{page_name} handles your information." %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= link_to root_path, class: "site-back-link" do %>
      <span aria-hidden="true">←</span> Back to Home
    <% end %>

    <%= render "shared/page_header",
               eyebrow: "Your information",
               title: "Privacy Policy" %>

    <div class="site-prose">
      <h2>Our Commitment to Privacy</h2>
      <p>
        We are committed to protecting your privacy and handling your data with
        transparency and care. Here’s how we handle your information:
      </p>

      <h3>Data Usage</h3>
      <p>
        Your personal data will only be used for the purposes of our tree
        recycling fundraiser. This includes processing your reservation and
        coordinating the pickup of your tree.
      </p>

      <h3>Email Notifications</h3>
      <p>
        We may send you email notifications about subsequent tree recycling
        events. These emails will help you stay informed about future
        opportunities to participate in our fundraiser.
      </p>

      <h3>Your Control</h3>
      <p>
        You can unsubscribe from our marketing emails at any time. If you choose
        to unsubscribe, we will completely remove your data from our system.
        Each marketing email includes an unsubscribe link for your convenience.
      </p>
    </div>
  </div>
</section>
