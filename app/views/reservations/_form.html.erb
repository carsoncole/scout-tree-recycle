<%= form_with model: @reservation, class: "site-form" do |f| %>
  <%= render "shared/form_errors", object: @reservation %>

  <div class="site-field">
    <%= f.label :name, class: "site-label" do %>
      Name <span class="site-required">*</span>
    <% end %>
    <%= f.text_field :name,
                     required: true,
                     autocomplete: "name",
                     class: "site-input" %>
  </div>

  <div class="site-field-row site-field-row--street">
    <div class="site-field">
      <%= f.label :street, class: "site-label" do %>
        Street address <span class="site-required">*</span>
      <% end %>
      <%= f.text_field :street,
                       required: true,
                       autocomplete: "street-address",
                       class: "site-input",
                       placeholder: "Street and number" %>
    </div>

    <div class="site-field">
      <%= f.label :city, "City", class: "site-label" %>
      <%= f.text_field :city,
                       value: @reservation.city,
                       disabled: true,
                       autocomplete: "address-level2",
                       class: "site-input" %>
    </div>
  </div>

  <div class="site-field-row site-field-row--two">
    <div class="site-field">
      <%= f.label :email, class: "site-label" do %>
        Email <span class="site-required">*</span>
      <% end %>
      <%= f.email_field :email,
                        required: true,
                        autocomplete: "email",
                        class: "site-input" %>
    </div>

    <div class="site-field">
      <%= f.label :mobile, "Mobile (Recommended)", class: "site-label" %>
      <%= f.telephone_field :mobile,
                            autocomplete: "tel",
                            class: "site-input",
                            aria: { describedby: "mobile-hint" } %>
      <p id="mobile-hint" class="site-hint">Optional, but helpful if we can’t find your tree.</p>
    </div>
  </div>

  <div class="site-field">
    <%= f.label :pickup_notes, "Notes", class: "site-label" %>
    <%= f.text_area :pickup_notes,
                    rows: 3,
                    placeholder: "If your tree won’t be out front, where should we look?",
                    class: "site-textarea" %>
  </div>

  <%= f.submit @reservation.persisted? ? "Update Reservation" : "Create Reservation",
               class: "site-button site-button--full" %>
<% end %>

<% if @reservation.persisted? && (@reservation.routing? || @reservation.pending_pickup?) %>
  <div class="site-section">
    <%= button_to "Cancel Reservation",
                  reservation_path(@reservation),
                  method: :delete,
                  data: {
                    turbo_confirm: "Are you sure you want to cancel your reservation? This action cannot be undone.",
                    turbo_method: :delete
                  },
                  class: "site-button site-button--quiet site-button--full" %>
  </div>
<% end %>
