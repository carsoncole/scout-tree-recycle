<div class="w-full bg-gray-50 dark:bg-gray-900">
  <div class="min-h-screen">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-yellow-100 dark:bg-yellow-900 mb-6">
          <svg class="w-8 h-8 text-yellow-600 dark:text-yellow-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          Address Verification Required
        </h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">
          We need to verify your address before proceeding
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg border-2 border-yellow-500">
        <div class="px-6 py-8 sm:p-8">
          <div class="space-y-6">
            <div>
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Please Verify Your Address</h2>

              <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Current Address</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= @reservation.street %><br>
                    <%= @reservation.city %>
                  </dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Suggested Address</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= @suggested_address.titleize %><br />
                    <%= @reservation.city %>
                  </dd>
                </div>
              </dl>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Please Choose</h3>
              <div class="mt-8 flex justify-center space-x-4">
                <%= button_to "Use Original Address", reservation_address_confirmation_path(@reservation), method: :patch, class: "inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500" %>
                <%= button_to "Use Suggested Address", reservation_address_confirmation_path(@reservation, street: @suggested_address), method: :patch, class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-yellow-600 hover:bg-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
