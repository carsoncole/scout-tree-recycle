<div class="w-full bg-gray-50 dark:bg-gray-900">
  <div class="min-h-screen">
    <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 dark:bg-green-900 mb-6">
          <svg class="w-8 h-8 text-green-600 dark:text-green-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white sm:text-5xl sm:tracking-tight lg:text-6xl">
          Reservation Confirmed
        </h1>
        <p class="mt-4 text-xl text-gray-600 dark:text-gray-400">
          Thank you for your reservation, <%= @reservation.name %>!
        </p>
      </div>

      <div class="bg-white dark:bg-gray-800 shadow-xl sm:rounded-lg border-2 border-green-500">
        <div class="px-6 py-8 sm:p-8">
          <div class="space-y-6">
            <div>
              <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Reservation Details</h2>

              <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Name</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @reservation.name %></dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Address</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= @reservation.street.titleize %><br>
                    <%= @reservation.city %>
                  </dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Pickup Date</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                    <%= Setting.instance.event_pickup.strftime("%B %-d, %Y") %>
                  </dd>
                </div>

                <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                  <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Email</dt>
                  <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @reservation.email %></dd>
                </div>

                <% if @reservation.notes.present? %>
                  <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Notes</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2"><%= @reservation.notes %></dd>
                  </div>
                <% end %>

                <% if @reservation.phone.present? %>
                  <div class="bg-gray-50 dark:bg-gray-700 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 rounded-lg">
                    <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Phone</dt>
                    <dd class="mt-1 text-sm text-gray-900 dark:text-white sm:mt-0 sm:col-span-2">
                      <%= Phonelib.parse(@reservation.phone).national %>
                      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">We will only message this number if we cannot find your tree</p>
                    </dd>
                  </div>
                <% end %>
              </dl>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200 dark:border-gray-700">
              <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-4">Next Steps</h3>
              <ul class="space-y-4 text-gray-600 dark:text-gray-400">
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>You will receive a confirmation email shortly</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>Please have your tree ready by 8am on pickup day</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span>Remove all decorations and tinsel from your tree</span>
                </li>
              </ul>
            </div>

            <div class="mt-8 flex justify-center">
              <%= link_to "Edit Reservation", edit_reservation_path(@reservation), class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
