<% content_for :title, "Edit Reservation | #{default_page_name}" %>
<% content_for :description, "Update your tree pickup details." %>

<section class="site-page">
  <div class="site-container site-container--narrow">
    <%= link_to reservation_confirmation_path(@reservation.public_token), class: "site-back-link text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark" do %>
      <span aria-hidden="true">←</span> Back to your reservation
    <% end %>

    <%= render "shared/page_header",
               eyebrow: "Your reservation",
               title: "Edit Reservation",
               description: "Update your tree pickup details for #{setting.event_pickup_start.strftime("%B %-d, %Y")}." %>

    <div class="site-form-panel">
      <%= render "form" %>
    </div>
  </div>
</section>
