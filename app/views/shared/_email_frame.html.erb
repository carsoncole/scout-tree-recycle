<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#f6f3ea" style="width: 100%; border-collapse: collapse; background-color: #f6f3ea;">
  <tr>
    <td align="center" bgcolor="#f6f3ea" style="padding: 32px 16px 40px 16px; background-color: #f6f3ea;">
      <table role="presentation" align="center" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#fefdfa" style="width: 100%; max-width: 600px; border-collapse: collapse; background-color: #fefdfa; border: 1px solid #e3dfd2;">
        <tr>
          <td bgcolor="#fefdfa" style="padding: 24px 28px; border-bottom: 1px solid #e3dfd2; background-color: #fefdfa;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse;">
              <tr>
                <% if logo_src.present? %>
                  <% width = logo_width.to_i.positive? ? logo_width.to_i : ReservationEmailTemplate::LOGO_WIDTH %>
                  <td style="vertical-align: middle; padding: 0 14px 0 0; border: 0;">
                    <img src="<%= logo_src %>" alt="<%= logo_alt %>" width="<%= width %>" style="display: block; width: <%= width %>px; max-width: 100%; height: auto; border: 0;">
                  </td>
                <% end %>
                <td style="vertical-align: middle; border: 0; font-family: Arial, Helvetica, sans-serif; font-size: 18px; font-weight: 600; line-height: 1.3; color: #262a20;">
                  <%= default_page_name %>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td bgcolor="#fefdfa" style="padding: 8px 28px 12px 28px; background-color: #fefdfa; word-break: break-word; overflow-wrap: anywhere;">
            <%= raw body_html %>
          </td>
        </tr>

        <tr>
          <td bgcolor="#fefdfa" style="padding: 4px 28px 28px 28px; background-color: #fefdfa;">
            <%= render "shared/mailer_footer" %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
