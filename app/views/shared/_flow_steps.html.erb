<%# locals: (current: 3, completed: false) %>
<%# Reservation flow progress: Reserve -> Donate -> Confirmed. Pass completed: true
   to render every step as finished (confirmation page). %>
<% steps = { "Reserve" => 1, "Donate" => 2, "Confirmed" => 3 } %>
<ol class="site-flow" aria-label="Reservation progress">
  <% steps.each_with_index do |(label, number), index| %>
    <% if index > 0 %>
      <li aria-hidden="true" class="flex flex-none items-center">
        <span class="w-4 border-t border-line dark:border-line-dark"></span>
      </li>
    <% end %>
    <% done = completed || number < current %>
    <% current_step = !completed && number == current %>
    <%= tag.li(class: "site-flow-step", aria: { current: (current_step ? "step" : nil) }) do %>
      <% if done %>
        <span class="site-flow-chip bg-sage-soft text-sage-deep dark:bg-sage-soft-dark dark:text-sage-deep-dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m8.5 12.3 2.3 2.3 4.8-5"></path>
          </svg>
        </span>
        <span class="text-ink-soft dark:text-ink-soft-dark"><%= label %><span class="sr-only"> (completed)</span></span>
      <% elsif current_step %>
        <span class="site-flow-chip bg-sage text-surface dark:bg-sage-dark dark:text-page-dark"><%= number %></span>
        <span class="text-ink dark:text-ink-dark"><%= label %></span>
      <% else %>
        <span class="site-flow-chip bg-stone text-muted dark:bg-stone-dark dark:text-muted-dark"><%= number %></span>
        <span class="text-muted dark:text-muted-dark"><%= label %></span>
      <% end %>
    <% end %>
  <% end %>
</ol>
