<footer class="site-footer border-t border-fir bg-fir dark:border-fir-dark dark:bg-fir-dark">
  <div class="site-footer-inner text-sage-soft/85">
    <p>
      <%= render "shared/scouting_america_logo", logo_class: "site-footer-logo", picture_class: "site-footer-logo-picture", alt: "Scouting America", reversed: true %>
      <% if setting&.organization_url.present? %>
        <%= link_to(setting.organization_name.presence || "Tree Recycle", setting.organization_url, target: "_blank", rel: "noopener", class: "font-semibold text-surface hover:text-sage-soft") %>
      <% else %>
        <span class="font-semibold text-surface"><%= setting&.organization_name.presence || "Tree Recycle" %></span>
      <% end %>
    </p>

    <nav class="site-footer-links" aria-label="Footer">
      <%= link_to "Thank You", thanks_path, class: "hover:text-sage-soft" %>
      <%= link_to "Privacy Policy", privacy_path, class: "hover:text-sage-soft" %>
      <%= link_to "About this app", credits_path, class: "hover:text-sage-soft" %>
    </nav>
  </div>
</footer>
