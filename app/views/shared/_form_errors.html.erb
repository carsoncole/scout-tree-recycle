<% if object.errors.any? %>
  <div class="site-form-errors border border-line bg-stone dark:border-line-dark dark:bg-stone-dark" role="alert">
    <h2 class="text-ink dark:text-ink-dark">Please check the details below.</h2>
    <ul class="text-ink-soft dark:text-ink-soft-dark">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
