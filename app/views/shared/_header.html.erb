<header class="site-header">
  <div class="site-header-inner">
    <%= link_to(setting&.home_page_header.presence || "Tree Recycle", root_path, class: "site-wordmark") %>

    <nav class="site-nav" aria-label="Primary">
      <%= link_to "About", about_path, class: "site-nav-link" %>
      <% if setting&.is_reservations_open %>
        <%= link_to "Reserve a pickup", root_path(anchor: "reserve"), class: "site-button site-button--small" %>
      <% end %>
    </nav>
  </div>
</header>
