<div class="flex gap-2" style="font-family:'SF UI Display Medium',system,-apple-system,-webkit-system-font,'SFNSText','Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif !important; box-sizing: border-box; line-height: 1.5; font-weight:400; font-size: 13px; font-weight: normal; margin: 0 0 25px; padding: 0;">
  <% if Setting.instance.organization_url.present? %>
    <%= link_to @email_footer, Setting.instance.organization_url, target: "_blank", style: "text-decoration-line: none;" %>
  <% else %>
    <%= @email_footer %>
  <% end %>
  <% if @prior_reservation.present? %>
    <span class="text-gray-500">|</span>
    <%= link_to "Unsubscribe", unsubscribe_prior_reservation_url(@prior_reservation), style: "text-decoration-line: none;" %>
  <% end %>
</div>
