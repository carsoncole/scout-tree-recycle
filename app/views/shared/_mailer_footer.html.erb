<div style="font-family: Arial, Helvetica, sans-serif; box-sizing: border-box; line-height: 1.5; font-size: 13px; font-weight: normal; margin: 0; padding: 0; color: #7e8273;">
  <% if Setting.instance.organization_url.present? %>
    <%= link_to @email_footer, Setting.instance.organization_url, target: "_blank", style: "color: #7e8273; text-decoration: none;" %>
  <% else %>
    <%= @email_footer %>
  <% end %>
</div>
