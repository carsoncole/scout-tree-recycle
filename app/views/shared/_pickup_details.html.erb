<%# locals: (reservation:, update_url:, activity_logs:, error: nil, notice: nil) %>
<%# Shared pickup details used by the driver route dialog and the admin map
   dialog. Callers provide the URL that saves a new pickup status. %>
<% color = pickup_status_color(reservation.status) %>
<div id="<%= dom_id(reservation, :panel) %>"
     class="flex flex-col gap-5"
     data-controller="pickup-details-panel"
     data-pickup-details-panel-reservation-id-value="<%= reservation.id %>"
     data-pickup-details-panel-status-value="<%= reservation.status %>"
     data-pickup-details-panel-color-value="<%= color %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="pickup-current-status inline-flex items-center gap-2.5 rounded-xl border border-line bg-stone px-3 py-2 dark:border-line-dark dark:bg-stone-dark">
      <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full" style="background-color: <%= color %>">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-4 <%= pickup_status_check_class(reservation.status) %>" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
      </span>
      <div class="leading-tight">
        <p class="m-0 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-ink-soft dark:text-ink-soft-dark">Current status</p>
        <p class="m-0 text-[1rem] font-bold text-ink dark:text-ink-dark"><%= pickups_status_label(reservation.status) %></p>
      </div>
    </div>
    <% if notice.present? %>
      <span class="text-[0.85rem] font-medium text-positive dark:text-positive-dark" role="status"><%= notice %></span>
    <% end %>
    <% if error.present? %>
      <span class="text-[0.85rem] font-medium text-danger dark:text-danger-dark" role="alert"><%= error %></span>
    <% end %>
  </div>

  <div class="flex flex-col gap-4">
    <div>
      <p class="admin-label text-ink dark:text-ink-dark">Address</p>
      <p class="admin-detail-value">
        <%= link_to maps_directions_url(reservation),
                    target: "_blank",
                    rel: "noopener",
                    aria: { label: "Get directions to #{reservation.street}" },
                    class: "inline-flex items-start gap-1.5 text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" do %><%= directions_icon %><span><%= reservation.street %></span><% end %>
      </p>
    </div>

    <% if reservation.name.present? %>
      <div>
        <p class="admin-label text-ink dark:text-ink-dark">Resident</p>
        <p class="admin-detail-value text-ink dark:text-ink-dark"><%= reservation.name %></p>
      </div>
    <% end %>

    <% if reservation.mobile.present? %>
      <div>
        <p class="admin-label text-ink dark:text-ink-dark">Phone</p>
        <p class="admin-detail-value">
          <%= link_to "tel:#{reservation.mobile.gsub(/[^\d+]/, "")}",
                       class: "inline-flex items-center gap-1.5 text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" do %><%= phone_icon %><span><%= reservation.mobile %></span><% end %>
        </p>
      </div>
    <% end %>

    <div>
      <p class="admin-label text-ink dark:text-ink-dark">Notes</p>
      <% if reservation.pickup_notes.present? %>
        <p class="admin-detail-value whitespace-pre-wrap text-ink dark:text-ink-dark"><%= reservation.pickup_notes %></p>
      <% else %>
        <p class="admin-table-note text-ink-soft dark:text-ink-soft-dark">No special instructions.</p>
      <% end %>
    </div>
  </div>

  <%= form_with model: reservation,
                url: update_url,
                method: :patch do %>
    <div class="grid gap-2 sm:grid-cols-3">
      <% pickup_status_buttons(reservation).each do |button| %>
        <%= button_tag type: :submit,
                       name: "reservation[status]",
                       value: button[:value],
                       disabled: button[:current],
                       aria: { current: button[:current] ? "true" : nil },
                       data: button[:confirm] ? { turbo_confirm: button[:confirm] } : {},
                       class: [ "min-h-12 text-[0.95rem]", button[:current] ? "cursor-default" : nil, admin_button_class(variant: button[:variant], full: true) ] do %>
          <% if button[:current] %>
            <span class="inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-current" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
            </span>
          <% end %>
          <%= button[:label] %>
          <% if button[:current] %>
            <span class="rounded-full border border-current px-1.5 py-0.5 text-[0.62rem] font-bold uppercase tracking-[0.08em]">Current</span>
          <% end %>
          <span class="sr-only"><%= " (current status)" if button[:current] %></span>
        <% end %>
      <% end %>
    </div>
    <p class="admin-table-note mt-3 text-ink-soft dark:text-ink-soft-dark">Marking a pickup missing notifies the resident with a missing-tree message.</p>
  <% end %>

  <details class="border-t border-line pt-3 dark:border-line-dark">
    <summary class="cursor-pointer select-none text-[0.9rem] font-semibold text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark">Activity</summary>
    <% if activity_logs.any? %>
      <ul class="m-0 mt-3 flex list-none flex-col gap-2.5 p-0">
        <% activity_logs.each do |log| %>
          <li>
            <p class="m-0 text-[0.85rem] leading-[1.45] text-ink dark:text-ink-dark"><%= log.message %></p>
            <p class="m-0 mt-0.5 text-[0.78rem] text-ink-soft dark:text-ink-soft-dark"><%= time_ago_in_words(log.created_at) %> ago</p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="m-0 mt-3 text-[0.85rem] text-ink-soft dark:text-ink-soft-dark">No activity recorded for this pickup yet.</p>
    <% end %>
  </details>
</div>
