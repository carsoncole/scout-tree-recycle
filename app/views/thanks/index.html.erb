<% thank_you_message = setting&.thank_you_message %>
<% content_for :title, "Thank You | #{default_page_name}" %>
<% content_for :description, thank_you_message.presence || "Thanks to the supporters who make #{default_page_name} possible." %>

<section class="site-page">
  <div class="site-container site-container--medium">
    <%= link_to root_path, class: "site-back-link text-ink-soft hover:text-ink dark:text-ink-soft-dark dark:hover:text-ink-dark" do %>
      <span aria-hidden="true">←</span> Back to Home
    <% end %>

    <%= render "shared/page_header",
               eyebrow: "With gratitude",
               title: "Thank You",
               description: thank_you_message %>

    <% if @thanks.any? %>
      <ul class="mt-10 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
        <% @thanks.each do |thank| %>
          <li class="flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-transform duration-150 hover:-translate-y-0.5 dark:border-line-dark dark:bg-surface-dark">
            <% if thank.image.present? %>
              <div class="flex h-40 items-center justify-center border-b border-line bg-stone p-4 dark:border-line-dark dark:bg-stone-dark">
                <%= image_tag image_thank_path(thank, v: thank.updated_at.to_i),
                              alt: "Supporter logo",
                              loading: "lazy",
                              class: "max-h-full max-w-full object-contain" %>
              </div>
            <% end %>
            <% if thank.content.present? || thank.url.present? %>
              <div class="site-prose flex flex-col gap-3 p-5 text-ink-soft dark:text-ink-soft-dark">
                <% if thank.content.present? %>
                  <%= simple_format(thank.content, class: "m-0") %>
                <% end %>
                <% if thank.url.present? %>
                  <%= link_to thank.url_text.presence || thank.url, thank.url,
                              target: "_blank",
                              rel: "noopener",
                              class: "site-link self-center break-all text-center text-sage-deep hover:text-ink dark:text-sage-deep-dark dark:hover:text-ink-dark" %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="site-lede mt-10 text-ink-soft dark:text-ink-soft-dark">Supporters will be listed here soon.</p>
    <% end %>
  </div>
</section>
