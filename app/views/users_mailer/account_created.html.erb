<h1 style="<%= admin_heading_style %>">Your account is ready</h1>

<p style="<%= admin_paragraph_style %>">
  An account has been created for <strong><%= @user.email %></strong> at
  <%= @site_header %><% if @site_url %>, located at
  <a href="<%= @site_url %>" style="<%= admin_link_style %>"><%= @site_url %></a><% end %>. Choose a password to sign in and get started.
</p>

<p align="center" style="font-family: Arial, Helvetica, sans-serif; margin: 24px 0;">
  <a href="<%= @setup_url %>" style="<%= admin_button_style %>">Create my password</a>
</p>

<p style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 1.6; color: #6b7280; margin: 0 0 16px 0; word-break: break-all; overflow-wrap: anywhere;">
  If the button does not work, copy and paste this link into your browser:
  <br />
  <%= link_to @setup_url, @setup_url, style: "#{admin_link_style} word-break: break-all; overflow-wrap: anywhere;" %>
</p>

<p style="<%= admin_muted_style %>">
  This link expires in <%= @expires_in_days %> days. If you weren't expecting
  this email, you can safely ignore it.
</p>
